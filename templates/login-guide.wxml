<template name="loginGuide">
  <view class="guest-guide">
    <text class="guest-title t-h2">{{title}}</text>
    <image class="guest-icon" src="/assets/icons/mic-wave-primary.svg" mode="aspectFit" />
    <text class="guest-desc t-caption">{{description}}</text>
    <view class="btn-primary guest-btn tap-scale" bindtap="onGoLogin">去登录</view>
    <text class="guest-hint t-mini">{{hint}}</text>
  </view>
</template>
