/* ============ 全屏播放详情面板（复刻 Android FullScreenPlayerScreen） ============ */

/* 全屏浮层：上滑入场（对齐 framer-motion y:100% → 0） */
.pp-sheet {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-sheet);
  display: flex;
  flex-direction: column;
  background-color: var(--color-base-100);
  animation: pp-slide-up 0.3s ease-out;
}

@keyframes pp-slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* ── 顶部窄栏（h-14）：expand_more 收起 / close 关闭 ── */
.pp-header {
  height: 112rpx;
  padding: 0 24rpx;
  flex-shrink: 0;
}

.pp-header-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-header-icon {
  width: 56rpx;
  height: 56rpx;
}

.pp-header-close {
  width: 40rpx;
  height: 40rpx;
}

.pp-header-divider {
  height: 2rpx;
  background-color: #f2efe8;
  flex-shrink: 0;
}

/* ── 主体：上部弹性留白 + 下沉控制模块 ── */
.pp-body {
  flex: 1;
  height: 0;
  padding: 0 48rpx;
  align-items: center;
}

/* 拖把（48×6dp） */
.pp-handle {
  width: 96rpx;
  height: 12rpx;
  border-radius: var(--r-full);
  background-color: var(--ink-200);
  margin-bottom: 32rpx;
  margin-top: 24rpx;
  flex-shrink: 0;
}

/* 封面 16:9（640×360rpx；不用 aspect-ratio，兼容低版本基础库） */
.pp-cover-wrap {
  position: relative;
  width: 640rpx;
  max-width: 100%;
  height: 360rpx;
  border-radius: 32rpx;
  overflow: hidden;
  border: 2rpx solid var(--ink-100);
  box-shadow: var(--e2);
  flex-shrink: 0;
}

.pp-cover {
  width: 100%;
  height: 100%;
}

/* 「精听中」角标（对齐 Android：Primary600@92% 底 + 白 GraphicEq 10dp + 白 10sp 粗体） */
.pp-intensive-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: var(--r-full);
  background-color: rgba(31, 122, 92, 0.92);
}

.pp-intensive-badge-icon {
  width: 20rpx;
  height: 20rpx;
}

.pp-intensive-badge-text {
  font-size: 20rpx;
  font-weight: 600;
  color: #ffffff;
  line-height: 1.2;
}

.pp-title {
  margin-top: 40rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink-900);
  text-align: center;
  max-width: 100%;
}

.pp-podcast {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--primary-600);
  max-width: 100%;
}

/* ── 功能行（进度条正上方）：播放列表 | 定时关闭 ── */
.pp-actions {
  align-self: stretch;
  margin-top: 40rpx;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.pp-action {
  gap: 8rpx;
  padding: 8rpx 0;
}

.pp-action-icon {
  width: 40rpx;
  height: 40rpx;
}

.pp-action-text {
  font-size: 24rpx;
  color: var(--ink-600);
}

/* 定时激活：图标文字转主题色（对齐 Android sleepTimer != null 分支） */
.pp-action.active .pp-action-text {
  color: var(--primary-600);
  font-weight: 600;
}

/* ── 进度条 ── */
.pp-slider {
  align-self: stretch;
  margin: 0;
  flex-shrink: 0;
}

.pp-time-row {
  align-self: stretch;
  margin-top: 4rpx;
  flex-shrink: 0;
}

.pp-time {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--ink-400);
  font-family: Georgia, "Courier New", monospace;
  font-variant-numeric: tabular-nums;
}

/* ── 控制排：倍速 / 上一首 / 播放大钮 / 下一首 / 循环 ── */
.pp-controls {
  align-self: stretch;
  justify-content: space-between;
  margin-top: 40rpx;
  margin-bottom: 24rpx;
  flex-shrink: 0;
}

/* 倍速/循环圆 pill：base-200 底，激活 primary-50（对齐 Android 48dp 圆 chip） */
.pp-pill {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background-color: var(--color-base-200);
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-pill.active {
  background-color: var(--primary-50);
}

.pp-pill-text {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-600);
}

.pp-pill.active .pp-pill-text {
  color: var(--primary-600);
}

.pp-pill-icon {
  width: 40rpx;
  height: 40rpx;
}

.pp-ctl {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pp-ctl-icon {
  width: 72rpx;
  height: 72rpx;
}

/* 播放大钮：primary-600 底 + 白色 FILL 图标（64dp，缓冲中转圈） */
.pp-play {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background-color: var(--primary-600);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(31, 122, 92, 0.3);
}

.pp-play-icon {
  width: 64rpx;
  height: 64rpx;
}

@keyframes pp-spin {
  to {
    transform: rotate(360deg);
  }
}

.pp-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: pp-spin 0.8s linear infinite;
}

/* ── 精听模式入口：页面最底部橙色胶囊（对齐 Android Accent500） ── */
.pp-safe-bottom {
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.pp-intensive-btn {
  gap: 12rpx;
  padding: 24rpx 44rpx;
  border-radius: var(--r-full);
  background-color: var(--accent-500);
  box-shadow: 0 8rpx 24rpx rgba(217, 138, 23, 0.35);
}

.pp-intensive-btn-icon {
  width: 36rpx;
  height: 36rpx;
}

.pp-intensive-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 2rpx;
}

/* ============ 底部弹层（定时 / 播放列表共用骨架） ============ */

.pp-sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: calc(var(--z-sheet) + 1);
  background-color: rgba(21, 19, 16, 0.4);
}

.pp-bottom-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  animation: pp-slide-up 0.25s ease-out;
}

.pp-bs-head {
  padding: 8rpx 0 16rpx;
}

.pp-bs-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink-900);
}

/* 弹层内容卡（对齐 Android：Ink50 底 + 圆角 16dp + padding 16dp） */
.pp-bs-card {
  background-color: var(--ink-50);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.pp-bs-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink-900);
}

.pp-bs-sub {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--ink-500);
}

.pp-bs-divider {
  height: 2rpx;
  background-color: var(--ink-200);
  margin: 28rpx 0;
}

/* 「播完整集声音再停止」单选行 */
.pp-bs-radio {
  gap: 8rpx;
  padding: 8rpx 0;
}

.pp-bs-radio-dot {
  font-size: 24rpx;
  color: var(--ink-500);
  line-height: 1;
}

.pp-bs-radio-text {
  font-size: 24rpx;
  color: var(--ink-500);
}

.pp-bs-radio.on .pp-bs-radio-dot,
.pp-bs-radio.on .pp-bs-radio-text {
  color: var(--primary-600);
}

.pp-bs-radio.on .pp-bs-radio-text {
  font-weight: 600;
}

/* 选项胶囊：等宽铺满一行，选中态主题色描边 + 浅底（对齐 Android SleepOptionChip） */
.pp-bs-chip-row {
  gap: 20rpx;
  margin-top: 24rpx;
}

.pp-bs-chip {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  background-color: #ffffff;
  border: 2rpx solid var(--ink-200);
}

.pp-bs-chip.on {
  background-color: var(--primary-50);
  border-color: var(--primary-600);
}

.pp-bs-chip-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--ink-600);
  white-space: nowrap;
}

.pp-bs-chip.on .pp-bs-chip-text {
  color: var(--primary-600);
  font-weight: 600;
}

.pp-bs-section {
  margin-top: 36rpx;
}

/* 定时启播占位卡 */
.pp-bs-later {
  align-items: center;
}

.pp-bs-later-arrow {
  width: 40rpx;
  height: 40rpx;
}

/* ── 播放列表弹层 ── */
.pp-pl-list {
  max-height: 50vh;
}

.pp-pl-empty {
  padding: 64rpx 0;
}

.pp-pl-item {
  gap: 20rpx;
  padding: 16rpx 8rpx;
  border-radius: var(--r-md);
}

.pp-pl-item.current {
  background-color: var(--primary-50);
}

.pp-pl-cover {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--r-md);
  flex-shrink: 0;
}

.pp-pl-texts {
  gap: 4rpx;
}

.pp-pl-title {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--ink-900);
}

.pp-pl-item.current .pp-pl-title {
  color: var(--primary-600);
  font-weight: 600;
}

.pp-pl-sub {
  font-size: 22rpx;
  color: var(--ink-500);
}

.pp-pl-playing-text {
  font-size: 20rpx;
  color: var(--primary-600);
  font-weight: 600;
  flex-shrink: 0;
}

/* 当前集播放中：3 根主题色均衡器小柱 */
@keyframes pp-pl-eq {
  0%,
  100% {
    transform: scaleY(0.3);
  }
  50% {
    transform: scaleY(1);
  }
}

.pp-pl-eq {
  display: flex;
  align-items: center;
  gap: 3rpx;
  height: 28rpx;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.pp-pl-eq-bar {
  width: 4rpx;
  height: 28rpx;
  background-color: var(--primary-600);
  border-radius: 2rpx;
  animation: pp-pl-eq 1s ease-in-out infinite;
}
