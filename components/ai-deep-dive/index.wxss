/* components/ai-deep-dive — AI 精讲本集（三态卡 + 四类内容） */

.dd-card {
  background-color: #ffffff;
  border-radius: 32rpx;
  border: 1px solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.03);
  padding: 32rpx;
}

/* ── 头部（三态共用） ── */
.dd-head {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.dd-icon-circle {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #7f56d9 0%, #9e77ed 100%);
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(127, 86, 217, 0.3);
}

.dd-icon {
  width: 40rpx;
  height: 40rpx;
}

.dd-spinner {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: dd-spin 0.9s linear infinite;
}

@keyframes dd-spin {
  to {
    transform: rotate(360deg);
  }
}

.dd-head-main {
  flex: 1;
  min-width: 0;
}

.dd-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
}

.dd-pro-badge {
  background-color: #feebc8;
  color: #c05621;
  font-size: 18rpx;
  font-weight: 800;
  padding: 2rpx 12rpx;
  border-radius: 50rpx;
  margin-left: 12rpx;
  border: 1px solid #fbd38d;
  letter-spacing: 2rpx;
}

/* 头部描述：labelMedium 12sp（对齐闪卡可读下限之上） */
.dd-desc {
  font-size: 26rpx;
  color: #6b7280;
  line-height: 1.6;
  margin-top: 8rpx;
}

.dd-lock {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 4rpx;
}

.dd-chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 2rpx;
}

/* ── 四分类胶囊（锁定/未展开态） ── */
.dd-chips {
  margin-top: 28rpx;
}

.dd-chip {
  background-color: #f8f9fa;
  border: 1px solid rgba(0, 0, 0, 0.03);
  padding: 10rpx 22rpx;
  border-radius: 50rpx;
  margin-right: 16rpx;
  margin-bottom: 16rpx;
}

.dd-chip-icon {
  width: 26rpx;
  height: 26rpx;
  margin-right: 10rpx;
}

.dd-chip-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #6b7280;
}

/* ── 展开态内容区（2026-09-23 字号对齐闪卡 Material3 口径：1sp=2rpx，
      正文可读下限 28rpx，参考 pages/review/vocab-review） ── */
.dd-body {
  margin-top: 8rpx;
}

/* 分类小标题：labelMedium 12sp（闪卡 label 体系，眉标级） */
.dd-section-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #9ca3af;
  letter-spacing: 4rpx;
  margin: 28rpx 0 20rpx;
}

/* 难点词汇预扫 */
.dd-vocab-list {
  gap: 16rpx;
}

.dd-vocab-card {
  background-color: #f6f5f1;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 主干词汇：titleLarge 20sp（闪卡同体系醒目英文令牌，text-xl 级） */
.dd-vocab-word {
  font-size: 40rpx;
  font-weight: 800;
  color: #1f7a5c;
}

/* 音标：labelMedium 12sp 正文可读级（对齐闪卡背面音标 28rpx，浅色层级） */
.dd-vocab-phonetic {
  font-size: 28rpx;
  color: #9ca3af;
  font-style: italic;
  margin-left: 16rpx;
}

/* 中文释义：bodyMedium 14sp（对齐闪卡背面释义中文 32rpx） */
.dd-vocab-meaning {
  font-size: 32rpx;
  color: #374151;
  margin-top: 12rpx;
  line-height: 1.7;
}

/* 解析正文：labelMedium 12sp 正文可读级 + relaxed 行高防密集 */
.dd-vocab-reason {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 8rpx;
  line-height: 1.7;
}

/* 长难句拆解 */
.dd-sentence-list {
  gap: 16rpx;
}

.dd-sentence-card {
  background-color: #f6f5f1;
  border-left: 6rpx solid #1f7a5c;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 长难句英文：bodyLarge 16sp（text-lg 级，加粗提级） */
.dd-sentence-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.7;
}

/* 拆解解析：labelMedium 12sp 正文可读级（对齐闪卡例句 28rpx） */
.dd-sentence-analysis {
  font-size: 28rpx;
  color: #6b7280;
  margin-top: 16rpx;
  line-height: 1.7;
}

/* 跟读句推荐 */
.dd-shadow-list {
  gap: 16rpx;
}

.dd-shadow-card {
  background-color: #f6f5f1;
  border-radius: 20rpx;
  padding: 24rpx;
  align-items: flex-start;
}

.dd-shadow-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  margin-top: 4rpx;
}

/* 跟读句英文：bodyLarge 16sp（与长难句同主干级） */
.dd-shadow-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
  line-height: 1.7;
}

/* 推荐理由：labelSmall 11sp（闪卡中文翻译同级次文案） */
.dd-shadow-reason {
  font-size: 24rpx;
  color: #9ca3af;
  margin-top: 8rpx;
  line-height: 1.6;
}

/* 理解测验 */
.dd-quiz-list {
  gap: 20rpx;
}

.dd-quiz-card {
  background-color: #f6f5f1;
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 测验题干：bodyLarge 16sp（主干阅读内容） */
.dd-quiz-question {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.6;
  margin-bottom: 20rpx;
}

.dd-quiz-options {
  gap: 14rpx;
}

.dd-opt {
  background-color: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  align-items: flex-start;
}

.dd-opt.opt-correct {
  background-color: rgba(31, 122, 92, 0.08);
  border-color: rgba(31, 122, 92, 0.55);
}

.dd-opt.opt-wrong {
  background-color: rgba(210, 80, 63, 0.06);
  border-color: rgba(210, 80, 63, 0.55);
}

.dd-opt-letter {
  width: 36rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #9ca3af;
  text-align: center;
  flex-shrink: 0;
  margin-right: 8rpx;
}

.dd-opt-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  margin-right: 10rpx;
}

/* 选项正文：labelMedium 12sp 正文可读级 */
.dd-opt-text {
  flex: 1;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.6;
}

.dd-quiz-explain {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

/* 解析正文：labelMedium 12sp 正文可读级 + relaxed 行高 */
.dd-quiz-explain-text {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.7;
}

/* 底部收起控制栏 */
.dd-collapse-bar {
  justify-content: flex-end;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1px solid #f0ede6;
}

.dd-collapse-btn {
  padding: 12rpx 20rpx;
  border-radius: 14rpx;
}

.dd-collapse-text {
  font-size: 24rpx;
  color: #6b7280;
  margin-right: 6rpx;
}

.dd-collapse-icon {
  width: 28rpx;
  height: 28rpx;
}

/* ── 通用工具类（组件样式隔离，需自带） ── */
.row {
  display: flex;
  flex-direction: row;
}
.col {
  display: flex;
  flex-direction: column;
}
.center {
  display: flex;
  align-items: center;
  justify-content: center;
}
.end {
  display: flex;
  justify-content: flex-end;
}
.align-center {
  align-items: center;
}
.align-baseline {
  align-items: baseline;
}
.wrap {
  flex-wrap: wrap;
}
.flex-1 {
  flex: 1;
  min-width: 0;
}
.tap-scale-light {
  transition: opacity 0.15s ease;
}
.tap-scale-light:active {
  opacity: 0.75;
}
