<!-- 扁平容器：无卡片背景/阴影/圆角，直接落于页面底色（与“节目介绍”模块同风格） -->
<view class="dd-section">

  <!-- 行1：标题 + 权限状态（PRO 徽标 / 锁 / 展开箭头） -->
  <view class="dd-head row align-center {{!content ? 'tap-scale-light' : ''}}" bindtap="onHeadTap">
    <text class="dd-title">AI 精讲本集</text>
    <view class="dd-pro-badge" wx:if="{{isLoggedIn && !isPremium}}">PRO</view>
    <view class="flex-1"></view>
    <image class="dd-lock" wx:if="{{isLoggedIn && !isPremium}}" src="/assets/icons/lock.svg"></image>
    <image class="dd-chevron" wx:elif="{{isPremium && !isLoading}}" src="{{content && isOpen ? '/assets/icons/chevron-up-gray.svg' : '/assets/icons/chevron-down-gray.svg'}}"></image>
  </view>

  <!-- 行2：星星图标（与右侧两行标签整体垂直居中）+ 2x2 标签网格（展开态兼作过滤器） -->
  <view class="dd-sub row align-center">
    <view class="dd-icon-circle center">
      <view class="dd-spinner" wx:if="{{isLoading}}"></view>
      <image class="dd-icon" src="/assets/icons/sparkles.svg" wx:else></image>
    </view>
    <!-- 缓存命中的安静加载（isLoading 且非 isGenerating）：标签网格保持可见，仅图标位转圈；
         仅探测确认将触发 LLM 首次生成（isGenerating）时才以加载文案替换标签 -->
    <view class="dd-chip-grid col" wx:if="{{!isGenerating}}">
      <view class="dd-chip-row row" wx:for="{{chipRows}}" wx:key="id" wx:for-item="chipRow">
        <view
          class="dd-chip row align-center {{activeFilter === item.key ? 'dd-chip-active' : ''}}"
          wx:for="{{chipRow.list}}"
          wx:key="key"
          data-key="{{item.key}}"
          catchtap="onChipTap"
        >
          <image class="dd-chip-icon" src="{{item.icon}}"></image>
          <text class="dd-chip-text">{{item.text}}</text>
        </view>
      </view>
    </view>
    <text class="dd-loading-text flex-1" wx:else>AI 正在精读字幕并生成精讲内容，首次生成约需 30-60 秒...</text>
  </view>

  <!-- 展开态：按 activeFilter 条件渲染四类精讲内容（无卡片包裹） -->
  <block wx:if="{{content && isOpen}}">
    <view class="dd-body col">

      <!-- 难点词汇预扫 -->
      <view wx:if="{{content.vocabulary.length > 0 && (activeFilter === 'all' || activeFilter === 'vocabulary')}}">
        <text class="dd-section-title">难点词汇预扫</text>
        <view class="dd-vocab-list col">
          <view class="dd-vocab-item col" wx:for="{{content.vocabulary}}" wx:key="word" wx:for-item="v">
            <view class="row align-baseline wrap">
              <text class="dd-vocab-word">{{v.word}}</text>
              <text class="dd-vocab-phonetic" wx:if="{{v.phonetic}}">{{v.phonetic}}</text>
            </view>
            <text class="dd-vocab-meaning">{{v.meaning}}</text>
            <text class="dd-vocab-reason" wx:if="{{v.reason}}">{{v.reason}}</text>
          </view>
        </view>
      </view>

      <!-- 长难句拆解 -->
      <view wx:if="{{content.sentences.length > 0 && (activeFilter === 'all' || activeFilter === 'sentences')}}">
        <text class="dd-section-title">长难句拆解</text>
        <view class="dd-sentence-list col">
          <view class="dd-sentence-item col" wx:for="{{content.sentences}}" wx:key="text" wx:for-item="s">
            <text class="dd-sentence-text">{{s.text}}</text>
            <text class="dd-sentence-analysis">{{s.analysis}}</text>
          </view>
        </view>
      </view>

      <!-- 跟读句推荐 -->
      <view wx:if="{{content.shadowing.length > 0 && (activeFilter === 'all' || activeFilter === 'shadowing')}}">
        <text class="dd-section-title">跟读句推荐</text>
        <view class="dd-shadow-list col">
          <view class="dd-shadow-item row" wx:for="{{content.shadowing}}" wx:key="text" wx:for-item="sd">
            <image class="dd-shadow-icon" src="/assets/icons/headphones.svg"></image>
            <view class="col flex-1">
              <text class="dd-shadow-text">{{sd.text}}</text>
              <text class="dd-shadow-reason" wx:if="{{sd.reason}}">{{sd.reason}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 理解测验 -->
      <view wx:if="{{content.quiz.length > 0 && (activeFilter === 'all' || activeFilter === 'quiz')}}">
        <text class="dd-section-title">理解测验</text>
        <view class="dd-quiz-list col">
          <view class="dd-quiz-item col" wx:for="{{content.quiz}}" wx:key="question" wx:for-item="q" wx:for-index="qi">
            <text class="dd-quiz-question">{{qi + 1}}. {{q.question}}</text>
            <view class="dd-quiz-options col">
              <view
                class="dd-opt row {{quizAnswers[qi] !== undefined && q.answer === oi ? 'opt-correct' : (quizAnswers[qi] === oi ? 'opt-wrong' : 'opt-normal')}}"
                wx:for="{{q.options}}"
                wx:key="*this"
                wx:for-item="opt"
                wx:for-index="oi"
                data-qi="{{qi}}"
                data-oi="{{oi}}"
                catchtap="onPickOption"
              >
                <image class="dd-opt-icon" wx:if="{{quizAnswers[qi] !== undefined && q.answer === oi}}" src="/assets/icons/check-circle.svg"></image>
                <image class="dd-opt-icon" wx:elif="{{quizAnswers[qi] === oi}}" src="/assets/icons/x-circle.svg"></image>
                <text class="dd-opt-letter" wx:else>{{letters[oi]}}</text>
                <text class="dd-opt-text">{{opt}}</text>
              </view>
            </view>
            <view class="dd-quiz-explain" wx:if="{{quizAnswers[qi] !== undefined && q.explanation}}">
              <text class="dd-quiz-explain-text">{{q.explanation}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 过滤空态：选中分类无内容 -->
      <view class="dd-empty col center" wx:if="{{filterEmpty}}">
        <text class="dd-empty-text">该分类暂无精讲内容</text>
      </view>

      <!-- 底部收起控制栏 -->
      <view class="dd-collapse-bar row end">
        <view class="dd-collapse-btn row center tap-scale-light" bindtap="onCollapse">
          <text class="dd-collapse-text">收起内容</text>
          <image class="dd-collapse-icon" src="/assets/icons/chevron-up-gray.svg"></image>
        </view>
      </view>
    </view>
  </block>
</view>

<premium-modal visible="{{showPremiumModal}}" source="episode_deep_dive" bind:close="onPremiumModalClose" />
