/**
 * components/sentence-tag-drawer/index.wxss — 句子完善抽屉样式
 * 逐项映射 Web QuickTagDrawer：rounded-t-3xl 底部抽屉、primary-500/10 圆形
 * 头部图标、base-200 原句预览卡、选中 primary-600 白字胶囊 / 自定义 accent
 * 微底胶囊、虚线「+ 自定义」、primary 保存按钮（对齐 bg-primary-600 圆角 xl）。
 */

.std-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: calc(var(--z-sheet) + 10);
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  animation: std-fade 0.2s ease;
}
@keyframes std-fade {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.std-sheet {
  position: relative;
  width: 100%;
  max-height: 88vh;
  background: var(--card-bg);
  border-radius: 48rpx 48rpx 0 0;
  box-shadow: var(--e3);
  border: 1rpx solid var(--border-color);
  border-bottom: none;
  animation: std-in 0.3s ease;
}
@keyframes std-in {
  from {
    transform: translateY(96rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* ── 头部 ── */
.std-header {
  padding: 24rpx 24rpx 24rpx 48rpx;
  border-bottom: 1rpx solid var(--color-base-300);
}
.std-header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(31, 122, 92, 0.1);
  margin-right: 16rpx;
}
.std-header-icon-img {
  width: 36rpx;
  height: 36rpx;
}
.std-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
}
.std-subtitle {
  font-size: 24rpx;
  color: var(--ink-400);
  margin-top: 2rpx;
}
.std-close {
  width: 64rpx;
  height: 64rpx;
}
.std-close-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ── 主体 ── */
.std-body {
  flex: 1;
  min-height: 0;
}
.std-body-inner {
  padding: 32rpx 48rpx;
}

/* 原句预览卡 */
.std-preview {
  background: var(--color-base-200);
  border: 1rpx solid var(--color-base-300);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 32rpx;
}
.std-preview-en {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.6;
}
.std-preview-zh {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--ink-500);
}

.std-section {
  margin-bottom: 32rpx;
}
.std-label {
  gap: 10rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink-700);
  margin-bottom: 16rpx;
}
.std-label-icon {
  width: 26rpx;
  height: 26rpx;
}

/* 标签胶囊流：横向紧凑排列、触界自动换行（QuickTagDrawer: flex flex-wrap gap-1.5；
 * 注意 app.wxss 的 .wrap 只含 flex-wrap，容器必须自带 display:flex 才生效） */
.std-tags {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}
.std-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 24rpx;
  border-radius: var(--r-full);
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0; /* 行内不被压缩变形 */
  background: #f3f4f6; /* gray-100（QuickTagDrawer 未选中态原值） */
  color: #4b5563; /* gray-600 */
  transition: all 0.15s ease;
}
/* 选中：primary 实底白字 */
.std-tag--on {
  background: var(--primary-600);
  color: #ffffff;
  box-shadow: var(--e1);
}
/* 自定义标签：accent 微底 + 描边 */
.std-tag--custom {
  background: rgba(217, 138, 23, 0.1);
  color: var(--accent-700);
  border: 1rpx solid rgba(229, 157, 46, 0.3);
}
/* + 自定义：虚线描边 */
.std-tag--add {
  border: 2rpx dashed var(--color-base-300);
  color: var(--ink-400);
  gap: 6rpx;
}
.std-tag-add-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 自定义标签输入行 */
.std-tag-input-row {
  gap: 8rpx;
}
.std-tag-input {
  width: 200rpx;
  height: 52rpx;
  padding: 0 20rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--color-base-300);
  background: var(--card-bg);
  font-size: 22rpx;
}
.std-tag-confirm {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--color-primary);
}
.std-tag-confirm-icon {
  width: 24rpx;
  height: 24rpx;
}

/* 学习笔记 */
.std-note {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-base-300);
  border-radius: 32rpx;
  background: var(--card-bg);
  font-size: 24rpx;
  line-height: 1.6;
  box-sizing: border-box;
}

/* ── 底部操作 ── */
.std-footer {
  flex-shrink: 0;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-base-300);
}
.std-btn-ghost {
  padding: 16rpx 24rpx;
  border-radius: var(--r-md);
  font-size: 24rpx;
  color: var(--ink-400);
}
.std-btn-save {
  gap: 10rpx;
  padding: 16rpx 40rpx;
  border-radius: var(--r-md);
  background: var(--primary-600);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: var(--e1);
}
.std-btn-save--busy {
  opacity: 0.7;
}
.std-btn-save-icon {
  width: 26rpx;
  height: 26rpx;
}
.std-spin {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  animation: std-rotate 0.8s linear infinite;
}
@keyframes std-rotate {
  to {
    transform: rotate(360deg);
  }
}
