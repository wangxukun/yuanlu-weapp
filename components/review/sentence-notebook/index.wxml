<!-- 句子本根视图：T2.1 数据接入与生词高亮联动 + T2.2 统计/配额/搜索筛选；完整卡片与微播放器见 T2.3 -->
<scroll-view class="notebook-scroll" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="sn-page {{themeClass}}">

    <!-- 首次加载 -->
    <view wx:if="{{loading && !loaded}}" class="sn-firstload col">
      <view class="sn-spin"></view>
      <text class="t-caption text-tertiary">正在加载句子本…</text>
    </view>

    <block wx:else>
      <!-- 全局空态（Web 空态文案逐字；统计/筛选随之隐藏，三端一致） -->
      <view wx:if="{{stats.sentenceCount === 0}}" class="card sn-empty col">
        <view class="sn-empty-badge center">
          <image class="sn-empty-icon" src="{{dark ? '/assets/icons/format-quote-primary-dark.svg' : '/assets/icons/format-quote-primary.svg'}}" mode="aspectFit" />
        </view>
        <text class="sn-empty-title t-h3">句子本暂无匹配内容</text>
        <text class="sn-empty-desc t-caption">在收听播客时打开「沉浸式逐字稿」，点击字幕行右侧的“书签”按钮，即可一键收藏精选原句！</text>
        <view class="btn-primary sn-empty-btn tap-scale" bindtap="onGoDiscover">去浏览播客</view>
      </view>

      <block wx:else>
        <!-- ══ 1. 统计三格（count>0 才渲染；文案逐字对齐 Web SentenceStats）══ -->
        <view class="sn-stats row">
          <view class="sn-stat col">
            <view class="sn-stat-ic center"><image class="sn-stat-img" src="{{dark ? '/assets/icons/format-quote-primary-dark.svg' : '/assets/icons/format-quote-primary.svg'}}" /></view>
            <view class="sn-stat-txt col">
              <text class="sn-stat-label">关键句</text>
              <text class="sn-stat-num">{{stats.sentenceCount}}</text>
            </view>
          </view>
          <view class="sn-stat col">
            <view class="sn-stat-ic sn-stat-ic--amber center"><image class="sn-stat-img" src="{{dark ? '/assets/icons/warning-dark.svg' : '/assets/icons/warning.svg'}}" /></view>
            <view class="sn-stat-txt col">
              <text class="sn-stat-label">联动词汇</text>
              <text class="sn-stat-num">{{stats.vocabCount}}</text>
            </view>
          </view>
          <view class="sn-stat col">
            <view class="sn-stat-ic sn-stat-ic--info center"><image class="sn-stat-img" src="{{dark ? '/assets/icons/label-info-dark.svg' : '/assets/icons/label-info.svg'}}" /></view>
            <view class="sn-stat-txt col">
              <text class="sn-stat-label">分类标签</text>
              <text class="sn-stat-num">{{stats.tagCount}}</text>
            </view>
          </view>
        </view>

        <!-- ══ 2. 复习横幅（Web SentenceStats 卡片复习入口，文案逐字）══ -->
        <view class="sn-banner">
          <view class="row sn-banner-head">
            <image class="sn-banner-ic" src="{{dark ? '/assets/icons/psychology-dark.svg' : '/assets/icons/psychology-primary300.svg'}}" />
            <text class="sn-banner-title">卡片复习已就绪</text>
          </view>
          <text class="sn-banner-desc">共收藏 <text class="sn-banner-strong">{{stats.sentenceCount}} 个关键句</text>，与生词本 <text class="sn-banner-strong">{{stats.vocabCount}} 个词汇</text> 深度联动，随时开始 AI 影子跟读与卡片复习。</text>
          <view class="sn-banner-btn center tap-scale" bindtap="onStartDeck">
            <image class="sn-banner-btn-ic" src="{{dark ? '/assets/icons/play-circle-primary-m-dark.svg' : '/assets/icons/play-circle-primary-m.svg'}}" />
            <text>卡片复习模式</text>
          </view>
        </view>

        <!-- ══ 3. 配额双栏卡（Web QuotaStatusCard 复用；文案由 quotaTexts 拼装）══ -->
        <quota-card
          isPremium="{{isPremium}}"
          premiumTitle="PRO 无限收藏 · 已收 {{stats.sentenceCount}} 句"
          premiumSubtitle="容量不设限，复习评测也不限次"
          primaryLabel="句子本容量"
          primaryStatusText="{{quota.primaryStatusText}}"
          primaryUsed="{{stats.sentenceCount}}"
          primaryLimit="{{sentenceLimit}}"
          dailyLabel="今日复习评测"
          dailyStatusText="{{quota.dailyStatusText}}"
          dailyUsed="{{evalQuota.used === null ? 0 : evalQuota.used}}"
          dailyLimit="{{evalQuota.limit}}"
        />

        <!-- ══ 4. 搜索与筛选面板（Web Control Panel；空状态隐藏）══ -->
        <view class="sn-panel">
          <!-- 搜索行（四路匹配：enText/zhText/note/tags） -->
          <view class="sn-search row">
            <image class="sn-search-ic" src="/assets/icons/search.svg" />
            <input
              class="sn-search-input"
              placeholder="搜索英文原句、中文翻译、笔记或标签..."
              placeholder-class="sn-search-ph"
              value="{{searchQuery}}"
              confirm-type="search"
              bindinput="onSearchInput"
            />
            <view wx:if="{{searchQuery}}" class="sn-search-clear center tap-dim" bindtap="onClearSearch">
              <image class="sn-search-clear-ic" src="/assets/icons/close.svg" />
            </view>
          </view>

          <!-- 剧集筛选 + 视图切换（导出已随 T2.4 裁剪，不再补位） -->
          <view class="row sn-panel-row">
            <picker class="sn-picker" mode="selector" range="{{episodeNames}}" value="{{episodeIdx}}" bindchange="onEpisodeChange">
              <view class="sn-picker-field row">
                <text class="sn-picker-label ellipsis">{{episodeNames[episodeIdx]}}</text>
                <image class="sn-picker-chevron" src="/assets/icons/keyboard-arrow-down-gray.svg" />
              </view>
            </picker>
            <view class="row sn-viewtoggle">
              <view class="sn-viewbtn center {{viewMode === 'cards' ? 'sn-viewbtn--on' : ''}}" data-view="cards" bindtap="onViewTap">
                <image class="sn-viewbtn-ic" src="{{viewCardsSrc}}" />
                <text>卡片详情</text>
              </view>
              <view class="sn-viewbtn center {{viewMode === 'compact' ? 'sn-viewbtn--on' : ''}}" data-view="compact" bindtap="onViewTap">
                <image class="sn-viewbtn-ic" src="{{viewCompactSrc}}" />
                <text>简洁清单</text>
              </view>
            </view>
          </view>

          <!-- 标签 pills（单行水平滚动，Web overflow-x-auto 同款；含计数 + 清除筛选） -->
          <scroll-view class="sn-tags-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="sn-tags row">
              <image class="sn-tags-ic" src="/assets/icons/filter-list-gray.svg" />
              <text class="sn-tags-label">标签分类：</text>
              <view class="sn-tagpill {{filterTag === 'ALL' ? 'sn-tagpill--on' : ''}}" data-tag="ALL" bindtap="onTagTap">全部 ({{stats.sentenceCount}})</view>
              <view
                wx:for="{{tagCloud}}"
                wx:key="name"
                class="sn-tagpill {{filterTag === item.name ? 'sn-tagpill--on' : ''}}"
                data-tag="{{item.name}}"
                bindtap="onTagTap"
              >{{item.name}} ({{item.count}})</view>
              <view wx:if="{{hasFilter}}" class="sn-clearfilter" bindtap="onClearFilter">清除筛选</view>
            </view>
          </scroll-view>
        </view>

        <!-- ══ 5. 列表区：筛选空态 / 卡片详情 / 简洁清单（T2.3 升级微播放器与操作坞）══ -->
        <view wx:if="{{filteredList.length === 0}}" class="card sn-filterempty col">
          <text class="sn-filterempty-title">未找到匹配的句子</text>
          <text class="sn-filterempty-desc t-caption">调整搜索词或筛选条件试试</text>
        </view>

        <!-- 简洁清单：单容器整行式（Web divide-y 分隔线，行间零外距） -->
        <view wx:elif="{{viewMode === 'compact'}}" class="card sn-compact-wrap">
          <view wx:for="{{filteredList}}" wx:key="id" class="sn-compact">
            <view class="sn-compact-main row">
              <text class="sn-compact-idx">{{index + 1}}.</text>
              <view class="sn-compact-body col">
                <view class="sn-compact-en font-serif">
                  <text wx:for="{{item.enParts}}" wx:for-item="seg" wx:key="index"
                        class="{{seg.hit ? 'sn-hl' : ''}}">{{seg.text}}</text>
                </view>
                <text wx:if="{{item.zhText}}" class="sn-compact-zh">{{item.zhText}}</text>
                <view class="sn-compact-meta row">
                  <view wx:if="{{item.episodeTitle}}" class="sn-compact-ep row" data-episodeid="{{item.episodeid}}" bindtap="onEpisodeTap">
                    <image class="sn-compact-meta-ic" src="/assets/icons/podcasts-gray.svg" />
                    <text class="sn-compact-meta-ep ellipsis">{{item.episodeTitle}}</text>
                  </view>
                  <text wx:if="{{item.note}}" class="sn-compact-note ellipsis">{{item.note}}</text>
                </view>
              </view>
            </view>
            <!-- 底部操作行：仅 播放/循环/麦克风 三裸图标，整行靠右（简洁清单无编辑/删除） -->
            <view class="sn-compact-foot row">
              <sentence-micro-player
                sentence-id="{{item.id}}"
                episodeid="{{item.episodeid}}"
                start-time="{{item.startTime}}"
                end-time="{{item.endTime}}"
              />
              <view class="sn-act center {{item.hasSubtitle ? '' : 'sn-act--off'}}"
                    data-ok="{{item.hasSubtitle}}" data-id="{{item.id}}" bindtap="onShadowTap">
                <image class="sn-act-ic" src="{{item.hasSubtitle ? '/assets/icons/mic-gray.svg' : '/assets/icons/mic-off.svg'}}" />
              </view>
            </view>
          </view>
        </view>

        <!-- 卡片详情：英文原句（衬线粗体 + 生词高亮）+ meta pills + 微播放器底栏 + 折叠译文笔记 -->
        <block wx:else>
          <view wx:for="{{filteredList}}" wx:key="id" class="card sn-item {{expandedId === item.id ? 'sn-item--open' : ''}}">
            <view class="sn-item-en font-serif">
              <text wx:for="{{item.enParts}}" wx:for-item="seg" wx:key="index"
                    class="{{seg.hit ? 'sn-hl' : ''}}">{{seg.text}}</text>
            </view>
            <view class="sn-item-meta row">
              <view wx:if="{{item.episodeTitle}}" class="sn-item-ep row" data-episodeid="{{item.episodeid}}" bindtap="onEpisodeTap">
                <image class="sn-item-ep-ic" src="/assets/icons/podcasts-gray.svg" />
                <text class="sn-item-ep-text ellipsis">{{item.episodeTitle}}</text>
              </view>
              <view class="sn-item-tags row">
                <text class="sn-item-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">#{{tag}}</text>
              </view>
            </view>

            <!-- 底栏：折叠按钮居左 + 5 图标居右（播放/循环/跟读/编辑/删除）同一行 -->
            <view class="sn-item-bar row">
              <view class="sn-collapse row" data-id="{{item.id}}" bindtap="onToggleExpand">
                <text class="sn-collapse-text">{{expandedId === item.id ? '收起译文与笔记' : '查看中文翻译 & 笔记'}}</text>
                <image class="sn-collapse-ic {{expandedId === item.id ? 'sn-collapse-ic--up' : ''}}" src="/assets/icons/keyboard-arrow-down-gray.svg" />
              </view>
              <view class="sn-item-acts row">
                <sentence-micro-player
                  sentence-id="{{item.id}}"
                  episodeid="{{item.episodeid}}"
                  start-time="{{item.startTime}}"
                  end-time="{{item.endTime}}"
                />
                <view class="sn-act center {{item.hasSubtitle ? '' : 'sn-act--off'}}"
                      data-ok="{{item.hasSubtitle}}" data-id="{{item.id}}" bindtap="onShadowTap">
                  <image class="sn-act-ic" src="{{item.hasSubtitle ? '/assets/icons/mic-gray.svg' : '/assets/icons/mic-off.svg'}}" />
                </view>
                <view class="sn-act center" data-id="{{item.id}}" bindtap="onEditTap">
                  <image class="sn-act-ic" src="/assets/icons/edit-gray.svg" />
                </view>
                <view class="sn-act center" data-id="{{item.id}}" bindtap="onDeleteTap">
                  <image class="sn-act-ic" src="/assets/icons/delete-gray.svg" />
                </view>
              </view>
            </view>

            <!-- 折叠区：参考译文 + 个人笔记（Web Accordion Body） -->
            <view wx:if="{{expandedId === item.id}}" class="sn-fold col">
              <view class="sn-fold-block col">
                <view class="sn-fold-label row">
                  <image class="sn-fold-label-ic" src="/assets/icons/menu-book-primary.svg" />
                  <text>参考译文</text>
                </view>
                <text class="sn-fold-zh">{{item.zhText || '暂无翻译'}}</text>
              </view>
              <view class="sn-fold-block col">
                <view class="sn-fold-label row">
                  <image class="sn-fold-label-ic" src="/assets/icons/description-indigo.svg" />
                  <text>个人笔记 &amp; 语法搭配</text>
                </view>
                <text wx:if="{{item.note}}" class="sn-fold-note">{{item.note}}</text>
                <view wx:else class="sn-fold-addnote" data-id="{{item.id}}" bindtap="onEditTap">+ 添加你的第一条学习笔记</view>
              </view>
            </view>
          </view>
        </block>
      </block>
    </block>

  </view>
</scroll-view>

<!-- 标签/笔记编辑抽屉（T2.3 复用精听页同款 QuickTagDrawer） -->
<sentence-tag-drawer sentence="{{editSentence}}" bindupdated="onDrawerUpdated" bindclose="onDrawerClose" />
