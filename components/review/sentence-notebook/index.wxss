/* 句子本根视图（占位） */
.notebook-scroll {
  height: 100%;
}
.notebook-pad {
  padding: var(--page-padding);
}
.notebook-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}
.np-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-full);
  background: var(--primary-50);
  margin-bottom: 24rpx;
}
.np-icon {
  width: 56rpx;
  height: 56rpx;
}
.np-title {
  color: var(--text-primary);
}
.np-desc {
  color: var(--text-secondary);
  margin-top: 12rpx;
  text-align: center;
}
.np-phase {
  margin-top: 32rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--r-full);
  background: var(--ink-100);
  color: var(--text-tertiary);
  font-size: 22rpx;
}
