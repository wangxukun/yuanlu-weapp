/**
 * components/review/vocab-notebook/index.wxss — 生词本根视图样式
 * 逐项映射 Web app/(main)/library/vocabulary 的 Tailwind 类（移动端 <xl 形态）：
 * 统计三格 grid-cols-3、primary-600 复习横幅、ink-50 搜索框、
 * 紧凑卡 rounded-2xl shadow、熟练度渐变竖条、展开面板 ring-primary-600/30、
 * US(primary)/UK(secondary) 音标胶囊、原声出处 primary-50 渐变卡、
 * 前缀 warning/词根 error/后缀 success 词源 chips、底部操作渐变绿按钮。
 */

.vn-scroll {
  height: 100%;
}
.vn-page {
  padding: 24rpx 32rpx 0;
}
.vn-bottom-space {
  /* 底部让位：跨页迷你播放条（elevated 2rpx）+ 安全区 */
  height: calc(var(--mini-player-height) + env(safe-area-inset-bottom) + 24rpx);
}

/* ── 首次加载 ── */
.vn-firstload {
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}
.vn-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(31, 122, 92, 0.2);
  border-top-color: var(--primary-600);
  border-radius: 50%;
  animation: vn-rotate 0.8s linear infinite;
}
.vn-mini-spin {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(31, 122, 92, 0.2);
  border-top-color: var(--primary-600);
  border-radius: 50%;
  animation: vn-rotate 0.8s linear infinite;
}
@keyframes vn-rotate {
  to {
    transform: rotate(360deg);
  }
}

/* ── 统计三格（bg-white px-2 py-3 rounded-lg 三列网格） ── */
.vn-stats {
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.vn-stat {
  flex: 1;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--r-md);
  padding: 20rpx 16rpx;
}
.vn-stat-ic {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-md);
  background: var(--ink-50);
  margin-bottom: 8rpx;
}
.vn-stat-ic--due {
  background: rgba(217, 138, 23, 0.1); /* warning/10 */
}
.vn-stat-ic--done {
  background: rgba(46, 143, 111, 0.1); /* success/10 */
}
.vn-stat-img {
  width: 32rpx;
  height: 32rpx;
}
.vn-stat-label {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(27, 24, 18, 0.4);
  letter-spacing: 0.05em;
}
.vn-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

/* ── 复习横幅（bg-primary-600 白字） ── */
.vn-banner {
  background: var(--primary-600);
  border-radius: var(--r-md);
  padding: 44rpx 40rpx;
  margin-bottom: 24rpx;
}
.vn-banner-head {
  gap: 20rpx;
  margin-bottom: 14rpx;
}
.vn-banner-ic {
  width: 44rpx;
  height: 44rpx;
}
.vn-banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
.vn-banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}
.vn-banner-strong {
  color: #ffffff;
  font-weight: 700;
}
.vn-banner-btn {
  margin-top: 32rpx;
  background: #ffffff;
  color: var(--primary-600);
  border-radius: var(--r-md);
  padding: 22rpx 56rpx;
  font-size: 28rpx;
  font-weight: 700;
  align-self: flex-start;
  gap: 12rpx;
  display: flex;
}
.vn-banner-btn-ic {
  width: 36rpx;
  height: 36rpx;
}

/* ── 全部完成卡 ── */
.vn-allclear {
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--r-md);
  padding: 44rpx;
  margin-bottom: 24rpx;
}
.vn-allclear-ic {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}
.vn-allclear-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}
.vn-allclear-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  text-align: center;
}

/* ── 全局空态 ── */
.vn-empty {
  align-items: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: var(--r-xl);
  padding: 96rpx 48rpx;
}
.vn-empty-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--ink-100);
  margin-bottom: 32rpx;
}
.vn-empty-img {
  width: 56rpx;
  height: 56rpx;
}
.vn-empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.vn-empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-top: 8rpx;
}
.vn-empty-btn {
  margin-top: 40rpx;
  background: var(--primary-600);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--r-md);
  padding: 16rpx 40rpx;
}

/* ── 筛选栏 ── */
.vn-controls {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
.vn-pills {
  gap: 12rpx;
  border-bottom: 1rpx solid rgba(227, 221, 207, 0.5);
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}
.vn-pill {
  padding: 10rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--r-full);
  color: var(--text-tertiary);
}
.vn-pill--learn {
  background: var(--primary-50);
  color: var(--primary-600);
}
.vn-pill--done {
  background: rgba(46, 143, 111, 0.1); /* success/10 */
  color: var(--color-success);
}
.vn-search {
  background: var(--ink-50);
  border-radius: var(--r-md);
  padding: 14rpx 20rpx;
  gap: 16rpx;
}
.vn-search-ic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.vn-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}
.vn-search-ph {
  color: var(--text-tertiary);
}
.vn-search-clear {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.vn-search-clear-ic {
  width: 28rpx;
  height: 28rpx;
}
.vn-sorts {
  gap: 16rpx;
  margin-top: 20rpx;
}
.vn-sort {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--r-md);
  color: var(--text-tertiary);
}
.vn-sort--on {
  background: var(--primary-600);
  color: #ffffff;
  box-shadow: var(--e1);
}

/* ── 卡片列表 ── */
.vn-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.vn-card {
  background: var(--card-bg);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  overflow: hidden;
}
.vn-card--open {
  box-shadow: var(--e2);
  border: 1rpx solid rgba(31, 122, 92, 0.3); /* ring-primary-600/30 */
}

/* ── 紧凑面 ── */
.vn-compact {
  padding: 28rpx 32rpx;
}
.vn-word-row {
  justify-content: space-between;
  gap: 16rpx;
}
.vn-word-wrap {
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}
.vn-word {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  max-width: 480rpx;
}
.vn-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--ink-200);
  flex-shrink: 0;
}
.vn-dot--due {
  background: var(--color-warning);
  box-shadow: 0 0 0 6rpx rgba(217, 138, 23, 0.18);
  animation: vn-pulse 2s ease-in-out infinite;
}
@keyframes vn-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}
.vn-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.vn-play-ic {
  width: 40rpx;
  height: 40rpx;
}
.vn-def {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}
.vn-meta {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(227, 221, 207, 0.5);
}
/* 熟练度 5 格竖条：level<=proficiency 渐变亮起（高度随档位递增） */
.vn-profs {
  gap: 8rpx;
  align-items: flex-end;
}
.vn-prof {
  width: 10rpx;
  border-radius: var(--r-full);
  background: var(--ink-100);
  transition: all 0.5s;
}
.vn-prof--h1 { height: 16rpx; }
.vn-prof--h2 { height: 20rpx; }
.vn-prof--h3 { height: 24rpx; }
.vn-prof--h4 { height: 28rpx; }
.vn-prof--h5 { height: 32rpx; }
.vn-prof--on {
  background: linear-gradient(to top, var(--primary-600), var(--primary-400));
  box-shadow: 0 2rpx 6rpx rgba(31, 122, 92, 0.2);
}
.vn-meta-right {
  gap: 16rpx;
  flex-shrink: 0;
}
.vn-badge-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
.vn-badge-done {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-success);
}
.vn-badge-due {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning);
  animation: vn-pulse 2s ease-in-out infinite;
}
.vn-badge-date {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}
.vn-chev {
  width: 36rpx;
  height: 36rpx;
}

/* ── 展开面板 ── */
.vn-panel {
  border-top: 1rpx solid rgba(227, 221, 207, 0.5);
  background: linear-gradient(to bottom, transparent, rgba(241, 237, 228, 0.3));
  padding: 32rpx;
  animation: vn-panel-in 0.3s ease;
}
@keyframes vn-panel-in {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 音标胶囊（US primary / UK secondary） */
.vn-phons {
  gap: 24rpx;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.vn-phon-pill {
  gap: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 14rpx 28rpx;
}
.vn-phon-tag {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--primary-600);
  letter-spacing: 0.1em;
}
.vn-phon-tag--uk {
  color: var(--color-secondary);
}
.vn-phon-text {
  font-size: 26rpx;
  font-family: Menlo, Consolas, monospace;
  color: var(--text-secondary);
}
.vn-phon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}
.vn-phon-btn-ic {
  width: 32rpx;
  height: 32rpx;
}
.vn-phon-btn-ic--uk {
  width: 32rpx;
  height: 32rpx;
}

/* 区块 */
.vn-sec {
  margin-bottom: 40rpx;
}
.vn-sec:last-of-type {
  margin-bottom: 0;
}
.vn-sec-head {
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.vn-sec-ic {
  width: 30rpx;
  height: 30rpx;
}
.vn-sec-title {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--text-secondary);
  letter-spacing: 0.02em;
}

/* 核心释义卡 */
.vn-defcard {
  position: relative;
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 24rpx;
  gap: 20rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  align-items: flex-start;
}
.vn-defcard-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: linear-gradient(to bottom, rgba(31, 122, 92, 0.5), var(--primary-600));
}
.vn-defcard-side {
  width: 132rpx;
  flex-shrink: 0;
  gap: 8rpx;
}
.vn-defcard-pos {
  align-self: flex-start;
  background: rgba(31, 122, 92, 0.1);
  color: var(--primary-700);
  font-size: 22rpx;
  font-weight: 700;
  border-radius: var(--r-md);
  border: 1rpx solid rgba(31, 122, 92, 0.2);
  padding: 6rpx 18rpx;
}
.vn-defcard-cefr {
  align-self: flex-start;
  background: rgba(74, 127, 165, 0.1);
  color: var(--info-500);
  font-size: 18rpx;
  font-weight: 700;
  border-radius: var(--r-sm);
  padding: 4rpx 12rpx;
  letter-spacing: 0.06em;
}
.vn-defcard-main {
  flex: 1;
  min-width: 0;
  gap: 6rpx;
}
.vn-defcard-cn {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.vn-defcard-en {
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 原声出处卡（primary-50 渐变 + 右上角标签） */
.vn-ctx {
  position: relative;
  background: linear-gradient(135deg, rgba(31, 122, 92, 0.05), rgba(217, 138, 23, 0.05));
  border: 1rpx solid rgba(31, 122, 92, 0.2);
  border-radius: var(--r-xl);
  padding: 36rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.vn-ctx-tag {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--primary-600);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 6rpx 20rpx;
  border-radius: 0 var(--r-xl) 0 var(--r-xl);
}
.vn-ctx-sentence {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  margin-bottom: 16rpx;
  padding-right: 120rpx;
  word-break: break-word;
  overflow-wrap: break-word;
}
.vn-ctx-hl {
  font-weight: 700;
  color: var(--primary-600);
  background: rgba(31, 122, 92, 0.2);
  padding: 0 6rpx;
  border-radius: 4rpx;
}
.vn-ctx-trans {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-bottom: 20rpx;
}
.vn-ctx-foot {
  gap: 16rpx;
}
.vn-ctx-ep {
  flex: 1;
  min-width: 0;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: var(--r-sm);
  padding: 8rpx 14rpx;
}
.vn-ctx-ep-ic {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}
.vn-ctx-ep-name {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.vn-ctx-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: var(--e1);
  flex-shrink: 0;
}
.vn-ctx-btn--on {
  background: rgba(31, 122, 92, 0.1);
}
.vn-ctx-btn-ic {
  width: 32rpx;
  height: 32rpx;
}

/* 字典例句卡 */
.vn-example {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.vn-example-row {
  gap: 24rpx;
  align-items: flex-start;
}
.vn-example-main {
  flex: 1;
  min-width: 0;
}
.vn-example-en {
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: break-word;
}
.vn-example-cn {
  font-size: 24rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
}
.vn-example-ctx {
  display: inline-block;
  margin-top: 16rpx;
  background: var(--ink-100);
  color: var(--text-secondary);
  font-size: 18rpx;
  font-weight: 700;
  border-radius: var(--r-sm);
  padding: 6rpx 18rpx;
  letter-spacing: 0.06em;
}
.vn-example-play {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--ink-50);
  flex-shrink: 0;
}
.vn-example-play--on {
  background: rgba(31, 122, 92, 0.1);
}
.vn-example-play-ic {
  width: 30rpx;
  height: 30rpx;
}

/* 词形变化 chips */
.vn-infls {
  gap: 16rpx;
  flex-wrap: wrap;
}
.vn-infl {
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-md);
  box-shadow: var(--e1);
  padding: 12rpx 24rpx;
  flex-shrink: 0;
}
.vn-infl-label {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 0.05em;
  margin-bottom: 4rpx;
}
.vn-infl-value {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-primary);
}

/* 词源与记忆（前缀 warning / 词根 error / 后缀 success chips） */
.vn-ety {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 32rpx;
  gap: 24rpx;
}
.vn-ety-chips {
  gap: 16rpx;
  flex-wrap: wrap;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(227, 221, 207, 0.5);
}
.vn-ety-chip {
  padding: 10rpx 20rpx;
  border-radius: var(--r-md);
  font-size: 22rpx;
  font-weight: 500;
  flex-shrink: 0;
}
.vn-ety-chip--prefix {
  background: rgba(217, 138, 23, 0.1);
  color: #92400e;
  border: 1rpx solid rgba(217, 138, 23, 0.2);
}
.vn-ety-chip--root {
  background: rgba(210, 80, 63, 0.1);
  color: var(--error-600);
  border: 1rpx solid rgba(210, 80, 63, 0.2);
}
.vn-ety-chip--suffix {
  background: rgba(46, 143, 111, 0.1);
  color: var(--color-success);
  border: 1rpx solid rgba(46, 143, 111, 0.2);
}
.vn-ety-label {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--color-warning);
  letter-spacing: 0.1em;
  margin-bottom: 8rpx;
}
.vn-ety-label--dim {
  color: var(--text-tertiary);
}
.vn-ety-memo {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink-800);
  line-height: 1.7;
}
.vn-ety-break-wrap {
  padding-top: 16rpx;
}
.vn-ety-break {
  font-size: 22rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
}

/* 短语搭配 */
.vn-phrases {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  overflow: hidden;
}
.vn-phrase {
  padding: 20rpx 28rpx;
  border-bottom: 1rpx solid rgba(227, 221, 207, 0.4);
  gap: 24rpx;
}
.vn-phrase:last-child {
  border-bottom: none;
}
.vn-phrase-en {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.vn-phrase-cn {
  font-size: 24rpx;
  color: var(--text-tertiary);
  text-align: right;
}

/* 扩展词汇（同义/反义） */
.vn-syn-wrap {
  gap: 20rpx;
}
.vn-ext {
  background: rgba(255, 255, 255, 0.8);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 24rpx;
  gap: 20rpx;
  align-items: flex-start;
  flex-wrap: wrap;
}
.vn-ext-tag {
  font-size: 18rpx;
  font-weight: 700;
  border-radius: var(--r-md);
  padding: 8rpx 18rpx;
  letter-spacing: 0.06em;
  flex-shrink: 0;
}
.vn-ext-tag--syn {
  background: rgba(46, 143, 111, 0.1);
  color: var(--color-success);
}
.vn-ext-tag--ant {
  background: rgba(210, 80, 63, 0.1);
  color: var(--error-500);
}
.vn-ext-words {
  flex: 1;
  min-width: 0;
  gap: 12rpx;
  flex-wrap: wrap;
}
.vn-ext-word {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

/* 降级视图（无 dictData） */
.vn-fallback-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 0.08em;
  margin-bottom: 20rpx;
}
.vn-fallback-card {
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 32rpx;
}
.vn-fallback-play {
  justify-content: flex-end;
  margin-top: 20rpx;
}
.vn-fallback-trans {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}
.vn-fallback-src {
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-md);
  box-shadow: var(--e1);
  padding: 20rpx 24rpx;
  gap: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
}
.vn-fallback-time {
  display: block;
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-top: 12rpx;
}

/* 底部操作区 */
.vn-actions {
  gap: 16rpx;
  flex-wrap: wrap;
  border-top: 1rpx solid rgba(227, 221, 207, 0.5);
  margin-top: 40rpx;
  padding-top: 28rpx;
}
.vn-actions-left {
  gap: 20rpx;
  flex-wrap: wrap;
}
.vn-action {
  gap: 12rpx;
  padding: 18rpx 36rpx;
  border-radius: var(--r-xl);
  font-size: 26rpx;
  font-weight: 700;
}
.vn-action-ic {
  width: 30rpx;
  height: 30rpx;
}
/* 标记已掌握：success→emerald 渐变白字（Web gradient from-success to-emerald-500） */
.vn-action--master {
  background: linear-gradient(to right, #2e8f6f, #10b981);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(46, 143, 111, 0.2);
}
/* 重新学习：ink-100 灰 */
.vn-action--relearn {
  background: var(--ink-100);
  color: var(--text-secondary);
}
/* 彻底删除：red-50 底 red-600 字 */
.vn-action--del {
  background: #fef2f2;
  color: #dc2626;
}
/* 查看网络词典：白底描边 */
.vn-action--dict {
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  box-shadow: var(--e1);
  color: var(--text-secondary);
  font-weight: 700;
}

/* 筛选/搜索无结果 */
.vn-nomatch {
  align-items: center;
  background: rgba(255, 255, 255, 0.4);
  border: 2rpx dashed var(--color-base-200);
  border-radius: var(--r-xl);
  padding: 120rpx 48rpx;
}
.vn-nomatch-ic {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--ink-100);
  margin-bottom: 28rpx;
}
.vn-nomatch-img {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.4;
}
.vn-nomatch-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-tertiary);
}
.vn-nomatch-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  opacity: 0.6;
  margin-top: 14rpx;
  text-align: center;
}
