/**
 * components/review/vocab-notebook/index.wxss — 生词本根视图样式
 * 逐项映射 Web app/(main)/library/vocabulary 的 Tailwind 类（移动端 <xl 形态）：
 * 统计三格 grid-cols-3、primary-600 复习横幅、ink-50 搜索框、
 * 紧凑卡 rounded-2xl shadow、熟练度渐变竖条、展开面板 ring-primary-600/30、
 * US(primary)/UK(secondary) 音标胶囊、原声出处 primary-50 渐变卡、
 * 前缀 warning/词根 error/后缀 success 词源 chips、底部操作渐变绿按钮。
 */

.vn-scroll {
  height: 100%;
}
.vn-page {
  /* ===== 双色令牌（值 = Android ReviewBanner / VocabularyControls isDark 分支） ===== */
  --vnb-bg: #1f7a5c;          /* 横幅底：Primary600 → Primary900 45%（深墨绿） */
  --vnb-btn-text: #1f7a5c;    /* 白色「开始复习」钮文字/图标：Primary600 → Primary400 */
  --vnt-container: #f1ede4;   /* 分段容器：Ink100 → Ink800 */
  --vnt-learn-bg: #edf7f2;    /* 学习中激活底：Primary50 → Primary900 */
  --vnt-learn-text: #1f7a5c;  /* 学习中激活字：Primary600 → Primary400 */
  --vnt-off-text: #57534e;    /* 未激活字：onSurfaceVariant → #A8A29E */

  padding: 24rpx 32rpx 0;
}

@media (prefers-color-scheme: dark) {
  .vn-page {
    --vnb-bg: rgba(15, 54, 40, 0.45);
    --vnb-btn-text: #4da989;
    --vnt-container: #26221c;
    --vnt-learn-bg: #0f3628;
    --vnt-learn-text: #4da989;
    --vnt-off-text: #a8a29e;
  }
}
.theme-dark {
  --vnb-bg: rgba(15, 54, 40, 0.45);
  --vnb-btn-text: #4da989;
  --vnt-container: #26221c;
  --vnt-learn-bg: #0f3628;
  --vnt-learn-text: #4da989;
  --vnt-off-text: #a8a29e;
}
.theme-light {
  --vnb-bg: #1f7a5c;
  --vnb-btn-text: #1f7a5c;
  --vnt-container: #f1ede4;
  --vnt-learn-bg: #edf7f2;
  --vnt-learn-text: #1f7a5c;
  --vnt-off-text: #57534e;
}
.vn-bottom-space {
  /* 底部让位：跨页迷你播放条（elevated 2rpx）+ 安全区 */
  height: calc(var(--mini-player-height) + env(safe-area-inset-bottom) + 24rpx);
}

/* ── 首次加载 ── */
.vn-firstload {
  align-items: center;
  padding: 200rpx 0;
  gap: 24rpx;
}
.vn-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(31, 122, 92, 0.2);
  border-top-color: var(--primary-600);
  border-radius: 50%;
  animation: vn-rotate 0.8s linear infinite;
}
.vn-mini-spin {
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid rgba(31, 122, 92, 0.2);
  border-top-color: var(--primary-600);
  border-radius: 50%;
  animation: vn-rotate 0.8s linear infinite;
}
@keyframes vn-rotate {
  to {
    transform: rotate(360deg);
  }
}

/* ── 统计三格（bg-white px-2 py-3 rounded-lg 三列网格） ── */
.vn-stats {
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.vn-stat {
  flex: 1;
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--r-md);
  padding: 20rpx 16rpx;
}
.vn-stat-ic {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--r-md);
  background: var(--color-base-200);
  margin-bottom: 8rpx;
}
.vn-stat-ic--due {
  background: rgba(217, 138, 23, 0.1); /* warning/10 */
}
.vn-stat-ic--done {
  background: rgba(46, 143, 111, 0.1); /* success/10 */
}
.vn-stat-img {
  width: 32rpx;
  height: 32rpx;
}
.vn-stat-label {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  letter-spacing: 0.05em;
}
.vn-stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.2;
}

/* ── 复习横幅（bg-primary-600 白字） ── */
.vn-banner {
  background: var(--vnb-bg); /* Primary600 → Primary900/45（深墨绿，Android 12dp 圆角） */
  border-radius: 24rpx;
  padding: 40rpx; /* 20dp */
  margin-bottom: 24rpx;
}
.vn-banner-head {
  gap: 20rpx;
  margin-bottom: 14rpx;
}
.vn-banner-ic {
  width: 44rpx;
  height: 44rpx;
}
.vn-banner-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}
.vn-banner-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85); /* Android white 85% */
  line-height: 1.6;
}
.vn-banner-strong {
  color: #ffffff;
  font-weight: 700;
}
.vn-banner-btn {
  margin-top: 28rpx; /* 14dp */
  background: #ffffff;
  color: var(--vnb-btn-text); /* Primary600 → Primary400 */
  border-radius: 20rpx; /* 10dp */
  padding: 20rpx 44rpx; /* h22 v10 dp */
  font-size: 28rpx;
  font-weight: 700;
  align-self: flex-start;
  gap: 12rpx;
  display: flex;
}
.vn-banner-btn-ic {
  width: 36rpx;
  height: 36rpx;
}

/* ── 全部完成卡 ── */
.vn-allclear {
  align-items: center;
  background: var(--card-bg);
  border-radius: var(--r-md);
  padding: 44rpx;
  margin-bottom: 24rpx;
}
.vn-allclear-ic {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 16rpx;
}
.vn-allclear-title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text-primary);
}
.vn-allclear-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  margin-top: 8rpx;
  text-align: center;
}

/* ── 全局空态 ── */
.vn-empty {
  align-items: center;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: var(--r-xl);
  padding: 96rpx 48rpx;
}
.vn-empty-ic {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: var(--color-base-300);
  margin-bottom: 32rpx;
}
.vn-empty-img {
  width: 56rpx;
  height: 56rpx;
}
.vn-empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
}
.vn-empty-desc {
  font-size: 26rpx;
  color: var(--text-tertiary);
  line-height: 1.7;
  text-align: center;
  margin-top: 8rpx;
}
.vn-empty-btn {
  margin-top: 40rpx;
  background: var(--primary-600);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 500;
  border-radius: var(--r-md);
  padding: 16rpx 40rpx;
}

/* ── 筛选栏 ── */
.vn-controls {
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}
/* ── 状态分段 Tab（Segmented Control，对齐 Android：容器 12dp 圆角 Ink100/Ink800
   + 4dp 内衬 + 4dp 间距；两钮 flex-1、9dp 内圆角、labelMedium Bold） ── */
.vn-tabs {
  gap: 8rpx; /* 4dp */
  background: var(--vnt-container);
  border-radius: 24rpx; /* 12dp */
  padding: 8rpx; /* 4dp */
}
.vn-tab {
  flex: 1;
  padding: 16rpx 0; /* 8dp */
  font-size: 26rpx; /* labelMedium */
  font-weight: 700;
  text-align: center;
  border-radius: 18rpx; /* 9dp */
  color: var(--vnt-off-text);
}
.vn-tab--learn-on {
  background: var(--vnt-learn-bg); /* Primary50 → Primary900 */
  color: var(--vnt-learn-text);    /* Primary600 → Primary400 */
}
.vn-tab--done-on {
  background: rgba(46, 143, 111, 0.12); /* Primary500/12%（双模式同值） */
  color: #2e8f6f;                         /* Primary500 */
}
.vn-search {
  background: var(--color-base-200);
  border-radius: var(--r-md);
  padding: 14rpx 20rpx;
  gap: 16rpx;
}
.vn-search-ic {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
.vn-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--text-primary);
}
.vn-search-ph {
  color: var(--text-tertiary);
}
.vn-search-clear {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.vn-search-clear-ic {
  width: 28rpx;
  height: 28rpx;
}
.vn-sorts {
  gap: 16rpx;
  margin-top: 20rpx;
}
.vn-sort {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: var(--r-md);
  color: var(--text-tertiary);
}
.vn-sort--on {
  background: var(--primary-600);
  color: #ffffff;
  box-shadow: var(--e1);
}

/* ── 卡片列表 ── */
.vn-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.vn-card {
  background: var(--card-bg);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  overflow: hidden;
}
.vn-card--open {
  box-shadow: var(--e2);
  border: 1rpx solid rgba(31, 122, 92, 0.3); /* ring-primary-600/30 */
}

/* ── 紧凑面 ── */
.vn-compact {
  padding: 28rpx 32rpx;
}
.vn-word-row {
  justify-content: space-between;
  gap: 16rpx;
}
.vn-word-wrap {
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}
.vn-word {
  font-size: 44rpx; /* titleLarge 22sp（对齐 Android） */
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.01em;
  max-width: 440rpx;
}
/* 紧凑面音标胶囊预览（Ink50/Ink800 底 = base-200 令牌，labelSmall 70%） */
.vn-phon-preview {
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--text-secondary);
  background: var(--color-base-200);
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}
.vn-dot {
  width: 16rpx; /* 8dp */
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-base-300);
  flex-shrink: 0;
}
/* 已掌握：primary 35%（Android mastered 分支） */
.vn-dot--done {
  background: var(--color-primary);
  opacity: 0.35;
}
.vn-dot--due {
  background: var(--color-warning);
  box-shadow: 0 0 0 6rpx rgba(217, 138, 23, 0.18);
  animation: vn-pulse 2s ease-in-out infinite;
}
@keyframes vn-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}
.vn-play {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.vn-play-ic {
  width: 40rpx;
  height: 40rpx;
}
.vn-def {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  margin-top: 6rpx;
}
/* 原声引文（onSurfaceVariant 60%，单行省略，带引号） */
.vn-quote {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}
.vn-meta {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--card-fade-line);
}
/* 熟练度 5 格竖条：level<=proficiency 渐变亮起（高度随档位递增） */
.vn-profs {
  gap: 8rpx;
  align-items: flex-end;
}
.vn-prof {
  width: 10rpx;
  border-radius: var(--r-full);
  background: var(--color-base-300);
  transition: all 0.5s;
}
.vn-prof--h1 { height: 16rpx; }
.vn-prof--h2 { height: 20rpx; }
.vn-prof--h3 { height: 24rpx; }
.vn-prof--h4 { height: 28rpx; }
.vn-prof--h5 { height: 32rpx; }
.vn-prof--on {
  background: linear-gradient(to top, var(--primary-600), var(--primary-400));
  box-shadow: 0 2rpx 6rpx rgba(31, 122, 92, 0.2);
}
.vn-meta-right {
  gap: 16rpx;
  flex-shrink: 0;
}
.vn-badge-ic {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
}
.vn-badge-done {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-success);
}
.vn-badge-due {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-warning);
  animation: vn-pulse 2s ease-in-out infinite;
}
.vn-badge-date {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-secondary);
}
.vn-chev {
  width: 36rpx;
  height: 36rpx;
}

/* ── 展开面板 ── */
.vn-panel {
  display: flex;
  flex-direction: column;
  gap: 28rpx; /* Android spacedBy(14dp) */
  border-top: 1rpx solid var(--card-fade-line);
  background: linear-gradient(to bottom, transparent, var(--card-fade));
  padding: 32rpx;
  animation: vn-panel-in 0.3s ease;
}
@keyframes vn-panel-in {
  from {
    opacity: 0;
    transform: translateY(-12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 音标胶囊（US primary / UK secondary） */
.vn-phons {
  gap: 24rpx;
  flex-wrap: wrap;
}
.vn-phon-pill {
  gap: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--color-base-200);
  border-radius: var(--r-xl);
  box-shadow: var(--e1);
  padding: 14rpx 28rpx;
}
.vn-phon-tag {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--primary-600);
  letter-spacing: 0.1em;
}
.vn-phon-tag--uk {
  color: var(--color-secondary);
}
.vn-phon-text {
  font-size: 26rpx;
  font-family: Menlo, Consolas, monospace;
  color: var(--text-secondary);
}
.vn-phon-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
}
.vn-phon-btn-ic {
  width: 32rpx;
  height: 32rpx;
}
.vn-phon-btn-ic--uk {
  width: 32rpx;
  height: 32rpx;
}

/* 区块标签（Android SectionLabel：labelSmall Bold letterSpacing 55%） */
.vn-sec-label {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--text-secondary);
  opacity: 0.6;
}

/* 核心释义卡（Ink50/70 → Ink800/50 = base-200 令牌；圆角 12dp；pos 胶囊 + 加粗中文 + 灰英文） */
.vn-defgroup {
  background: var(--color-base-200);
  border-radius: 24rpx;
  padding: 24rpx;
  gap: 20rpx;
}
.vn-defrow {
  align-items: flex-start;
  gap: 16rpx;
}
.vn-defrow-pos {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: rgba(31, 122, 92, 0.1);
  border-radius: 8rpx;
  padding: 4rpx 10rpx;
  margin-top: 2rpx;
}
.vn-defrow-main {
  flex: 1;
  min-width: 0;
  gap: 4rpx;
}
.vn-defrow-cn {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}
.vn-defrow-en {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* 原声出处卡（primary→accent 5% 渐变 + primary/20 描边 + 目标词高亮） */
.vn-ctx {
  background: linear-gradient(135deg, rgba(31, 122, 92, 0.05), rgba(217, 138, 23, 0.05));
  border: 2rpx solid rgba(31, 122, 92, 0.2);
  border-radius: 24rpx;
  padding: 24rpx;
  gap: 12rpx;
}
.vn-ctx-sentence {
  font-size: 28rpx;
  color: var(--text-primary);
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: break-word;
}
.vn-ctx-hl {
  font-weight: 700;
  color: var(--color-primary);
}
.vn-ctx-trans {
  font-size: 22rpx;
  color: var(--text-secondary);
}
.vn-ctx-from {
  font-size: 22rpx;
  color: var(--text-tertiary);
}
/* 降级：无词典且无原声时的中文行 */
.vn-fallback-trans {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

/* 词源记忆卡（Accent500 6~10% 底 + 灯泡头 + 卡底色词素 chips + 💡 记忆技巧） */
.vn-ety {
  background: rgba(217, 138, 23, 0.08);
  border-radius: 24rpx;
  padding: 24rpx;
  gap: 16rpx;
}
.vn-ety-head {
  gap: 10rpx;
}
.vn-ety-ic {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}
.vn-ety-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
}
.vn-ety-chip {
  background: var(--card-bg);
  color: var(--text-secondary);
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 6rpx 16rpx;
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: break-word;
}
.vn-ety-memo {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* 底部操作栏：掌握主按钮 flex:1（Primary500 / 已掌握态 base-300）+ 彻底删除常显（error/8 底） */
.vn-actions {
  gap: 20rpx;
}
.vn-action {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 20rpx;
  padding: 20rpx 0;
  font-size: 26rpx;
  font-weight: 700;
}
.vn-action-ic {
  width: 32rpx;
  height: 32rpx;
}
.vn-action--master {
  flex: 1;
  background: var(--color-primary);
  color: var(--color-primary-content);
}
.vn-action--relearn {
  flex: 1;
  background: var(--color-base-300);
  color: var(--text-primary);
}
.vn-action--del {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  background: rgba(210, 80, 63, 0.08);
  color: var(--color-error);
}

/* 筛选/搜索无结果 */
.vn-nomatch {
  align-items: center;
  background: var(--card-bg);
  border: 2rpx dashed var(--color-base-200);
  border-radius: var(--r-xl);
  padding: 120rpx 48rpx;
}
.vn-nomatch-ic {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-base-300);
  margin-bottom: 28rpx;
}
.vn-nomatch-img {
  width: 60rpx;
  height: 60rpx;
  opacity: 0.4;
}
.vn-nomatch-title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-tertiary);
}
.vn-nomatch-desc {
  font-size: 24rpx;
  color: var(--text-tertiary);
  opacity: 0.6;
  margin-top: 14rpx;
  text-align: center;
}
