/* 发音弱项本根视图：画像卡（T4.2）+ 后续模块占位/错误重试 */
.notebook-scroll {
  height: 100%;
}
.notebook-pad {
  padding: var(--page-padding);
  /* 底部大间距（用户拍板的终态口径，勿改回小间距）：迷你播放条 + 安全区 +
     24rpx 呼吸位，vocab-notebook 占位视图同款；曾短暂改 24rpx（=卡片间距）
     被要求恢复本版 */
  padding-bottom: calc(var(--mini-player-height) + env(safe-area-inset-bottom) + 24rpx);
  /* 卡片间距：Android PronunciationNotebookRoute 外层 Column spacedBy(12.dp) */
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.notebook-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}
.np-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--r-full);
  background: var(--primary-50);
  margin-bottom: 24rpx;
}
.np-icon {
  width: 56rpx;
  height: 56rpx;
}
.np-title {
  color: var(--text-primary);
}
.np-desc {
  color: var(--text-secondary);
  margin-top: 12rpx;
  text-align: center;
}
.np-phase {
  margin-top: 32rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--r-full);
  background: var(--ink-100);
  color: var(--text-tertiary);
  font-size: 22rpx;
}
/* 错误态重试按钮（失败首败态专属；对齐全局主按钮口径） */
.np-retry-btn {
  margin-top: 32rpx;
  padding: 16rpx 64rpx;
  border-radius: var(--r-full);
  background: var(--color-primary);
  color: var(--color-primary-content);
  font-size: 28rpx;
  font-weight: 600;
}
.np-retry-hover {
  opacity: 0.85;
}
