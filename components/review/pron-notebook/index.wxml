<!-- 发音弱项本根视图：画像卡（T4.2）+ 诊断报告（T4.3）+ 弱项列表（T4.4）全量落地；
     闯关页/排行榜页（T4.5）为独立页面，经 pron-list 横幅与达人榜入口进入 -->
<scroll-view class="notebook-scroll {{themeClass}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="notebook-pad">

    <block wx:if="{{notebook}}">
      <speech-profile-card profile="{{notebook.profile}}" radar="{{radar}}" popup-open="{{popupOpen}}" bind:hintopen="onCefrHint" />
      <diagnostic-report-card stats="{{notebook.phonemeStats}}" is-premium="{{notebook.isPremium}}" popup-open="{{popupOpen}}" />
      <pron-list notebook="{{notebook}}" popup-open="{{popupOpen}}" />
    </block>

    <view wx:elif="{{loadError}}" class="card notebook-placeholder">
      <view class="np-badge center">
        <image class="np-icon" src="{{failed.icon}}" mode="aspectFit" />
      </view>
      <text class="np-title t-h3">{{failed.title}}</text>
      <text class="np-desc t-caption">{{failed.desc}}</text>
      <view class="np-retry-btn" hover-class="np-retry-hover" bindtap="retry">重试</view>
    </view>

    <view wx:else class="card notebook-placeholder">
      <view class="np-badge center">
        <image class="np-icon" src="{{placeholder.icon}}" mode="aspectFit" />
      </view>
      <text class="np-title t-h3">{{placeholder.title}}</text>
      <text class="np-desc t-caption">{{placeholder.desc}}</text>
      <view class="np-phase">{{placeholder.phase}}</view>
    </view>

  </view>
</scroll-view>
