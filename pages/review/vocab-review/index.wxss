/**
 * pages/review/vocab-review/index.wxss — 生词复习·闪卡模式样式
 * 逐项映射 Android VocabularyReviewScreen.kt 的 Compose 规格（对齐三张截图）：
 * - 顶部：4dp 渐变进度条（Primary500→Accent500）+ 大脑图标/计数/「闪卡」灰底胶囊/圆形关闭
 * - 正面：displaySmall ExtraBold primary 大词 + 44dp primary/10 圆底发音钮 +
 *   onSurfaceVariant 45% 提示 + 35% 「来自《…》」
 * - 背面：headlineMedium 词 + US(primary)/UK(Accent500) 音标行、Ink100/50 释义卡
 *   （primary/10 词性胶囊）、primary→accent 6% 渐变原声卡（1dp primary/20 描边、
 *   目标词 primary 加粗）、Accent500/7% 词源卡（白底词素 chips + 💡）
 * - 3D 翻转：perspective 1200px + rotateY 180° + 0.6s cubic-bezier(0.4,0,0.2,1)
 *   （= Material FastOutSlowInEasing）+ -webkit- backface-visibility
 * - 底部：Ink50/60 底；未翻面 primary 大按钮；翻面后 2×2 白底描边 FSRS 钮
 *   （图标色 忘记#D2503F / 模糊#D98A17 / 认识#2E8F6F / 简单#4A7FA5）
 * - 总结页：GoodColor/10 圆底奖杯 + 2×2 四档统计 + 逐词行 + 再来一轮/完成
 */

.vr-page {
  /* ===== 双色令牌（值逐项 = Android VocabularyReviewScreen.kt isDark 分支） =====
     onSurface #1C1917/#E8E3D9、onSurfaceVariant #57534E/#A8A29E 按精确 alpha 阶梯 */
  --vr-strong: rgba(28, 25, 23, 0.8);       /* 计数/SRS 主文案（onSurface 80%） */
  --vr-sub70: rgba(87, 83, 78, 0.7);        /* 释义英文/出处中文（variant 70%） */
  --vr-mid: rgba(87, 83, 78, 0.6);          /* 闪卡胶囊字/SRS 区间（variant 60%） */
  --vr-sub55: rgba(87, 83, 78, 0.55);       /* 区块 label/出处来自（variant 55%） */
  --vr-sub45: rgba(87, 83, 78, 0.45);       /* 正面提示（variant 45%） */
  --vr-sub35: rgba(87, 83, 78, 0.35);       /* 正面来自（variant 35%） */
  --vr-ink: #322d23;                        /* 释义中文/原句正文（contentColor） */
  --vr-ink-soft: #57534e;                   /* 音标文本（variant solid） */
  --vr-surface: #f1ede4;                    /* 进度轨道/胶囊底/分割线（Ink100→Ink800） */
  --vr-primary: #1f7a5c;                    /* 词/音标标签/高亮（Primary600→400） */
  --vr-primary-soft: rgba(31, 122, 92, 0.1);/* 发音圆底/词性胶囊（primary 10%） */
  --vr-panel: rgba(241, 237, 228, 0.5);     /* 释义卡/逐词行（Ink100/50→Ink800/50） */
  --vr-panel-60: rgba(241, 237, 228, 0.5);  /* 逐词结果行（Android 同 50%） */
  --vr-ctx-hi: rgba(31, 122, 92, 0.06);     /* 出处渐变主色端（primary/6） */
  --vr-ctx-line: rgba(31, 122, 92, 0.2);    /* 出处描边（primary/20） */
  --vr-ety-bg: rgba(217, 138, 23, 0.07);    /* 词源卡（accent 7%→12%） */
  --vr-ety-chip: #ffffff;                   /* 词素 chips 底（白→Ink800） */
  --vr-ety-text: #655d4c;                   /* 词素 chips 字（Ink600→Ink400） */
  --vr-footer: rgba(250, 248, 243, 0.6);    /* 底部操作区（Ink50/60→Ink800/35） */
  --vr-srs-line: #f1ede4;                   /* SRS 描边（Ink100→白 8%） */
  --vr-cta: #1f7a5c;                        /* 显示答案/再来一轮（Primary600→500） */

  height: 100vh;
  background: var(--card-bg); /* 整屏 surface（白→#1E1B16，Android colorScheme.surface） */
}

/* ===== 深色·跟随系统（媒体查询） ===== */
@media (prefers-color-scheme: dark) {
  .vr-page {
    --vr-strong: rgba(232, 227, 217, 0.8);
    --vr-sub70: rgba(168, 162, 158, 0.7);
    --vr-mid: rgba(168, 162, 158, 0.6);
    --vr-sub55: rgba(168, 162, 158, 0.55);
    --vr-sub45: rgba(168, 162, 158, 0.45);
    --vr-sub35: rgba(168, 162, 158, 0.35);
    --vr-ink: #e8e3d9;
    --vr-ink-soft: #a8a29e;
    --vr-surface: #26221c;
    --vr-primary: #4da989;
    --vr-primary-soft: rgba(77, 169, 137, 0.1);
    --vr-panel: rgba(38, 34, 28, 0.5);
    --vr-panel-60: rgba(38, 34, 28, 0.5);
    --vr-ctx-hi: rgba(77, 169, 137, 0.06);
    --vr-ctx-line: rgba(77, 169, 137, 0.2);
    --vr-ety-bg: rgba(217, 138, 23, 0.12);
    --vr-ety-chip: #26221c;
    --vr-ety-text: #a79e8a;
    --vr-footer: rgba(38, 34, 28, 0.35);
    --vr-srs-line: rgba(255, 255, 255, 0.08);
    --vr-cta: #2e8f6f;
  }
}

/* ===== 深色·手动（utils/theme 根类，同媒体查询值） ===== */
.theme-dark {
  --vr-strong: rgba(232, 227, 217, 0.8);
  --vr-sub70: rgba(168, 162, 158, 0.7);
  --vr-mid: rgba(168, 162, 158, 0.6);
  --vr-sub55: rgba(168, 162, 158, 0.55);
  --vr-sub45: rgba(168, 162, 158, 0.45);
  --vr-sub35: rgba(168, 162, 158, 0.35);
  --vr-ink: #e8e3d9;
  --vr-ink-soft: #a8a29e;
  --vr-surface: #26221c;
  --vr-primary: #4da989;
  --vr-primary-soft: rgba(77, 169, 137, 0.1);
  --vr-panel: rgba(38, 34, 28, 0.5);
  --vr-panel-60: rgba(38, 34, 28, 0.5);
  --vr-ctx-hi: rgba(77, 169, 137, 0.06);
  --vr-ctx-line: rgba(77, 169, 137, 0.2);
  --vr-ety-bg: rgba(217, 138, 23, 0.12);
  --vr-ety-chip: #26221c;
  --vr-ety-text: #a79e8a;
  --vr-footer: rgba(38, 34, 28, 0.35);
  --vr-srs-line: rgba(255, 255, 255, 0.08);
  --vr-cta: #2e8f6f;
}

/* ===== 手动浅色：系统深色下强制回归（Android 浅色值） ===== */
.theme-light {
  --vr-strong: rgba(28, 25, 23, 0.8);
  --vr-sub70: rgba(87, 83, 78, 0.7);
  --vr-mid: rgba(87, 83, 78, 0.6);
  --vr-sub55: rgba(87, 83, 78, 0.55);
  --vr-sub45: rgba(87, 83, 78, 0.45);
  --vr-sub35: rgba(87, 83, 78, 0.35);
  --vr-ink: #322d23;
  --vr-ink-soft: #57534e;
  --vr-surface: #f1ede4;
  --vr-primary: #1f7a5c;
  --vr-primary-soft: rgba(31, 122, 92, 0.1);
  --vr-panel: rgba(241, 237, 228, 0.5);
  --vr-panel-60: rgba(241, 237, 228, 0.5);
  --vr-ctx-hi: rgba(31, 122, 92, 0.06);
  --vr-ctx-line: rgba(31, 122, 92, 0.2);
  --vr-ety-bg: rgba(217, 138, 23, 0.07);
  --vr-ety-chip: #ffffff;
  --vr-ety-text: #655d4c;
  --vr-footer: rgba(250, 248, 243, 0.6);
  --vr-srs-line: #f1ede4;
  --vr-cta: #1f7a5c;
}


/* ── 顶部进度头 ── */
.vr-header {
  flex-shrink: 0;
  background: var(--card-bg);
}
.vr-progress-track {
  height: 6rpx; /* 4dp */
  background: var(--vr-surface);
}
.vr-progress-bar {
  height: 100%;
  background: linear-gradient(to right, var(--primary-500), var(--accent-500));
  transition: width 0.4s ease-out;
}
.vr-header-row {
  padding: 20rpx 32rpx;
  gap: 12rpx;
}
.vr-header-brain {
  width: 32rpx; /* 16dp */
  height: 32rpx;
}
.vr-header-count {
  font-size: 26rpx; /* labelMedium 12sp */
  font-weight: 700;
  color: var(--vr-strong);
}
.vr-header-tag {
  margin-left: 8rpx;
  background: var(--vr-surface);
  color: var(--vr-mid);
  font-size: 24rpx; /* labelSmall 11sp */
  border-radius: var(--r-full);
  padding: 4rpx 16rpx;
}
.vr-header-spacer {
  flex: 1;
}
.vr-close {
  width: 64rpx; /* 32dp */
  height: 64rpx;
  border-radius: 50%;
}
.vr-close-ic {
  width: 36rpx; /* 18dp */
  height: 36rpx;
}
.vr-divider {
  height: 1rpx;
  background: var(--vr-surface);
  flex-shrink: 0;
}

/* ── 加载 ── */
.vr-loading {
  flex: 1;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.vr-spin {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--vr-primary-soft);
  border-top-color: var(--vr-primary);
  border-radius: 50%;
  animation: vr-rotate 0.8s linear infinite;
}
@keyframes vr-rotate {
  to {
    transform: rotate(360deg);
  }
}

/* ── 闪卡舞台（横滑跟手 + 3D 翻转） ── */
.vr-body {
  flex: 1;
  min-height: 0;
}
.vr-stage {
  flex: 1;
  min-height: 0;
  perspective: 1200px;
  transition: transform 0.15s ease-out;
}
.vr-flip {
  position: relative;
  width: 100%;
  height: 100%;
  transform-style: preserve-3d;
  transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}
.vr-flip--back {
  transform: rotateY(180deg);
}
.vr-face {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: transparent;
  -webkit-backface-visibility: hidden;
  backface-visibility: hidden;
  overflow: hidden;
}
.vr-back {
  transform: rotateY(180deg);
}

/* ── 正面 ── */
.vr-front {
  height: 100%;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}
.vr-front-word {
  font-size: 90rpx; /* displaySmall 36sp（正面主词） */
  font-weight: 800; /* ExtraBold */
  color: var(--vr-primary);
  text-align: center;
  line-height: 1.15;
  word-break: break-word;
  overflow-wrap: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.vr-front-play {
  width: 88rpx; /* 44dp */
  height: 88rpx;
  margin-top: 40rpx; /* 20dp */
  border-radius: 50%;
  background: var(--vr-primary-soft);
}
.vr-front-play-ic {
  width: 44rpx; /* 22dp */
  height: 44rpx;
}
.vr-front-hint {
  margin-top: 56rpx; /* 28dp */
  font-size: 28rpx; /* labelMedium 12sp（正文可读级） */
  color: var(--vr-sub45);
}
.vr-front-from {
  margin-top: 12rpx; /* 6dp */
  max-width: 560rpx;
  font-size: 24rpx; /* labelSmall 11sp */
  color: var(--vr-sub35);
}

/* ── 背面 ── */
.vr-back-scroll {
  height: 100%;
}
.vr-back-inner {
  padding: 32rpx 40rpx 48rpx;
  align-items: center;
  gap: 0;
}
.vr-back-word {
  font-size: 70rpx; /* headlineMedium 28sp（背面主词） */
  line-height: 1.2;
  font-weight: 700;
  color: var(--vr-primary);
  text-align: center;
  word-break: break-word;
}

/* US/UK 音标行 */
.vr-back-phons {
  margin-top: 20rpx; /* 10dp */
  gap: 48rpx; /* 12dp×4 */
}
.vr-phon {
  gap: 8rpx;
}
.vr-phon-tag {
  font-size: 24rpx; /* labelSmall 11sp（US/UK 标签） */
  font-weight: 900; /* Black */
  color: var(--vr-primary);
}
.vr-phon-tag--uk {
  color: var(--accent-500);
}
.vr-phon-text {
  font-size: 28rpx; /* labelMedium 12sp（音标，正文可读级） */
  color: var(--vr-ink-soft);
}
.vr-phon-play {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}
.vr-phon-play-ic {
  width: 32rpx; /* 16dp */
  height: 32rpx;
}

/* 区块 label（labelSmall Bold letterSpacing 2sp 55%） */
.vr-sec-label {
  align-self: flex-start;
  font-size: 24rpx; /* labelSmall 11sp（区块标签） */
  font-weight: 700;
  letter-spacing: 0.18em;
  color: var(--vr-sub55);
  margin-bottom: 12rpx;
}

/* 释义卡（Ink100/50 底圆角 12dp padding 14dp） */
.vr-defs {
  width: 100%;
  margin-top: 32rpx; /* 16dp */
  background: var(--vr-panel);
  border-radius: var(--r-lg);
  padding: 28rpx;
  gap: 20rpx; /* 10dp */
}
.vr-def {
  align-items: flex-start;
  gap: 16rpx; /* 8dp */
}
.vr-def-pos {
  flex-shrink: 0;
  background: rgba(31, 122, 92, 0.1);
  color: var(--vr-primary);
  font-size: 24rpx; /* labelSmall 11sp（词性胶囊） */
  font-weight: 700;
  border-radius: 8rpx; /* 4dp */
  padding: 4rpx 12rpx;
  margin-top: 4rpx;
}
.vr-def-main {
  flex: 1;
  min-width: 0;
  gap: 4rpx;
}
.vr-def-cn {
  font-size: 32rpx; /* bodyMedium 14sp（释义中文） */
  color: var(--vr-ink);
  line-height: 1.5;
}
.vr-def-en {
  font-size: 24rpx; /* labelSmall 11sp（释义英文） */
  color: var(--vr-sub70);
  font-style: italic;
  line-height: 1.5;
}
.vr-def-fallback {
  margin-top: 24rpx;
  font-size: 32rpx; /* bodyMedium 14sp */
  color: var(--vr-ink);
  text-align: center;
}

/* 原声出处卡（primary→accent 6% 渐变 + 1dp primary/20 描边） */
.vr-ctx {
  width: 100%;
  margin-top: 24rpx; /* 12dp */
  background: linear-gradient(135deg, var(--vr-ctx-hi), rgba(217, 138, 23, 0.06));
  border: 2rpx solid var(--vr-ctx-line);
  border-radius: var(--r-lg);
  padding: 28rpx;
}
.vr-ctx-sentence {
  font-size: 28rpx; /* bodySmall 12sp（原声例句） */
  color: var(--vr-ink);
  line-height: 1.7;
  word-break: break-word;
  overflow-wrap: break-word;
}
.vr-ctx-hl {
  color: var(--vr-primary);
  font-weight: 700;
}
.vr-ctx-trans {
  margin-top: 8rpx; /* 4dp */
  font-size: 24rpx; /* labelSmall 11sp（中文翻译） */
  color: var(--vr-sub70);
}
.vr-ctx-from {
  margin-top: 12rpx; /* 6dp */
  font-size: 24rpx; /* labelSmall 11sp（来自剧集） */
  color: var(--vr-sub55);
}

/* 词源记忆卡（Accent500/7% 底，词素白底 chips） */
.vr-ety {
  width: 100%;
  margin-top: 24rpx;
  background: var(--vr-ety-bg);
  border-radius: var(--r-lg);
  padding: 28rpx;
  align-items: center;
}
.vr-ety .vr-sec-label {
  align-self: center;
}
.vr-ety-chips {
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx; /* 6dp */
}
.vr-ety-chip {
  background: var(--vr-ety-chip);
  color: var(--vr-ety-text);
  font-size: 24rpx; /* labelSmall 11sp（词素 chips） */
  font-weight: 700;
  border-radius: 12rpx; /* 6dp */
  padding: 8rpx 20rpx;
  line-height: 1.5;
  /* 超长词素在 chip 内自动换行（flex 子项 min-width:auto 默认会横向溢出） */
  min-width: 0;
  max-width: 100%;
  box-sizing: border-box;
  overflow-wrap: break-word;
  word-break: break-word;
}
.vr-ety-memo {
  margin-top: 12rpx;
  font-size: 24rpx; /* labelSmall 11sp（记忆法） */
  color: var(--vr-ink-soft);
  text-align: center;
  line-height: 1.6;
}

/* ── 底部（Ink50/60 底） ── */
.vr-footer {
  flex-shrink: 0;
  background: var(--vr-footer);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
.vr-show-answer {
  height: 96rpx;
  border-radius: var(--r-lg); /* 12dp */
  background: var(--vr-cta);
  color: #ffffff;
  font-size: 30rpx; /* titleSmall */
  font-weight: 700;
}
.vr-srs {
  gap: 16rpx; /* 8dp */
}
.vr-srs-row {
  gap: 16rpx;
}
.vr-srs-btn {
  flex: 1;
  background: var(--card-bg);
  border: 2rpx solid var(--vr-srs-line);
  border-radius: var(--r-lg);
  padding: 20rpx 0; /* 10dp */
  gap: 6rpx; /* 3dp */
  box-shadow: var(--e1);
}
.vr-srs-btn--off {
  opacity: 0.45;
}
.vr-srs-ic {
  width: 40rpx; /* 20dp */
  height: 40rpx;
}
.vr-srs-label {
  font-size: 26rpx; /* labelMedium 12sp（四档主文案） */
  font-weight: 700;
  color: var(--vr-strong);
}
.vr-srs-interval {
  font-size: 24rpx; /* labelSmall 11sp（间隔预演） */
  color: var(--vr-mid);
}

/* ── 总结页（复刻 Android ReviewSummary + 单词复习完成页面.jpg） ── */
.vr-summary {
  padding: 48rpx 48rpx 48rpx;
  align-items: stretch;
}
.vr-sum-trophy {
  width: 176rpx; /* 88dp */
  height: 176rpx;
  border-radius: 50%;
  background: rgba(46, 143, 111, 0.1); /* 浅绿圆底 */
  align-self: center;
  margin-top: 24rpx;
}
.vr-sum-trophy-ic {
  width: 88rpx; /* 44dp */
  height: 88rpx;
}
.vr-sum-title {
  margin-top: 32rpx; /* 16dp */
  align-self: center;
  font-size: 44rpx; /* headlineSmall */
  font-weight: 700;
  color: var(--text-primary);
}
.vr-sum-sub {
  margin-top: 12rpx; /* 6dp */
  align-self: center;
  font-size: 28rpx;
  color: var(--vr-ink-soft); /* 浅灰 */
}
.vr-sum-grid {
  margin-top: 48rpx; /* 24dp */
  gap: 24rpx; /* gap-3 */
}
.vr-sum-row {
  gap: 24rpx;
}
.vr-sum-cell {
  flex: 1;
  align-items: center; /* 数字与底部小字水平居中（.col 默认 stretch 会左对齐） */
  text-align: center;
  border-radius: var(--r-lg); /* 圆角卡片 */
  padding: 24rpx 0; /* 12dp */
  gap: 4rpx;
}
/* 四宫格底色（浅色 10% 主题底）+ 主数字主题色（截图口径） */
.vr-sum-cell--0 {
  background: rgba(210, 80, 63, 0.1);
}
.vr-sum-cell--0 .vr-sum-num {
  color: #d2503f;
}
.vr-sum-cell--1 {
  background: rgba(217, 138, 23, 0.1);
}
.vr-sum-cell--1 .vr-sum-num {
  color: var(--accent-500);
}
.vr-sum-cell--2 {
  background: rgba(46, 143, 111, 0.1);
}
.vr-sum-cell--2 .vr-sum-num {
  color: var(--primary-500);
}
.vr-sum-cell--3 {
  background: rgba(74, 127, 165, 0.1);
}
.vr-sum-cell--3 .vr-sum-num {
  color: var(--info-500);
}
.vr-sum-num {
  font-size: 40rpx; /* titleLarge */
  font-weight: 700;
}
/* 底部小字统一灰色（截图口径，非主题色） */
.vr-sum-label {
  font-size: 24rpx; /* labelSmall 11sp */
  font-weight: 700;
  color: var(--vr-mid); /* 兜底；四宫格内由下方状态色 70% 覆盖 */
}
/* StatCell label = 状态色 70%（Android 口径，红/黄/绿/蓝） */
.vr-sum-cell--0 .vr-sum-label { color: rgba(210, 80, 63, 0.7); }
.vr-sum-cell--1 .vr-sum-label { color: rgba(217, 138, 23, 0.7); }
.vr-sum-cell--2 .vr-sum-label { color: rgba(46, 143, 111, 0.7); }
.vr-sum-cell--3 .vr-sum-label { color: rgba(74, 127, 165, 0.7); }
.vr-result-list {
  margin-top: 40rpx; /* 20dp */
  gap: 12rpx; /* 6dp */
}
.vr-result {
  background: var(--vr-panel-60); /* 逐词结果行 */
  border-radius: 20rpx; /* 10dp */
  padding: 18rpx 24rpx;
}
.vr-result-word {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 400; /* 常规字重（截图口径） */
  color: var(--text-primary);
}
.vr-result-q {
  flex-shrink: 0;
  font-size: 24rpx; /* labelSmall 11sp */
  font-weight: 700;
}
/* 状态文本色与四宫格主题色严格对应 */
.vr-q--0 {
  color: #d2503f;
}
.vr-q--1 {
  color: var(--accent-500);
}
.vr-q--2 {
  color: var(--primary-500);
}
.vr-q--3 {
  color: var(--info-500);
}

/* 底部固定操作栏（总结态）：完成胶囊按钮 */
.vr-footer--summary {
  background: var(--card-bg);
  padding-top: 20rpx;
}
.vr-btn {
  height: 96rpx;
  border-radius: var(--r-full); /* 胶囊状（截图口径） */
  font-size: 30rpx;
  font-weight: 700;
}
.vr-footer--summary .vr-btn + .vr-btn {
  margin-top: 20rpx; /* 10dp */
}
.vr-btn--primary {
  background: var(--vr-cta);
  color: #ffffff;
}
/* 完成：浅灰/米色背景 + 深色文字（对齐 Android Ink100） */
.vr-btn--ghost {
  background: var(--vr-surface);
  color: var(--text-primary);
}
