<!-- pages/review/vocab-review — 生词复习·闪卡模式（复刻 Android VocabularyReviewScreen.kt + 三张截图） -->
<view class="vr-page col {{themeClass}}">

  <!-- ══ 顶部：极细渐变进度条 + 大脑图标/计数/闪卡标签/关闭 ══ -->
  <view class="vr-header">
    <view class="vr-progress-track">
      <view class="vr-progress-bar" style="width: {{showSummary ? 100 : progress}}%"></view>
    </view>
    <view class="vr-header-row row">
      <image class="vr-header-brain" src="{{dark ? '/assets/icons/psychology-dark.svg' : '/assets/icons/psychology-primary.svg'}}" />
      <text class="vr-header-count">{{showSummary ? '复习总结' : (index + 1) + ' / ' + queue.length}}</text>
      <text wx:if="{{!showSummary}}" class="vr-header-tag">闪卡</text>
      <view class="vr-header-spacer"></view>
      <view class="vr-close center tap-dim" bindtap="onClose">
        <image class="vr-close-ic" src="{{dark ? '/assets/icons/close-light.svg' : '/assets/icons/close.svg'}}" />
      </view>
    </view>
  </view>
  <view class="vr-divider"></view>

  <!-- ══ 加载态 ══ -->
  <view wx:if="{{loading}}" class="vr-loading col">
    <view class="vr-spin"></view>
    <text class="t-caption text-tertiary">正在准备复习…</text>
  </view>

  <!-- ══ 总结页（复习完成，复刻 Android ReviewSummary + 单词复习完成页面.jpg）：
       滚动内容区 + 底部固定操作栏（完成胶囊按钮） ══ -->
  <block wx:elif="{{showSummary}}">
    <scroll-view class="vr-body" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="vr-summary col">

        <!-- 成就区：浅绿圆底奖杯 + 主副标题 -->
        <view class="vr-sum-trophy center">
          <image class="vr-sum-trophy-ic" src="/assets/icons/emoji-events-success.svg" />
        </view>
        <text class="vr-sum-title">复习完成！</text>
        <text class="vr-sum-sub">本轮共复习了 {{summary.total}} 个生词</text>

        <!-- 2×2 四宫格（浅色底 + 主题色数字 + 灰色底部小字，对齐截图） -->
        <view class="vr-sum-grid col">
          <view class="row vr-sum-row">
            <view class="vr-sum-cell col vr-sum-cell--0">
              <text class="vr-sum-num">{{summary.forgot}}</text>
              <text class="vr-sum-label">忘记</text>
            </view>
            <view class="vr-sum-cell col vr-sum-cell--1">
              <text class="vr-sum-num">{{summary.hard}}</text>
              <text class="vr-sum-label">模糊</text>
            </view>
          </view>
          <view class="row vr-sum-row">
            <view class="vr-sum-cell col vr-sum-cell--2">
              <text class="vr-sum-num">{{summary.good}}</text>
              <text class="vr-sum-label">认识</text>
            </view>
            <view class="vr-sum-cell col vr-sum-cell--3">
              <text class="vr-sum-num">{{summary.easy}}</text>
              <text class="vr-sum-label">简单</text>
            </view>
          </view>
        </view>

        <!-- 逐词结果列表（极浅底色行 + 右侧状态色文本） -->
        <view class="vr-result-list col">
          <view wx:for="{{results}}" wx:key="vocabularyid" class="vr-result row between">
            <text class="vr-result-word ellipsis">{{item.word}}</text>
            <text class="vr-result-q {{item.qualityCls}}">{{item.qualityLabel}}</text>
          </view>
        </view>

      </view>
    </scroll-view>

    <!-- 底部固定操作栏：再来一轮（忘记>0，Android 逻辑闭环）+ 完成胶囊按钮 -->
    <view class="vr-divider"></view>
    <view class="vr-footer vr-footer--summary">
      <view wx:if="{{summary.forgot > 0}}" class="vr-btn vr-btn--primary center tap-scale" bindtap="onRetry">再来一轮（{{summary.forgot}}个）</view>
      <view class="vr-btn vr-btn--ghost center tap-scale" bindtap="onFinish">完成</view>
    </view>
  </block>

  <!-- ══ 闪卡卡区（3D 翻转 + 横滑切卡） ══ -->
  <block wx:else>
    <view
      class="vr-stage"
      style="perspective: 1200px; transform: translateX({{dragOffset}}px)"
      bindtap="onFlip"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
    >
      <view class="vr-flip {{isFlipped ? 'vr-flip--back' : ''}}">

        <!-- ── 正面：大字单词 + 发音钮 + 提示 ── -->
        <view class="vr-face vr-front col">
          <text class="vr-front-word">{{current.word}}</text>
          <view class="vr-front-play center tap-scale" catchtap="onPlayWord">
            <image class="vr-front-play-ic" src="{{dark ? '/assets/icons/volume-up-dark.svg' : '/assets/icons/volume-up-primary.svg'}}" />
          </view>
          <text class="vr-front-hint">回忆词义，点击卡片查看答案</text>
          <text wx:if="{{current.episodeTitle}}" class="vr-front-from ellipsis">来自《{{current.episodeTitle}}》</text>
        </view>

        <!-- ── 背面：可滚动详情长列表 ── -->
        <view class="vr-face vr-back">
          <scroll-view class="vr-back-scroll" scroll-y enhanced show-scrollbar="{{false}}" catchtap="noop">
            <view class="vr-back-inner col">

              <!-- 头部单词 + US/UK 音标 -->
              <text class="vr-back-word">{{current.word}}</text>
              <view class="row vr-back-phons">
                <view class="row vr-phon">
                  <text class="vr-phon-tag">US</text>
                  <text class="vr-phon-text">{{current.dictData.phonetics.us || '—'}}</text>
                  <view class="vr-phon-play center tap-dim" catchtap="onPlayWord">
                    <image class="vr-phon-play-ic" src="{{dark ? '/assets/icons/volume-up-dark.svg' : '/assets/icons/volume-up-primary.svg'}}" />
                  </view>
                </view>
                <view class="row vr-phon">
                  <text class="vr-phon-tag vr-phon-tag--uk">UK</text>
                  <text class="vr-phon-text">{{current.dictData.phonetics.uk || '—'}}</text>
                  <view class="vr-phon-play center tap-dim"
                        data-url="{{current.dictData.audio_urls.uk}}" data-word="{{current.word}}" catchtap="onPlayPhon">
                    <image class="vr-phon-play-ic" src="/assets/icons/volume-up-secondary.svg" />
                  </view>
                </view>
              </view>

              <!-- 释义卡（ink-50 半透明底 + 绿底词性标签） -->
              <view wx:if="{{current.dictData.definitions.length > 0}}" class="vr-defs col">
                <text class="vr-sec-label">释义</text>
                <view wx:for="{{current.dictData.definitions}}" wx:for-item="def" wx:key="index" class="row vr-def">
                  <text class="vr-def-pos">{{def.pos}}</text>
                  <view class="col vr-def-main">
                    <text class="vr-def-cn">{{def.meaning_cn}}</text>
                    <text wx:if="{{def.meaning_en}}" class="vr-def-en">{{def.meaning_en}}</text>
                  </view>
                </view>
              </view>
              <text wx:elif="{{current.definition}}" class="vr-def-fallback">{{current.definition}}</text>

              <!-- 原声出处卡（渐变底 + 描边；目标词加粗主题绿） -->
              <view wx:if="{{current.contextSentence}}" class="vr-ctx col">
                <text class="vr-sec-label">原声出处</text>
                <view class="vr-ctx-sentence">
                  <text wx:for="{{current.contextParts}}" wx:for-item="seg" wx:key="index"
                        class="{{seg.hit ? 'vr-ctx-hl' : ''}}">{{seg.text}}</text>
                </view>
                <text wx:if="{{current.translation}}" class="vr-ctx-trans">{{current.translation}}</text>
                <text wx:if="{{current.episodeTitle}}" class="vr-ctx-from">来自《{{current.episodeTitle}}》</text>
              </view>

              <!-- 词源记忆卡（accent 淡底 + 词素白底 chips + 💡） -->
              <view wx:if="{{current.dictData.etymology && (current.dictData.etymology.mnemonic || current.dictData.etymology.prefix || current.dictData.etymology.root || current.dictData.etymology.suffix)}}" class="vr-ety col">
                <text class="vr-sec-label">词源记忆</text>
                <view wx:if="{{current.dictData.etymology.prefix || current.dictData.etymology.root || current.dictData.etymology.suffix}}" class="vr-ety-chips row">
                  <text wx:if="{{current.dictData.etymology.prefix}}" class="vr-ety-chip">前缀 · {{current.dictData.etymology.prefix}}</text>
                  <text wx:if="{{current.dictData.etymology.root}}" class="vr-ety-chip">词根 · {{current.dictData.etymology.root}}</text>
                  <text wx:if="{{current.dictData.etymology.suffix}}" class="vr-ety-chip">后缀 · {{current.dictData.etymology.suffix}}</text>
                </view>
                <text wx:if="{{current.dictData.etymology.mnemonic}}" class="vr-ety-memo">💡 {{current.dictData.etymology.mnemonic}}</text>
              </view>

            </view>
          </scroll-view>
        </view>
      </view>
    </view>

    <view class="vr-divider"></view>

    <!-- ══ 底部：显示答案 / FSRS 2×2 四档 ══ -->
    <view class="vr-footer">
      <view wx:if="{{!isFlipped}}" class="vr-show-answer center tap-scale" catchtap="onFlip">显示答案</view>
      <view wx:else class="vr-srs col">
        <view class="row vr-srs-row">
          <view class="vr-srs-btn col center {{submitting ? 'vr-srs-btn--off' : ''}}" data-quality="0" catchtap="onSubmit">
            <image class="vr-srs-ic" src="/assets/icons/replay-error.svg" />
            <text class="vr-srs-label">忘记</text>
            <text class="vr-srs-interval">{{current.intervalPreviews.forgot}}</text>
          </view>
          <view class="vr-srs-btn col center {{submitting ? 'vr-srs-btn--off' : ''}}" data-quality="1" catchtap="onSubmit">
            <image class="vr-srs-ic" src="/assets/icons/schedule-accent.svg" />
            <text class="vr-srs-label">模糊</text>
            <text class="vr-srs-interval">{{current.intervalPreviews.hard}}</text>
          </view>
        </view>
        <view class="row vr-srs-row">
          <view class="vr-srs-btn col center {{submitting ? 'vr-srs-btn--off' : ''}}" data-quality="2" catchtap="onSubmit">
            <image class="vr-srs-ic" src="/assets/icons/check-circle-success-m.svg" />
            <text class="vr-srs-label">认识</text>
            <text class="vr-srs-interval">{{current.intervalPreviews.good}}</text>
          </view>
          <view class="vr-srs-btn col center {{submitting ? 'vr-srs-btn--off' : ''}}" data-quality="3" catchtap="onSubmit">
            <image class="vr-srs-ic" src="/assets/icons/military-tech-info.svg" />
            <text class="vr-srs-label">简单</text>
            <text class="vr-srs-interval">{{current.intervalPreviews.easy}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>

</view>

<!-- TTS 配额触墙会员弹窗 -->
<premium-modal visible="{{showPremiumModal}}" source="{{premiumSource}}" bind:close="onModalClose" />
