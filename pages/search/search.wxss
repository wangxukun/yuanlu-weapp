/* pages/search/search.wxss — 独立搜索页
   复刻 Web 端 app/(main)/search + components/header/SearchBar 的视觉规格：
   文案/字号/颜色逐项对齐 Tailwind 设计系统（1px = 2rpx）。 */

.search-container {
  padding: var(--page-padding);
  padding-bottom: calc(var(--page-padding) + env(safe-area-inset-bottom));
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 搜索输入栏（SearchBar：h-12 rounded-full bg-ink-100） ============ */
.search-bar {
  margin-bottom: 40rpx;
}

.search-input-wrap {
  background-color: var(--ink-100);
  border-radius: var(--r-full);
  padding: 0 32rpx 0 28rpx;
  height: 96rpx;
}

.search-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.search-input {
  font-size: 28rpx;
  height: 96rpx;
  line-height: 96rpx;
  color: var(--ink-700);
}

.search-placeholder {
  color: var(--ink-400);
}

.clear-btn {
  padding: 12rpx 8rpx 12rpx 20rpx;
}

.clear-icon {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ============ 页面标题区（text-3xl bold ink-900 + text-sm ink-500） ============ */
.page-heading {
  margin-bottom: 80rpx;
}

.heading-title {
  font-size: 60rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.3;
  margin-bottom: 16rpx;
}

/* 搜索词高亮（text-primary-600） */
.heading-query {
  color: var(--primary-600);
}

.heading-sub {
  font-size: 28rpx;
  color: var(--ink-500);
}

/* ============ 空态 / 无结果态（py-24 居中，text-6xl 图标） ============ */
.empty-box {
  align-items: center;
  justify-content: center;
  padding: 192rpx 0;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 500;
  color: var(--ink-500);
  text-align: center;
}

.empty-sub {
  font-size: 28rpx;
  color: var(--ink-400);
  margin-top: 8rpx;
  text-align: center;
}

/* 无结果态副文案行内居中（「发现页面」为行内链接） */
.row-center {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.empty-link {
  color: var(--primary-600);
  font-weight: 500;
}

/* ============ 双列网格（与发现页同款分块行） ============ */
.grid-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

/* 列槽：flex:1 等宽，奇数末卡补空占位保持半宽 */
.grid-col {
  flex: 1;
  min-width: 0;
}

/* ============ 结果卡片（SearchResultsContent 卡片逐项对齐） ============ */
.result-card {
  display: flex;
  flex-direction: column;
}

/* 封面：aspect-square rounded-[1rem] = 32rpx，底色 ink-200 */
.result-cover-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
}

.result-cover {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--ink-200);
  display: block;
}

/* 平台标签：text-[10px] font-bold uppercase tracking-widest 主色，单行截断 */
.result-platform {
  font-size: 20rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  color: var(--primary-600);
  margin-bottom: 8rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 标题：text-base bold，line-clamp-1 */
.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink-900);
  line-height: 1.4;
  margin-bottom: 16rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 描述：text-xs ink-500，line-clamp-2，leading-relaxed */
.result-desc {
  font-size: 24rpx;
  color: var(--ink-500);
  line-height: 1.625;
  margin-bottom: 24rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* meta 行：标签 pills + 耳机图标 + 集数 */
.result-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.meta-tag {
  font-size: 20rpx;
  color: var(--primary-600);
  background-color: var(--primary-50);
  padding: 4rpx 16rpx;
  border-radius: var(--r-full);
  font-weight: 500;
}

.meta-episodes {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.meta-headphones {
  width: 22rpx;
  height: 22rpx;
}

.meta-count {
  font-size: 20rpx;
  color: var(--ink-400);
}

/* ============ 计数行（text-sm ink-500，数字 semibold ink-700） ============ */
.result-count {
  font-size: 28rpx;
  color: var(--ink-500);
  margin-bottom: 48rpx;
}

.result-count-num {
  font-weight: 600;
  color: var(--ink-700);
}

/* ============ 骨架屏（Suspense fallback：脉冲动画） ============ */
.skeleton-card {
  flex: 1;
  min-width: 0;
}

.skeleton-cover {
  width: 100%;
  padding-bottom: 100%;
  border-radius: 32rpx;
  background-color: var(--ink-200);
  margin-bottom: 32rpx;
}

.skeleton-line {
  height: 32rpx;
  border-radius: var(--r-full);
  background-color: var(--ink-200);
  margin-bottom: 16rpx;
}

.skeleton-line.short {
  height: 24rpx;
}

.sk-pulse {
  animation: sk-pulse-anim 1.5s ease-in-out infinite;
}

@keyframes sk-pulse-anim {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0.5;
  }
  100% {
    opacity: 1;
  }
}
