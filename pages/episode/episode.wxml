<wxs src="../podcast/podcast.wxs" module="fmt" />
<view class="page-container {{themeClass}}">
  <scroll-view scroll-y="true" class="page-scroll" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="{{true}}">

    <!-- Loading & Error -->
    <block wx:if="{{isLoading}}">
      <view class="center py-8">
        <view class="loading-spinner"></view>
      </view>
    </block>
    <block wx:elif="{{error || !episode}}">
      <view class="center py-8 col">
        <text class="t-body text-secondary">{{error || '未找到该剧集'}}</text>
      </view>
    </block>
    
    <block wx:else>
      <!-- Hero Image -->
      <view class="hero-section">
        <view class="hero-card" bindtap="onStartListening">
          <image class="hero-cover" src="{{episode.coverUrl || episode.podcastCoverUrl || episode.podcast.coverUrl}}" mode="aspectFill"></image>
          
          <!-- Top Left: PRO / PlayCount -->
          <view class="hero-tl row">
            <view class="pro-badge" wx:if="{{episode.isExclusive}}">PRO</view>
            <view class="playcount-badge row center" wx:if="{{episode.playCount > 0}}">
              <image class="icon-xs" src="/assets/icons/headset.svg"></image>
              <text class="t-micro text-white ml-1">{{fmt.formatPlayCount(episode.playCount)}}</text>
            </view>
          </view>
          
          <!-- Top Right: Difficulty -->
          <view class="hero-tr" wx:if="{{episode.difficulty}}">
            <view class="difficulty-badge" style="color: {{fmt.difficultyColor(episode.difficulty)}}">{{episode.difficulty}}</view>
          </view>
          
          <!-- Bottom Right: Play Button -->
          <view class="hero-br">
            <view class="play-fab center">
              <image class="icon-md text-white" src="{{isCurrentPlaying ? '/assets/icons/pause-filled.svg' : '/assets/icons/play-filled.svg'}}"></image>
            </view>
          </view>
        </view>
      </view>

      <!-- Meta info: Tags, Date, Duration -->
      <view class="meta-row row px-4 mt-3">
        <view class="tag-pill center px-3 py-1 mr-3" wx:if="{{episode.tags && episode.tags[0]}}">
          <text class="t-mini text-primary text-bold">{{episode.tags[0].name}}</text>
        </view>
        <view class="row center text-secondary mr-3" wx:if="{{episode.publishAt}}">
          <image class="icon-xs" src="/assets/icons/date-range.svg"></image>
          <text class="t-body ml-1">{{fmt.formatDateZh(episode.publishAt)}}</text>
        </view>
        <view class="row center text-secondary" wx:if="{{episode.duration}}">
          <image class="icon-xs" src="/assets/icons/schedule.svg"></image>
          <text class="t-body ml-1">{{fmt.formatMinutes(episode.duration)}}</text>
        </view>
      </view>

      <!-- Title & Translate -->
      <view class="title-row px-4 mt-2 row align-start">
        <view class="col flex-1 mr-2">
          <text class="t-h2 text-bold">{{episode.title}}</text>
          <text class="t-title text-secondary mt-1" wx:if="{{translatedTitle}}">{{translatedTitle}}</text>
        </view>
        <view class="translate-btn center tap-scale {{translatedTitle ? 'active' : ''}}" bindtap="onTranslateTitle">
          <view class="loading-spinner-sm" wx:if="{{isTranslatingTitle}}"></view>
          <image class="icon-sm" src="/assets/icons/translate.svg" wx:else></image>
        </view>
      </view>

      <!-- Podcast Link -->
      <view class="podcast-link px-4 mt-2">
        <view class="row center tap-scale" bindtap="onOpenPodcast" style="display: inline-flex;">
          <image class="icon-sm text-primary" src="/assets/icons/tv.svg"></image>
          <text class="t-body text-primary text-bold ml-2">{{episode.podcastTitle || episode.podcast.title || episode.podcast.name || '远路英语'}}</text>
        </view>
      </view>

      <!-- Primary Actions -->
      <view class="actions-primary px-4 mt-4 row">
        <view class="btn-primary flex-1 row center tap-scale mr-3" bindtap="onStartListening">
          <image class="icon-sm text-white" src="{{isCurrentPlaying ? '/assets/icons/pause-filled.svg' : '/assets/icons/play-filled.svg'}}"></image>
          <text class="t-title text-white text-bold ml-2">{{isCurrentPlaying ? '暂停精听' : '开始精听'}}</text>
        </view>
        <view class="btn-accent flex-1 row center tap-scale" bindtap="onPractice">
          <image class="icon-sm text-white" src="/assets/icons/mic-filled.svg"></image>
          <text class="t-title text-white text-bold ml-2">语音评测</text>
        </view>
      </view>

      <!-- Secondary Actions -->
      <view class="actions-secondary px-4 mt-3 row">
        <view class="action-box center col tap-scale" bindtap="onDownloadAudio">
          <text wx:if="{{audioDlState === 'downloading'}}" class="dl-progress-text">{{audioDlProgress}}%</text>
          <image wx:elif="{{audioDlState === 'downloaded'}}" class="icon-sm text-secondary" src="/assets/icons/download-done.svg"></image>
          <image wx:else class="icon-sm text-secondary" src="/assets/icons/download.svg"></image>
        </view>
        <view class="action-box center col tap-scale" bindtap="onTranscript" style="opacity: {{isGeneratingPdf ? 0.5 : 1}};">
          <view class="loading-spinner-sm" wx:if="{{isGeneratingPdf}}"></view>
          <image class="icon-sm text-secondary" src="/assets/icons/description.svg" wx:else></image>
        </view>
        <view class="action-box center col tap-scale" bindtap="onToggleFavorite" style="opacity: {{isFavoriteBusy ? 0.5 : 1}};">
          <image class="icon-sm" src="{{isFavorited ? '/assets/icons/bookmark.svg' : '/assets/icons/bookmark-border.svg'}}"></image>
        </view>
        <view class="action-box center col tap-scale" bindtap="onShare">
          <image class="icon-sm text-secondary" src="/assets/icons/share.svg"></image>
        </view>
      </view>

      <view class="divider mt-4"></view>

      <!-- Program Introduction -->
      <view class="intro-section px-4 mt-4">
        <view class="row between align-center mb-3">
          <text class="t-h2 text-bold">节目介绍</text>
          <view class="translate-btn center tap-scale {{translatedDesc ? 'active' : ''}}" bindtap="onTranslateDescription">
            <view class="loading-spinner-sm" wx:if="{{isTranslatingDesc}}"></view>
            <image class="icon-sm" src="/assets/icons/translate.svg" wx:else></image>
          </view>
        </view>
        
        <view class="desc-content">
          <text class="t-desc serif {{!introExpanded ? 'ellipsis-3' : ''}}">{{translatedDesc || episode.description || '暂无介绍'}}</text>
        </view>
        
        <view class="expand-wrapper row center mt-2">
          <view class="expand-pill row center tap-scale" bindtap="onToggleIntro">
            <text class="t-mini text-primary text-bold">{{introExpanded ? '收起内容' : '显示全部'}}</text>
            <image class="icon-xs ml-1" src="{{introExpanded ? '/assets/icons/keyboard-arrow-up.svg' : '/assets/icons/keyboard-arrow-down.svg'}}"></image>
          </view>
        </view>
      </view>

      <!-- AI 精讲本集（PRO 专属，三态：锁定 / 解锁未展开 / 已展开） -->
      <view class="ai-banner px-4 mt-4" id="ai-dive-anchor">
        <ai-deep-dive episodeid="{{episodeid}}" bind:collapse="onDeepDiveCollapse" />
      </view>

      <view class="divider mt-4"></view>

      <!-- Interactive Discussion（严格复刻 Web components/episode/comments：
           未登录引导框 / 「我」头像+输入+发布 / 树形评论列表 + 更多权限菜单） -->
      <view class="comments-section px-4 mt-4">
        <text class="t-h2 text-bold mb-3">互动讨论</text>

        <!-- 未登录：虚线引导框（对齐 Web CommentForm 未登录态） -->
        <view wx:if="{{!isLoggedIn}}" class="cmt-login-box center col">
          <view class="cmt-login-icon center">
            <image class="cmt-login-icon-img" src="{{dark ? '/assets/icons/account-circle-hint-dark.svg' : '/assets/icons/account-circle-hint.svg'}}"></image>
          </view>
          <text class="cmt-login-text">登录后参与讨论，记录你的学习点滴</text>
          <view class="cmt-login-btn center tap-scale" bindtap="onGoLogin">
            <text class="text-bold">立即登录</text>
          </view>
        </view>

        <!-- 已登录：头像（有图用图，无图「我」占位）+ 输入容器；发布钮+字数悬浮容器内右下角
             （对齐 Web：absolute bottom-3 right-3；可提交态由 JS 维护，WXML 表达式不能调 .trim()） -->
        <view wx:else class="cmt-form row align-start">
          <view class="cmt-me-avatar center">
            <image wx:if="{{meAvatar}}" class="cmt-me-avatar-img" src="{{meAvatar}}" mode="aspectFill"></image>
            <text wx:else class="cmt-me-text text-bold">我</text>
          </view>
          <view class="cmt-form-main flex-1">
            <view class="cmt-textarea-box {{commentFocus ? 'focus' : ''}}">
              <textarea
                class="cmt-textarea"
                placeholder="分享你的见解或疑问..."
                placeholder-style="color: #A79E8A"
                value="{{commentText}}"
                bindinput="onCommentInput"
                bindfocus="onCommentFocus"
                bindblur="onCommentBlur"
                maxlength="-1"
                disabled="{{isSubmittingComment}}"
              ></textarea>
              <view class="cmt-form-ops row center">
                <text class="cmt-count {{commentText.length > 0 ? 'show' : ''}}">{{commentText.length}}</text>
                <view
                  class="cmt-publish center tap-scale {{commentCanSubmit && !isSubmittingComment ? 'active' : ''}}"
                  bindtap="onSubmitComment"
                >
                  <view wx:if="{{isSubmittingComment}}" class="cmt-spin"></view>
                  <block wx:else>
                    <image class="cmt-publish-icon" src="/assets/icons/send-white.svg"></image>
                    <text class="text-bold">发布</text>
                  </block>
                </view>
              </view>
            </view>
          </view>
        </view>

        <!-- 列表三态：loading 点阵 / 空沙发 / 树形条目（对齐 Web EpisodeComments） -->
        <view wx:if="{{isLoadingComments}}" class="cmt-list-state center row">
          <view class="cmt-dot d1"></view>
          <view class="cmt-dot d2"></view>
          <view class="cmt-dot d3"></view>
        </view>
        <view wx:elif="{{comments.length === 0}}" class="cmt-list-state center col">
          <text class="cmt-empty-text">还没有人发言，来抢沙发吧！</text>
        </view>
        <block wx:else>
          <block wx:for="{{comments}}" wx:key="commentid" wx:for-item="cmt" wx:for-index="cmtIdx">
            <view class="cmt-item row align-start {{cmtIdx === comments.length - 1 ? 'last' : ''}}">
              <image class="cmt-avatar" src="{{cmt.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
              <view class="col flex-1">
                <view class="row cmt-meta">
                  <text class="cmt-nickname flex-1 ellipsis">{{cmt.nickname || '用户'}}</text>
                  <text class="cmt-time">{{cmt.commentAtText}}</text>
                </view>
                <view class="cmt-bubble"><text user-select>{{cmt.text}}</text></view>
                <view class="cmt-actions row">
                  <view class="row center tap-scale" bindtap="onToggleCommentLike" data-id="{{cmt.commentid}}">
                    <image
                      class="cmt-act-icon"
                      src="{{cmt.isLiked ? (dark ? '/assets/icons/thumb-up-primary-dark.svg' : '/assets/icons/thumb-up-primary.svg') : (dark ? '/assets/icons/thumb-up-dark.svg' : '/assets/icons/thumb-up.svg')}}"
                    ></image>
                    <text class="cmt-like-label {{cmt.isLiked ? 'liked' : ''}}">{{cmt.likesCount || 0}}</text>
                  </view>
                  <view class="row center tap-scale cmt-reply-btn" bindtap="onToggleReply" data-id="{{cmt.commentid}}">
                    <image class="cmt-act-icon" src="{{dark ? '/assets/icons/reply-dark.svg' : '/assets/icons/reply.svg'}}"></image>
                    <text class="cmt-reply-label">回复</text>
                  </view>
                  <view class="cmt-more center tap-scale" bindtap="onMoreComment" data-id="{{cmt.commentid}}">
                    <image class="cmt-more-icon" src="{{dark ? '/assets/icons/more-horiz-dark.svg' : '/assets/icons/more-horiz.svg'}}"></image>
                  </view>
                </view>

                <!-- 回复框（对齐 Web：textarea + 取消/发送双钮） -->
                <view wx:if="{{replyingTo === cmt.commentid}}" class="cmt-reply-box col">
                  <textarea
                    class="cmt-reply-textarea"
                    placeholder="回复 @{{cmt.nickname || '用户'}}..."
                    placeholder-style="color: #A79E8A"
                    value="{{replyText}}"
                    bindinput="onReplyInput"
                    maxlength="-1"
                  ></textarea>
                  <view class="row end cmt-reply-ops">
                    <view class="cmt-reply-cancel center tap-scale" bindtap="onReplyCancel">取消</view>
                    <view class="cmt-reply-send center tap-scale {{replyCanSubmit ? 'on' : ''}}" bindtap="onSubmitReply" data-id="{{cmt.commentid}}">发送</view>
                  </view>
                </view>

                <!-- 嵌套回复（对齐 Web：左侧竖线导轨 + 递归小卡） -->
                <view wx:if="{{cmt.replies.length > 0}}" class="cmt-replies col">
                  <block wx:for="{{cmt.replies}}" wx:key="commentid" wx:for-item="reply">
                    <view class="cmt-reply-item row align-start">
                      <image class="cmt-reply-avatar" src="{{reply.avatarUrl || '/assets/images/default-avatar.png'}}" mode="aspectFill"></image>
                      <view class="col flex-1">
                        <view class="row cmt-meta">
                          <text class="cmt-reply-nickname flex-1 ellipsis">{{reply.nickname || '用户'}}</text>
                          <text class="cmt-time">{{reply.commentAtText}}</text>
                        </view>
                        <view class="cmt-reply-bubble"><text user-select>{{reply.text}}</text></view>
                        <view class="cmt-actions row">
                          <view class="row center tap-scale" bindtap="onToggleCommentLike" data-id="{{reply.commentid}}">
                            <image
                              class="cmt-act-icon"
                              src="{{reply.isLiked ? (dark ? '/assets/icons/thumb-up-primary-dark.svg' : '/assets/icons/thumb-up-primary.svg') : (dark ? '/assets/icons/thumb-up-dark.svg' : '/assets/icons/thumb-up.svg')}}"
                            ></image>
                            <text class="cmt-like-label {{reply.isLiked ? 'liked' : ''}}">{{reply.likesCount || 0}}</text>
                          </view>
                          <view class="row center tap-scale cmt-reply-btn" bindtap="onToggleReply" data-id="{{reply.commentid}}">
                            <image class="cmt-act-icon" src="{{dark ? '/assets/icons/reply-dark.svg' : '/assets/icons/reply.svg'}}"></image>
                            <text class="cmt-reply-label">回复</text>
                          </view>
                          <view class="cmt-more center tap-scale" bindtap="onMoreComment" data-id="{{reply.commentid}}">
                            <image class="cmt-more-icon" src="{{dark ? '/assets/icons/more-horiz-dark.svg' : '/assets/icons/more-horiz.svg'}}"></image>
                          </view>
                        </view>

                        <!-- 回复的回复框（Web 递归同款） -->
                        <view wx:if="{{replyingTo === reply.commentid}}" class="cmt-reply-box col">
                          <textarea
                            class="cmt-reply-textarea"
                            placeholder="回复 @{{reply.nickname || '用户'}}..."
                            placeholder-style="color: #A79E8A"
                            value="{{replyText}}"
                            bindinput="onReplyInput"
                            maxlength="-1"
                          ></textarea>
                          <view class="row end cmt-reply-ops">
                            <view class="cmt-reply-cancel center tap-scale" bindtap="onReplyCancel">取消</view>
                            <view class="cmt-reply-send center tap-scale {{replyCanSubmit ? 'on' : ''}}" bindtap="onSubmitReply" data-id="{{reply.commentid}}">发送</view>
                          </view>
                        </view>
                      </view>
                    </view>
                  </block>
                </view>
              </view>
            </view>
          </block>
        </block>
      </view>

      <view class="divider mt-4"></view>

      <!-- Related Episodes -->
      <view class="related-section px-4 mt-4 mb-5" wx:if="{{relatedEpisodes.length > 0}}">
        <text class="t-h2 text-bold mb-4">相关剧集</text>
        <view class="related-list col">
          <block wx:for="{{relatedEpisodes}}" wx:key="episodeid">
            <view class="related-row row align-center mb-3 tap-scale" bindtap="onOpenEpisode" data-id="{{item.episodeid}}">
              <view class="related-cover-wrap">
                <image class="related-cover" src="{{item.coverUrl || item.podcastCoverUrl || item.podcast.coverUrl || episode.podcastCoverUrl || episode.podcast.coverUrl}}" mode="aspectFill"></image>
              </view>
              <view class="col flex-1 ml-3 mr-2">
                <text class="t-micro text-primary text-bold tracking-wider">EPISODE {{index + 1}}</text>
                <text class="t-title text-bold ellipsis mt-1">{{item.title}}</text>
                <view class="row align-center mt-1 text-secondary">
                  <image class="icon-xs" src="/assets/icons/tv.svg"></image>
                  <text class="t-mini ml-1">{{item.podcastTitle || item.podcast.title || item.podcast.name || episode.podcastTitle || episode.podcast.title || episode.podcast.name || '远路英语'}}</text>
                </view>
              </view>
              <view class="center p-2">
                <view class="outline-btn center tap-scale">
                  <image class="icon-xs" src="/assets/icons/list.svg"></image>
                </view>
              </view>
            </view>
          </block>
        </view>
        
        <!-- View More -->
        <view class="view-more-btn center tap-scale mt-2" bindtap="onOpenPodcast">
          <text class="t-title text-primary text-bold tracking-wider">查看更多内容</text>
        </view>
      </view>
      
      <!-- 底部留白为迷你播放条让位（3.B.3 方案 B：页内控制卡退役，播放控制收敛到迷你条+全屏面板） -->
      <view style="height: calc(var(--mini-player-height) + 48rpx + env(safe-area-inset-bottom));"></view>
    </block>
  </scroll-view>

  <!-- 非会员文稿预览弹层（T1.4：PDF 纸张复刻 + premium-modal 场景拦截卡，CTA 行为组件内置） -->
  <transcript-preview visible="{{showTranscriptPreview}}" preview="{{transcriptPreview}}" episode="{{episode}}" bind:close="onTranscriptPreviewClose" />

  <!-- 会员转化弹窗：场景源动态切换（词典配额 dictionary_quota / 下载门禁 episode_audio_download，T1.3） -->
  <premium-modal visible="{{showPremiumModal}}" source="{{premiumSource}}" bind:close="onPremiumModalClose" />

  <!-- 跨页迷你播放条：无播放会话时整条不渲染 -->
  <mini-player />
</view>
