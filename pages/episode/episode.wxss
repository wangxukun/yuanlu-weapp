/* pages/episode/episode.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--page-bg);
}

.page-scroll {
  flex: 1;
  height: 100%;
}

.hero-section {
  padding: 16rpx 32rpx;
}

.hero-card {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 32rpx;
  overflow: hidden;
  background-color: var(--card-bg);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.hero-cover {
  width: 100%;
  height: 100%;
}

.hero-tl {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  align-items: center;
}

.pro-badge {
  background-color: #FEEBC8;
  color: #C05621;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 50rpx;
  margin-right: 12rpx;
  border: 1px solid #FBD38D;
  letter-spacing: 2rpx;
}

.playcount-badge {
  background-color: rgba(20, 20, 30, 0.8);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.hero-tr {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.difficulty-badge {
  background-color: rgba(255, 255, 255, 0.95);
  font-size: 24rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.hero-br {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
}

.play-fab {
  width: 112rpx;
  height: 112rpx;
  background-color: var(--primary-600);
  border-radius: 50%;
  box-shadow: 0 8rpx 16rpx rgba(31, 122, 92, 0.3);
}

.tag-pill {
  background-color: rgba(31, 122, 92, 0.05);
  border-radius: 50rpx;
}

.translate-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: transparent;
}
.translate-btn.active {
  background-color: rgba(31, 122, 92, 0.1);
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--primary-500);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.podcast-pill {
  padding: 8rpx 16rpx;
  background-color: rgba(31, 122, 92, 0.05);
  border-radius: 16rpx;
  display: inline-flex;
}

.actions-primary {
  gap: 24rpx;
}

.btn-primary {
  background-color: var(--primary-600);
  height: 96rpx;
  border-radius: 24rpx;
}

.btn-accent {
  background-color: #D2503F; /* 评测橘红 */
  height: 96rpx;
  border-radius: 24rpx;
}

.actions-secondary {
  margin-bottom: 32rpx;
}

.action-box {
  flex: 1;
  height: 96rpx;
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  margin-right: 16rpx;
}
.action-box:last-child {
  margin-right: 0;
}

.divider {
  height: 1px;
  background-color: var(--border-color);
  opacity: 0.5;
  margin: 32rpx;
}

.serif {
  font-family: Georgia, 'Times New Roman', Times, serif;
}

.expand-pill {
  background-color: rgba(31, 122, 92, 0.05);
  padding: 8rpx 24rpx;
  border-radius: 50rpx;
}

.ai-banner {
  margin-top: 32rpx;
}

.avatar-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #94A3B8; /* Slate 400 */
}

.input-wrapper {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1px solid var(--border-color);
}

.comment-textarea {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.btn-send {
  background-color: #E2E8F0;
  padding: 12rpx 32rpx;
  border-radius: 50rpx;
  color: #94A3B8;
}

.btn-send.active {
  background-color: var(--primary-600);
  color: #FFFFFF;
}

.related-cover-wrap {
  width: 200rpx;
  height: 112rpx; /* 16:9 approx */
  border-radius: 16rpx;
  overflow: hidden;
  background-color: var(--card-bg);
}

.related-cover {
  width: 100%;
  height: 100%;
}

.outline-btn {
  width: 48rpx;
  height: 48rpx;
  border: 1px solid var(--text-secondary);
  border-radius: 8rpx;
  color: var(--text-secondary);
}

.view-more-btn {
  background-color: rgba(31, 122, 92, 0.05);
  height: 96rpx;
  border-radius: 24rpx;
  border: 1px solid rgba(31, 122, 92, 0.1);
}

/* Typography utilities missing in app.wxss */
.text-white { color: #FFFFFF; }
.tracking-wider { letter-spacing: 4rpx; }
.icon-md { width: 56rpx; height: 56rpx; }

.icon-sm { width: 36rpx; height: 36rpx; }
.icon-xs { width: 28rpx; height: 28rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-5 { margin-bottom: 48rpx; }

.ellipsis-3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; text-overflow: ellipsis; }

/* ============ 播放控制卡（3.B.1，控件对齐 Web MobilePlayerSheet） ============ */
.player-card {
  margin: 0 32rpx;
  padding: 28rpx 32rpx;
  background-color: var(--card-bg);
  border-radius: var(--r-lg);
  box-shadow: var(--e1);
}

/* 当前播放剧集行：播放呼吸点 + 标题 + 缓冲 spinner */
.player-card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-left: 12rpx;
}

.player-playing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--ink-300);
  flex-shrink: 0;
}

.player-playing-dot.on {
  background-color: var(--primary-500);
  animation: player-dot-pulse 1.5s ease-in-out infinite;
}

@keyframes player-dot-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.35; }
}

.player-slider {
  margin: 16rpx 0 0;
}

.player-time-row {
  margin-top: 4rpx;
}

.player-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-variant-numeric: tabular-nums;
}

/* 控件行：快退/上一首/播放大钮/下一首/快进 */
.player-controls {
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 12rpx;
}

.player-ctl {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-ctl-icon {
  width: 48rpx;
  height: 48rpx;
}

/* 播放大钮：白底圆钮 + 主色 FILL 图标（对齐 Web mini player togglePlay） */
.player-play {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background-color: #ffffff;
  border: 2rpx solid var(--primary-100);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(31, 122, 92, 0.18);
}

.player-play-icon {
  width: 56rpx;
  height: 56rpx;
}

/* 次行：倍速 / 循环模式 chips */
.player-sub-controls {
  margin-top: 24rpx;
}

.player-chip {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--r-full);
  background-color: var(--ink-100);
}

.player-chip.active {
  background-color: var(--primary-50);
}

.player-chip-text {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.player-chip.active .player-chip-text {
  color: var(--primary-600);
}

.player-chip-icon {
  width: 28rpx;
  height: 28rpx;
}
