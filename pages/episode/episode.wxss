/* pages/episode/episode.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--page-bg);
}

.page-scroll {
  flex: 1;
  height: 100%;
}

.hero-section {
  padding: 16rpx 32rpx;
}

.hero-card {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 32rpx;
  overflow: hidden;
  background-color: var(--card-bg);
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.hero-cover {
  width: 100%;
  height: 100%;
}

.hero-tl {
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  align-items: center;
}

.pro-badge {
  background-color: #FEEBC8;
  color: #C05621;
  font-size: 20rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 50rpx;
  margin-right: 12rpx;
  border: 1px solid #FBD38D;
  letter-spacing: 2rpx;
}

.playcount-badge {
  background-color: rgba(20, 20, 30, 0.8);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.hero-tr {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
}

.difficulty-badge {
  background-color: rgba(255, 255, 255, 0.95);
  font-size: 24rpx;
  font-weight: 800;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.hero-br {
  position: absolute;
  bottom: 24rpx;
  right: 24rpx;
}

.play-fab {
  width: 112rpx;
  height: 112rpx;
  background-color: var(--primary-600);
  border-radius: 50%;
  box-shadow: 0 8rpx 16rpx rgba(31, 122, 92, 0.3);
}

.tag-pill {
  background-color: rgba(31, 122, 92, 0.05);
  border-radius: 50rpx;
}

.translate-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background-color: transparent;
}
.translate-btn.active {
  background-color: rgba(31, 122, 92, 0.1);
}

.loading-spinner-sm {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid var(--primary-500);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* 页面级大号加载圈与上共用关键帧（spin 此前全项目未定义，转圈实际不动——本批补遗） */
.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--primary-500);
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.podcast-pill {
  padding: 8rpx 16rpx;
  background-color: rgba(31, 122, 92, 0.05);
  border-radius: 16rpx;
  display: inline-flex;
}

.actions-primary {
  gap: 24rpx;
}

.btn-primary {
  background-color: var(--primary-600);
  height: 96rpx;
  border-radius: 24rpx;
}

.btn-accent {
  background-color: #D98A17; /* 评测琥珀橙，对齐 Android PlayerPalette.Accent500 */
  height: 96rpx;
  border-radius: 24rpx;
}

.actions-secondary {
  margin-bottom: 32rpx;
}

.action-box {
  flex: 1;
  height: 96rpx;
  border: 1px solid var(--border-color);
  border-radius: 24rpx;
  margin-right: 16rpx;
}
.action-box:last-child {
  margin-right: 0;
}

.divider {
  height: 1px;
  background-color: var(--border-color);
  opacity: 0.5;
  margin: 32rpx;
}

.serif {
  font-family: Georgia, 'Times New Roman', Times, serif;
}

.expand-pill {
  background-color: rgba(31, 122, 92, 0.05);
  padding: 8rpx 24rpx;
  border-radius: 50rpx;
}

.ai-banner {
  margin-top: 32rpx;
}

/* ============================================================
 * 互动讨论（严格复刻 Web components/episode/comments 的 Tailwind 断点移动端分支）
 * 模块局部色令牌三轨：浅色默认 + 媒体查询深色 + .theme-dark/.theme-light 根类覆盖
 *（评论用原暗值 Ink800/Ink100 等，与全局 --ink-* 深色翻转阶梯不同源，故模块自带令牌）。
 * ========================================================== */
.comments-section {
  --cmt-hint: #a79e8a;       /* text-ink-400 同值：时间/未赞/回复/计数 */
  --cmt-faint: #cfc7b4;      /* base-content/30 近似：更多(...)按钮 */
  --cmt-strong: #4a4436;     /* text-ink-700：气泡正文 */
  --cmt-nick: rgba(27, 24, 18, 0.9);  /* text-base-content/90：昵称 */
  --cmt-sub: #857c68;        /* text-ink-500：引导框正文 */
  --cmt-login-bg: #faf8f3;   /* bg-ink-50 */
  --cmt-login-border: #d5ede1; /* border-[#D5EDE1] 虚线 */
  --cmt-login-icon-bg: #f1ede4; /* bg-ink-100 */
  --cmt-ta-bg: #faf8f3;      /* textarea bg-ink-50 */
  --cmt-ta-bg-focus: #ffffff;
  --cmt-ta-border: #d5ede1;
  --cmt-ta-border-focus: #1f7a5c;
  --cmt-me-bg: rgba(31, 122, 92, 0.1); /* bg-primary-600/10 */
  --cmt-me-ring: #ffffff;    /* ring-2 ring-white */
  --cmt-item-border: #f1ede4; /* border-base-200 */
  --cmt-rail: rgba(241, 237, 228, 0.5); /* border-base-200/50 左导轨 */
}
@media (prefers-color-scheme: dark) {
  .comments-section {
    --cmt-hint: #8c8579;
    --cmt-faint: #a79e8a;
    --cmt-strong: #cfc7b4;   /* dark:text-ink-200 */
    --cmt-nick: rgba(232, 227, 217, 0.9);
    --cmt-sub: #a79e8a;      /* dark:text-ink-400 */
    --cmt-login-bg: #221f18; /* dark:bg-ink-900 */
    --cmt-login-border: #322d23; /* dark:border-ink-800 */
    --cmt-login-icon-bg: #322d23;
    --cmt-ta-bg: rgba(50, 45, 35, 0.5); /* dark:bg-ink-800/50 */
    --cmt-ta-bg-focus: #221f18; /* dark:focus:bg-ink-900 */
    --cmt-ta-border: #322d23;
    --cmt-ta-border-focus: #4da989; /* dark:focus:border-primary-400 */
    --cmt-me-bg: rgba(77, 169, 137, 0.1);
    --cmt-me-ring: #221f18;  /* dark:ring-ink-900 */
    --cmt-item-border: #38332a;
    --cmt-rail: rgba(56, 51, 42, 0.5);
  }
}
.theme-dark .comments-section {
  --cmt-hint: #8c8579;
  --cmt-faint: #a79e8a;
  --cmt-strong: #cfc7b4;
  --cmt-nick: rgba(232, 227, 217, 0.9);
  --cmt-sub: #a79e8a;
  --cmt-login-bg: #221f18;
  --cmt-login-border: #322d23;
  --cmt-login-icon-bg: #322d23;
  --cmt-ta-bg: rgba(50, 45, 35, 0.5);
  --cmt-ta-bg-focus: #221f18;
  --cmt-ta-border: #322d23;
  --cmt-ta-border-focus: #4da989;
  --cmt-me-bg: rgba(77, 169, 137, 0.1);
  --cmt-me-ring: #221f18;
  --cmt-item-border: #38332a;
  --cmt-rail: rgba(56, 51, 42, 0.5);
}
.theme-light .comments-section {
  --cmt-hint: #a79e8a;
  --cmt-faint: #cfc7b4;
  --cmt-strong: #4a4436;
  --cmt-nick: rgba(27, 24, 18, 0.9);
  --cmt-sub: #857c68;
  --cmt-login-bg: #faf8f3;
  --cmt-login-border: #d5ede1;
  --cmt-login-icon-bg: #f1ede4;
  --cmt-ta-bg: #faf8f3;
  --cmt-ta-bg-focus: #ffffff;
  --cmt-ta-border: #d5ede1;
  --cmt-ta-border-focus: #1f7a5c;
  --cmt-me-bg: rgba(31, 122, 92, 0.1);
  --cmt-me-ring: #ffffff;
  --cmt-item-border: #f1ede4;
  --cmt-rail: rgba(241, 237, 228, 0.5);
}

/* ---- 未登录引导框（对齐 Web：dashed 边 + 圆底人像 + 立即登录胶囊） ---- */
.cmt-login-box {
  background-color: var(--cmt-login-bg);
  border: 2rpx dashed var(--cmt-login-border);
  border-radius: 32rpx;
  padding: 64rpx 0;
  gap: 24rpx;
}
.cmt-login-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--cmt-login-icon-bg);
}
.cmt-login-icon-img { width: 48rpx; height: 48rpx; }
.cmt-login-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--cmt-sub);
}
.cmt-login-btn {
  padding: 12rpx 48rpx;
  border-radius: 999rpx;
  background-color: var(--color-primary);
  color: var(--color-primary-content);
  font-size: 24rpx;
}

/* ---- 输入表单（对齐 Web CommentForm 已登录态） ---- */
.cmt-form { gap: 32rpx; }
/* 「我」头像：primary/10 底 + ring-2 白描边 + 微投影；有图整圆填图 */
.cmt-me-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: var(--cmt-me-bg);
  box-shadow: 0 0 0 4rpx var(--cmt-me-ring), 0 2rpx 6rpx rgba(27, 24, 18, 0.06);
  overflow: hidden;
  flex-shrink: 0;
  margin-top: 4rpx; /* Web pt-1 */
}
.cmt-me-avatar-img { width: 100%; height: 100%; }
.cmt-me-text {
  font-size: 28rpx;
  color: var(--color-primary);
}
/* 输入容器：rounded-2xl + 描边/底色随聚焦切换（对齐 focus:border-primary-600 + focus:bg-white）。
   布局硬约束：textarea 是原生组件，真机上悬浮 view 与其组件矩形重叠时点击会被原生层
   吃掉（发布钮点了无效的根因）——故容器底部预留 padding-bottom 按钮区，按钮悬浮于
   padding 区（不与 textarea 矩形重叠），视觉仍是「容器内右下角」，事件稳定可达 */
.cmt-textarea-box {
  position: relative;
  background-color: var(--cmt-ta-bg);
  border: 2rpx solid var(--cmt-ta-border);
  border-radius: 32rpx;
  padding-bottom: 96rpx;
  transition: background-color 0.2s ease, border-color 0.2s ease;
}
.cmt-textarea-box.focus {
  background-color: var(--cmt-ta-bg-focus);
  border-color: var(--cmt-ta-border-focus);
}
.cmt-textarea {
  width: 100%;
  height: 184rpx; /* ~3 行文字；下方 96rpx 为按钮区（容器 padding，非组件矩形） */
  box-sizing: border-box;
  padding: 28rpx 32rpx 0;
  font-size: 28rpx;
  line-height: 1.6;
}
/* 悬浮操作行：容器内右下角（对齐 absolute bottom-3 right-3），落在按钮区不与
   textarea 重叠；z-index 双保险 */
.cmt-form-ops {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  z-index: 10;
  gap: 24rpx; /* gap-3 */
}
/* 字数：text-xs mono ink-400，空输入透明隐藏（对齐 opacity 切换） */
.cmt-count {
  font-size: 24rpx;
  font-family: Menlo, Consolas, monospace;
  color: var(--cmt-hint);
  opacity: 0;
  transition: opacity 0.2s ease;
}
.cmt-count.show { opacity: 1; }
/* 发布钮：btn-primary 圆角 xl + 纸飞机 + 发布；空/在途灰底，可提交品牌绿 */
.cmt-publish {
  gap: 12rpx;
  padding: 14rpx 36rpx;
  border-radius: 24rpx;
  background-color: var(--color-base-300);
  color: var(--text-tertiary);
  font-size: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(31, 122, 92, 0.12);
}
.cmt-publish.active {
  background-color: var(--color-primary);
  color: #ffffff;
}
.cmt-publish-icon { width: 28rpx; height: 28rpx; } /* w-3.5 */
.cmt-spin {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

/* ---- 列表三态（loading 点阵对齐 loading-dots primary/40） ---- */
.cmt-list-state {
  padding: 96rpx 0; /* py-12 */
  gap: 16rpx;
}
.cmt-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background-color: rgba(31, 122, 92, 0.4);
  animation: cmt-bounce 1.2s ease-in-out infinite;
}
.cmt-dot.d2 { animation-delay: 0.15s; }
.cmt-dot.d3 { animation-delay: 0.3s; }
@keyframes cmt-bounce {
  0%, 100% { transform: translateY(0); opacity: 0.5; }
  50% { transform: translateY(-12rpx); opacity: 1; }
}
.cmt-empty-text {
  font-size: 24rpx;
  font-style: italic;
  color: var(--cmt-hint);
}

/* ---- 根评论条目（对齐 Web CommentItem：p-4 + border-b base-200 + last 去
     线；头像 40 带灰环；昵称左/时间右 mono；气泡透明底 rounded-tl-none） ---- */
.cmt-item {
  gap: 24rpx; /* gap-3 */
  padding: 32rpx 0;
  margin-top: 32rpx; /* mt-6 */
  border-bottom: 1px solid var(--cmt-item-border);
}
.cmt-item.last { border-bottom: none; }
.cmt-avatar {
  width: 80rpx;  /* w-10 */
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 1px var(--cmt-item-border); /* ring-1 ring-base-200 */
}
.cmt-meta { margin-bottom: 12rpx; } /* mb-1.5 */
.cmt-nickname {
  font-size: 28rpx; /* text-sm */
  font-weight: 700;
  color: var(--cmt-nick);
}
.cmt-time {
  font-size: 20rpx; /* text-[10px] */
  font-family: Menlo, Consolas, monospace;
  color: var(--cmt-hint);
  margin-left: 16rpx;
  flex-shrink: 0;
}
.cmt-bubble {
  padding: 24rpx; /* p-3 */
  border-radius: 32rpx; /* rounded-2xl */
  border-top-left-radius: 0; /* rounded-tl-none */
  font-size: 28rpx;
  line-height: 1.625; /* leading-relaxed */
  color: var(--cmt-strong);
  word-break: break-word;
  white-space: pre-wrap;
}
/* 操作行（对齐 gap-5 mt-2 ml-1：点赞/回复/更多） */
.cmt-actions {
  gap: 40rpx;
  margin-top: 16rpx;
  margin-left: 8rpx;
}
.cmt-act-icon { width: 28rpx; height: 28rpx; } /* w-3.5 */
.cmt-like-label {
  font-size: 24rpx; /* text-xs */
  font-weight: 700;
  color: var(--cmt-hint);
  margin-left: 12rpx; /* gap-1.5 */
}
.cmt-like-label.liked { color: var(--color-primary); }
.cmt-reply-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--cmt-hint);
  margin-left: 12rpx;
}
.cmt-more { margin-left: auto; }
.cmt-more-icon { width: 32rpx; height: 32rpx; } /* w-4 */

/* ---- 回复框（对齐 Web：textarea-bordered rounded-xl + 取消/发送双钮） ---- */
.cmt-reply-box { margin-top: 24rpx; } /* mt-3 */
.cmt-reply-textarea {
  width: 100%;
  height: 160rpx; /* h-20 */
  box-sizing: border-box;
  padding: 20rpx;
  font-size: 24rpx;
  line-height: 1.6;
  background-color: var(--card-bg); /* bg-base-100 */
  border: 2rpx solid var(--cmt-ta-border);
  border-radius: 24rpx; /* rounded-xl */
}
.cmt-reply-ops { gap: 16rpx; margin-top: 16rpx; } /* gap-2 mt-2 */
.cmt-reply-cancel {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  color: var(--cmt-hint); /* text-base-content/50 近似 */
}
.cmt-reply-send {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  background-color: var(--color-base-300);
  color: var(--text-tertiary);
  opacity: 0.6;
}
.cmt-reply-send.on {
  background-color: var(--color-primary);
  color: var(--color-primary-content);
  opacity: 1;
}

/* ---- 嵌套回复（对齐 Web：pl-2 + border-l-2 base-200/50 导轨 + 小卡） ---- */
.cmt-replies {
  margin-top: 24rpx;
  padding-left: 16rpx; /* pl-2 */
  border-left: 4rpx solid var(--cmt-rail); /* border-l-2 */
}
.cmt-reply-item {
  gap: 16rpx; /* gap-3（父级 gap-3） */
  padding: 24rpx 0;
  margin-top: 24rpx; /* mt-4（isReply） */
  border-bottom: 1px solid var(--cmt-item-border);
}
.cmt-reply-item:last-child { border-bottom: none; }
.cmt-reply-avatar {
  width: 64rpx;  /* w-8 */
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 0 0 1px var(--cmt-item-border);
}
.cmt-reply-nickname {
  font-size: 24rpx; /* text-xs */
  font-weight: 700;
  color: var(--cmt-nick);
}
.cmt-reply-bubble {
  padding: 20rpx;
  border-radius: 24rpx;
  border-top-left-radius: 0;
  font-size: 24rpx;
  line-height: 1.625;
  color: var(--cmt-strong);
  word-break: break-word;
  white-space: pre-wrap;
}

.related-cover-wrap {
  width: 200rpx;
  height: 112rpx; /* 16:9 approx */
  border-radius: 16rpx;
  overflow: hidden;
  background-color: var(--card-bg);
}

.related-cover {
  width: 100%;
  height: 100%;
}

.view-more-btn {
  background-color: rgba(31, 122, 92, 0.05);
  height: 96rpx;
  border-radius: 24rpx;
  border: 1px solid rgba(31, 122, 92, 0.1);
}

/* Typography utilities missing in app.wxss */
.text-white { color: #FFFFFF; }
.tracking-wider { letter-spacing: 4rpx; }
.icon-md { width: 56rpx; height: 56rpx; }

.icon-sm { width: 36rpx; height: 36rpx; }
.icon-xs { width: 28rpx; height: 28rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.py-4 { padding-top: 32rpx; padding-bottom: 32rpx; }
.mr-2 { margin-right: 16rpx; }
.mr-3 { margin-right: 24rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }
.mb-5 { margin-bottom: 48rpx; }

.ellipsis-3 { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; text-overflow: ellipsis; }

/* 音频离线缓存下载进度（T3.3 三态：downloading 百分比文本 / downloaded download-done 图标 / idle download 图标） */
.dl-progress-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #64748b; /* 与 download.svg、download-done.svg 的 text-secondary 同色 */
  min-width: 44rpx;
  text-align: center;
  line-height: 1;
}
