/**
 * intensive.wxs — 精听页面视图层助手
 *
 * 单词扫光三态 class 计算（useWordHighlight 离散移植）：
 * 词状态由活动句视图字段 (item.active, item.swIdx, item.swOn) 唯一确定，
 * JS 侧以 viewList[i].xxx 路径补丁下发，WXS 在视图层就地求值——词 class
 * 只依赖 item 字段，高频扫光 setData 的重算范围收敛到活动句单句
 * （原依赖页面级标量 activeWordIndex/wordSweepOn，每帧牵动全列表词节点
 * 重算，长剧集渲染积压的根因，见页面文件头性能口径）：
 *   wi < swIdx（或 === 且 !swOn）→ w--past   已读：accent-700 棕字
 *   wi === swIdx 且 swOn         → w--cur    当前：accent-100 底光斑 + 主题绿字
 *   wi > swIdx                   → w         未读：继承活动句 primary-600
 * 非活动句 / 暂停（active=false）→ 全部回落 w（Web: clearAll 兜底）。
 */
function wordCls(active, wi, sweepIdx, sweepOn) {
  if (!active) return 'w';
  if (wi === sweepIdx && sweepOn) return 'w w--cur';
  if (wi < sweepIdx || (wi === sweepIdx && !sweepOn)) return 'w w--past';
  return 'w';
}

module.exports = {
  wordCls: wordCls,
};
