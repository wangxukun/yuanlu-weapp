/* pages/channel/all/index.wxss — 全部频道页
   数据与卡片视觉对齐 Web app/(main)/discover/channels/page.tsx（ChannelCard 由
   components/common/channel-card 渲染：白底圆角卡 + 16:9 封面 + 眉标 + 集数行；
   旧版 1:1 绿底居中卡与「频道主页」胶囊样式已废弃删除）。 */

.channel-all-container {
  padding: 16rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + var(--mini-player-height) + env(safe-area-inset-bottom));
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头（保留小程序页头规格：titleLarge 22sp 加粗） ============ */
.page-header {
  padding: 16rpx 0 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* ============ 状态态（loading / error / empty 居中） ============ */
.state-box {
  padding: 200rpx 0;
}

/* ============ 双列网格（每行两个，12dp 间距；全站同款） ============ */
.grid-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.grid-col {
  flex: 1;
  min-width: 0;
}
