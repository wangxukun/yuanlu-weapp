/* pages/channel/all/index.wxss — 全部频道页
   逐项复刻 ChannelListScreen.kt / ChannelCard（1dp = 2rpx，颜色取自
   theme/Color.kt：primaryContainer=#edf7f2/primary-50，onPrimaryContainer=#0a241b/primary-950） */

.channel-all-container {
  padding: 16rpx 32rpx 48rpx; /* contentPadding h16dp v8dp + 底部余量 */
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 页头（titleLarge = 22sp 加粗，Row padding h16dp v8dp） ============ */
.page-header {
  padding: 16rpx 0 8rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* ============ 状态态（loading / error / empty 居中） ============ */
.state-box {
  padding: 200rpx 0;
}

/* ============ 双列网格（LazyVerticalGrid Fixed(2)，spacedBy(12dp)） ============ */
.grid-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.grid-col-spacer {
  flex: 1;
  min-width: 0;
}

/* ============ 频道卡（ChannelCard：1:1 方卡 primaryContainer 圆角 16dp） ============ */
.channel-card {
  flex: 1;
  min-width: 0;
  aspect-ratio: 1 / 1;
  background-color: var(--primary-50); /* LightPrimaryContainer #edf7f2 */
  border-radius: 32rpx;                /* RoundedCornerShape(16dp) */
  padding: 24rpx;                      /* Modifier.padding(12dp) */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;             /* verticalArrangement = Center 垂直居中 */
}

/* 频道名：titleMedium(16sp) 加粗，onPrimaryContainer，单行截断 */
.channel-name {
  max-width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--primary-950); /* LightOnPrimaryContainer #0a241b */
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis; /* maxLines=1 + TextOverflow.Ellipsis */
}

/* 节目数：bodySmall(12sp)，onPrimaryContainer 70%，Spacer(6dp) */
.channel-count {
  max-width: 100%;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--primary-950);
  opacity: 0.7; /* onPrimaryContainer.copy(alpha = 0.7f) */
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 频道主页胶囊：Surface(surface=白) rounded-full，Spacer(16dp) 上距 */
.channel-btn {
  margin-top: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx; /* Spacer(4dp) */
  background-color: #ffffff; /* colorScheme.surface */
  border-radius: var(--r-full);
  padding: 12rpx 24rpx; /* Row padding h12dp v6dp */
}

/* Icons.Filled.Computer 14dp，tint primary */
.channel-btn-icon {
  width: 28rpx;
  height: 28rpx;
}

/* 「频道主页」labelSmall(11sp) 加粗 primary */
.channel-btn-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--primary-600);
}
