<!-- pages/channel/all/index — 全部频道页
  对齐 Web app/(main)/discover/channels/page.tsx：GET /api/channels 同源数据 +
  ChannelCard 同款卡片（components/common/channel-card，封面/眉标/集数行）；
  布局保留小程序原双列网格（每行两个，12dp 间距），卡片点击 → 频道详情页深链。 -->
<view class="channel-all-container {{themeClass}}">

  <!-- 页头：左对齐大号加粗标题（保留小程序页头规格） -->
  <view class="page-header">
    <text class="page-title">全部频道</text>
  </view>

  <!-- 加载态 -->
  <view class="state-box center" wx:if="{{isLoading}}">
    <view class="loading-spinner"></view>
  </view>

  <!-- 错误态 + 重试 -->
  <view class="state-box center col" wx:elif="{{error}}">
    <text class="t-body text-secondary">{{error}}</text>
    <button class="btn-primary" style="margin-top: 32rpx; width: 240rpx;" bindtap="onRetry">重试</button>
  </view>

  <!-- 空态 -->
  <view class="state-box center col" wx:elif="{{channels.length === 0}}">
    <text class="t-body text-secondary">暂无频道</text>
  </view>

  <!-- 双列网格（每行两个；channel-card 组件渲染 Web 同款卡片） -->
  <block wx:else>
    <view class="grid-row" wx:for="{{channelRows}}" wx:key="index">
      <view class="grid-col" wx:for="{{item}}" wx:for-item="channel" wx:key="name">
        <channel-card channel="{{channel}}" bind:open="onOpenChannel" />
      </view>
      <!-- 奇数末卡补空占位，保持半宽 -->
      <view class="grid-col" wx:if="{{item.length === 1}}"></view>
    </view>
  </block>

</view>

<!-- 跨页迷你播放条（3.B.3）：无播放会话时整条不渲染 -->
<mini-player />
