<!-- pages/profile/index.wxml — 个人中心主页（阶段 2 骨架 + 用户信息卡 + Tab 行；
     阶段 3 旅程数据 / 阶段 4 里程碑 / 阶段 5 账号与安全（四卡+绑定弹层+注销确认）均落地，
     UI 基准 PersonalCenterScreen.kt + BindAccountSheets.kt） -->
<view class="profile-page {{themeClass}}">

  <!-- 首载骨架（HeaderCard 加载态：头像圆 + 三行 shimmer，对齐 L313-324） -->
  <view wx:if="{{isLoading}}" class="pf-card">
    <view class="row">
      <view class="pf-skel-avatar"></view>
      <view class="flex-1 pf-skel-col">
        <view class="pf-skel-bar" style="width: 50%; height: 44rpx;"></view>
        <view class="pf-skel-bar" style="width: 70%; height: 28rpx;"></view>
        <view class="pf-skel-bar" style="width: 40%; height: 24rpx;"></view>
      </view>
    </view>
  </view>

  <!-- 未登录守门态（入口为已登录用户卡，此为兜底） -->
  <view wx:elif="{{needLogin}}" class="state-box col center">
    <view class="state-title">登录后查看个人中心</view>
    <view class="state-btn" bindtap="onLogin">去登录</view>
  </view>

  <!-- 主内容 -->
  <block wx:else>
    <!-- ============ 用户信息卡（HeaderCard L305-446） ============ -->
    <view class="pf-card">
      <!-- 资料加载失败：卡内错误态（非页级拦断，Android 同口径） -->
      <view wx:if="{{!profile}}" class="pf-card-error col center">
        <view class="pf-card-error-text">{{loadError || '资料加载失败'}}</view>
        <view class="pf-card-retry" bindtap="onRetry">点击重试</view>
      </view>

      <view wx:else class="pf-header">
        <view class="pf-header-top row">
          <!-- 头像：白描边圆 + surfaceVariant 底；http 开头才加载 -->
          <view class="pf-avatar-box center">
            <image wx:if="{{profile.avatarUrl}}" class="pf-avatar-img" src="{{profile.avatarUrl}}" mode="aspectFill" />
            <image wx:else class="pf-avatar-ph" src="{{dark ? '/assets/icons/person-variant-dark.svg' : '/assets/icons/person-variant.svg'}}" mode="aspectFit" />
          </view>
          <view class="flex-1 pf-id-col">
            <view class="pf-name ellipsis">{{profile.displayName}}</view>
            <!-- 远行客徽章：secondary 橙 10% 底 + 30% 描边胶囊（紧凑包裹内容，勿用 center 类——会把内容在拉伸宽度里居中） -->
            <view class="pf-level-pill row">
              <image class="pf-level-icon" src="/assets/icons/hiking-accent.svg" mode="aspectFit" />
              <text class="pf-level-text">远行客 · {{profile.levelLabel}}</text>
            </view>
            <view class="pf-bio ellipsis-2">{{profile.bioText}}</view>
            <view class="pf-meta row">
              <view class="pf-meta-item row center">
                <image class="pf-meta-icon" src="{{dark ? '/assets/icons/calendar-month-variant-dark.svg' : '/assets/icons/calendar-month-variant.svg'}}" mode="aspectFit" />
                <text class="pf-meta-text">{{profile.joinDateText}} 加入</text>
              </view>
              <view class="pf-meta-item row center">
                <image class="pf-meta-icon" src="{{dark ? '/assets/icons/place-variant-dark.svg' : '/assets/icons/place-variant.svg'}}" mode="aspectFit" />
                <text class="pf-meta-text">中国</text>
              </view>
            </view>
          </view>
        </view>
        <!-- 整宽描边按钮（OutlinedButton r12dp） -->
        <view class="pf-edit-btn center" hover-class="pf-edit-btn-hover" bindtap="onOpenEdit">编辑资料</view>
      </view>
    </view>

    <!-- ============ 三 Tab 行（CenterTabRow L469-507） ============ -->
    <view class="pf-tabs row">
      <view
        wx:for="{{tabs}}"
        wx:key="key"
        class="pf-tab col center {{activeTab === item.key ? 'on' : ''}}"
        data-key="{{item.key}}"
        bindtap="onTab"
      >
        <view class="pf-tab-label">{{item.label}}</view>
        <view class="pf-tab-underline"></view>
      </view>
    </view>
    <view class="pf-tabs-divider"></view>

    <!-- ============ Tab 面板（wx:if 重建触发进出场动画） ============ -->
    <view class="pf-panel">
      <!-- 旅程数据（阶段 3：StatsOverview 三卡 + ActivityChartCard） -->
      <view wx:if="{{activeTab === 'journey'}}" class="pf-panel-inner pf-journey">
        <block wx:if="{{statsLoading}}">
          <view class="pf-card pf-stat-skel" wx:for="{{[1, 2, 3]}}" wx:key="*this"></view>
        </block>
        <block wx:elif="{{stats}}">
          <view class="pf-card pf-stat-card row" wx:for="{{statCards}}" wx:key="key">
            <view class="flex-1">
              <view class="pf-stat-label">{{item.label}}</view>
              <view class="row pf-stat-value-row">
                <view class="pf-stat-value">{{item.value}}</view>
                <view class="pf-stat-unit">{{item.unit}}</view>
              </view>
              <view wx:if="{{item.subtext}}" class="pf-stat-sub">{{item.subtext}}</view>
            </view>
            <view class="pf-stat-icon-box center {{item.tintClass}}">
              <image class="pf-stat-icon" src="{{item.icon}}" mode="aspectFit" />
            </view>
          </view>
        </block>

        <view class="pf-card pf-chart-card">
          <view class="row between">
            <view class="pf-chart-title">本周行程记录</view>
            <view class="row pf-week-seg">
              <view class="pf-week-opt {{weekOffset === 0 ? 'on' : ''}}" data-offset="0" bindtap="onChangeWeek">本周</view>
              <view class="pf-week-opt {{weekOffset === 1 ? 'on' : ''}}" data-offset="1" bindtap="onChangeWeek">上周</view>
            </view>
          </view>
          <view class="pf-chart-body">
            <view wx:if="{{activityLoading}}" class="pf-chart-loading center">
              <view class="pf-spin"></view>
            </view>
            <canvas wx:else type="2d" id="weeklyChart" class="pf-chart-canvas" style="width: {{chartW}}px; height: {{chartH}}px;"></canvas>
          </view>
        </view>
      </view>

      <!-- 里程碑（阶段 4：MilestoneRoadmapCard 路图 + AchievementsCard 成就墙） -->
      <view wx:elif="{{activeTab === 'milestones'}}" class="pf-panel-inner pf-milestones">
        <!-- 路图卡（statsLoading → 190dp 整宽骨架；stats 缺失按 km=0 仍渲染卡） -->
        <view wx:if="{{statsLoading}}" class="pf-ms-skel"></view>
        <view wx:else class="pf-card pf-ms-card">
          <view class="row between">
            <view class="pf-chart-title">远路里程碑</view>
            <view class="pf-ms-km-pill">{{msKmText}} km</view>
          </view>
          <view class="pf-ms-body">
            <canvas type="2d" id="milestoneChart" class="pf-ms-canvas" style="width: {{chartW}}px; height: {{msH}}px;"></canvas>
          </view>
        </view>

        <!-- 成就墙（排序后前 8、4 列两行；emoji 为服务端 icon 直渲） -->
        <view class="pf-card pf-ach-card">
          <block wx:if="{{achievementsLoading}}">
            <view class="pf-ach-skel-title"></view>
            <view class="pf-ach-grid">
              <view class="pf-ach-skel-tile" wx:for="{{[1, 2, 3, 4, 5, 6, 7, 8]}}" wx:key="*this"></view>
            </view>
          </block>
          <block wx:else>
            <view class="row between">
              <view class="pf-ach-title">远路里程碑 ({{achievements ? achievements.unlockedCount : 0}})</view>
              <view class="pf-ach-more" bindtap="onAllAchievements">全部查看</view>
            </view>
            <view wx:if="{{!achievements || !achievements.items.length}}" class="pf-ach-empty">暂无里程碑数据</view>
            <view wx:else class="pf-ach-grid">
              <view
                wx:for="{{achTiles}}"
                wx:key="key"
                class="pf-ach-tile center {{item.unlocked ? 'on' : 'off'}}"
              >
                <text class="pf-ach-emoji">{{item.icon}}</text>
              </view>
            </view>
          </block>
        </view>
      </view>
      <!-- 账号与安全（阶段 5：SecuritySection 四卡 + 页内弹层） -->
      <view wx:else class="pf-panel-inner pf-security">
        <!-- 手机号卡 -->
        <view class="pf-card pf-sec-card row">
          <view class="pf-sec-icon-box center tint-primary">
            <image class="pf-sec-icon" src="{{dark ? '/assets/icons/smartphone-primary-dark.svg' : '/assets/icons/smartphone-primary.svg'}}" mode="aspectFit" />
          </view>
          <view class="flex-1 pf-sec-main">
            <view class="pf-sec-title">手机号</view>
            <view wx:if="{{profile && profile.hasPhone}}" class="row pf-sec-verified-row">
              <text class="pf-sec-value">{{profile.phoneMasked}}</text>
              <image class="pf-sec-badge-icon" src="{{dark ? '/assets/icons/check-circle-primary-dark.svg' : '/assets/icons/check-circle-primary.svg'}}" mode="aspectFit" />
              <text class="pf-sec-verified">已验证</text>
            </view>
            <view wx:else class="row pf-sec-unbound-row">
              <text class="pf-sec-unbound">未绑定</text>
              <image class="pf-sec-badge-icon pf-sec-badge-warn" src="/assets/icons/warning.svg" mode="aspectFit" />
            </view>
          </view>
          <view wx:if="{{!profile || !profile.hasPhone}}" class="pf-sec-btn" bindtap="onOpenBindPhone">绑定手机号</view>
        </view>

        <!-- 邮箱卡 -->
        <view class="pf-card pf-sec-card row">
          <view class="pf-sec-icon-box center tint-secondary">
            <image class="pf-sec-icon" src="/assets/icons/email-accent.svg" mode="aspectFit" />
          </view>
          <view class="flex-1 pf-sec-main">
            <view class="pf-sec-title">邮箱</view>
            <view wx:if="{{profile && profile.hasRealEmail}}" class="row pf-sec-verified-row">
              <text class="pf-sec-value">{{profile.emailMasked}}</text>
              <image class="pf-sec-badge-icon" src="{{dark ? '/assets/icons/check-circle-primary-dark.svg' : '/assets/icons/check-circle-primary.svg'}}" mode="aspectFit" />
              <text class="pf-sec-verified">已验证</text>
            </view>
            <view wx:else class="row pf-sec-unbound-row">
              <text class="pf-sec-unbound">未绑定</text>
              <image class="pf-sec-badge-icon pf-sec-badge-warn" src="/assets/icons/warning.svg" mode="aspectFit" />
            </view>
          </view>
          <view wx:if="{{!profile || !profile.hasRealEmail}}" class="pf-sec-btn" bindtap="onOpenBindEmail">绑定邮箱</view>
        </view>

        <!-- 登录密码卡（无尾随操作） -->
        <view class="pf-card pf-sec-card row">
          <view class="pf-sec-icon-box center tint-tertiary">
            <image class="pf-sec-icon" src="{{dark ? '/assets/icons/lock-tertiary-dark.svg' : '/assets/icons/lock-tertiary.svg'}}" mode="aspectFit" />
          </view>
          <view class="flex-1 pf-sec-main">
            <view class="pf-sec-title">登录密码</view>
            <view wx:if="{{profile && profile.passwordSet}}" class="pf-sec-value pf-sec-set">已设置</view>
            <view wx:else class="row pf-sec-unset-row">
              <text class="pf-sec-unbound">未设置</text>
              <text class="pf-sec-unset-note">（绑定邮箱时将同时设置）</text>
            </view>
          </view>
        </view>

        <!-- 注销账号卡（危险区：图标/标题同红） -->
        <view class="pf-card pf-sec-card row">
          <view class="pf-sec-icon-box center tint-error">
            <image class="pf-sec-icon" src="/assets/icons/person-remove-error.svg" mode="aspectFit" />
          </view>
          <view class="flex-1 pf-sec-main">
            <view class="pf-sec-title pf-sec-title-err">注销账号</view>
            <view class="pf-sec-unbound pf-sec-danger-sub">永久删除您的账号及所有相关数据，此操作不可逆。</view>
          </view>
          <view class="pf-sec-btn pf-sec-btn-danger" bindtap="onOpenDeleteConfirm">注销账号</view>
        </view>
      </view>
    </view>

    <!-- ============ 绑定手机号底部弹层（BindPhoneSheet） ============ -->
    <view wx:if="{{securitySheet === 'phone'}}" class="pf-sheet-mask" catchtap="onCloseSheet" catch:touchmove="noop">
      <view class="pf-sheet" catchtap="noop">
        <view class="pf-sheet-title">绑定手机号</view>
        <view class="pf-sheet-subtitle">绑定后可用手机号验证码登录</view>

        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/phone-iphone-variant-dark.svg' : '/assets/icons/phone-iphone-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            type="number"
            maxlength="11"
            placeholder="请输入11位手机号码"
            placeholder-class="pf-field-ph"
            value="{{bindForm.phone}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onPhoneInput"
          />
        </view>
        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/password-variant-dark.svg' : '/assets/icons/password-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            type="number"
            maxlength="6"
            placeholder="输入6位验证码"
            placeholder-class="pf-field-ph"
            value="{{bindForm.code}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onCodeInput"
          />
          <view wx:if="{{bindForm.countdownSeconds > 0}}" class="pf-code-count">{{bindForm.countdownSeconds}}s</view>
          <view wx:else class="pf-code-send {{bindUi.canSendCode && !bindForm.isSendingCode ? '' : 'disabled'}}" bindtap="onSendCode">
            {{bindForm.isSendingCode ? '发送中…' : '获取验证码'}}
          </view>
        </view>

        <view wx:if="{{bindForm.notice && !bindForm.error}}" class="pf-sheet-notice">{{bindForm.notice}}</view>
        <view wx:if="{{bindForm.error}}" class="pf-sheet-error">{{bindForm.error}}</view>

        <view class="pf-sheet-submit {{bindUi.submitEnabled ? '' : 'disabled'}}" bindtap="onSubmitBind">
          <view wx:if="{{bindForm.isSubmitting}}" class="pf-spin pf-spin-light"></view>
          <text wx:else>确认绑定</text>
        </view>
      </view>
    </view>

    <!-- ============ 绑定邮箱底部弹层（BindEmailSheet：邮箱 + 验证码 + 密码两连 + 强度三项） ============ -->
    <view wx:if="{{securitySheet === 'email'}}" class="pf-sheet-mask" catchtap="onCloseSheet" catch:touchmove="noop">
      <view class="pf-sheet" catchtap="noop">
        <view class="pf-sheet-title">绑定邮箱</view>
        <view class="pf-sheet-subtitle">绑定后将同时设置登录密码，可用邮箱密码登录</view>

        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/mail-variant-dark.svg' : '/assets/icons/mail-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            type="text"
            placeholder="请输入邮箱地址"
            placeholder-class="pf-field-ph"
            value="{{bindForm.email}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onEmailInput"
          />
          <view wx:if="{{bindForm.countdownSeconds > 0}}" class="pf-code-count">{{bindForm.countdownSeconds}}s</view>
          <view wx:else class="pf-code-send {{bindUi.canSendCode && !bindForm.isSendingCode ? '' : 'disabled'}}" bindtap="onSendCode">
            {{bindForm.isSendingCode ? '发送中…' : '获取验证码'}}
          </view>
        </view>
        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/password-variant-dark.svg' : '/assets/icons/password-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            type="number"
            maxlength="6"
            placeholder="6位邮箱验证码"
            placeholder-class="pf-field-ph"
            value="{{bindForm.code}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onCodeInput"
          />
        </view>
        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/lock-variant-dark.svg' : '/assets/icons/lock-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            password="{{!bindForm.passwordVisible}}"
            placeholder="设置登录密码"
            placeholder-class="pf-field-ph"
            value="{{bindForm.password}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onPasswordInput"
          />
          <view class="pf-field-eye" catchtap="onTogglePasswordVisible">{{bindForm.passwordVisible ? '隐藏' : '显示'}}</view>
        </view>

        <!-- 密码强度三项实时指示（达标 primary 对勾 / 未达标空心圆） -->
        <view class="row pf-criteria">
          <view class="row pf-criteria-item">
            <image wx:if="{{bindUi.criteria.length}}" class="pf-criteria-icon" src="{{dark ? '/assets/icons/check-circle-primary-dark.svg' : '/assets/icons/check-circle-primary.svg'}}" mode="aspectFit" />
            <view wx:else class="pf-criteria-circle"></view>
            <text class="pf-criteria-label {{bindUi.criteria.length ? 'met' : ''}}">8位以上</text>
          </view>
          <view class="row pf-criteria-item">
            <image wx:if="{{bindUi.criteria.hasLetter}}" class="pf-criteria-icon" src="{{dark ? '/assets/icons/check-circle-primary-dark.svg' : '/assets/icons/check-circle-primary.svg'}}" mode="aspectFit" />
            <view wx:else class="pf-criteria-circle"></view>
            <text class="pf-criteria-label {{bindUi.criteria.hasLetter ? 'met' : ''}}">包含字母</text>
          </view>
          <view class="row pf-criteria-item">
            <image wx:if="{{bindUi.criteria.hasNumber}}" class="pf-criteria-icon" src="{{dark ? '/assets/icons/check-circle-primary-dark.svg' : '/assets/icons/check-circle-primary.svg'}}" mode="aspectFit" />
            <view wx:else class="pf-criteria-circle"></view>
            <text class="pf-criteria-label {{bindUi.criteria.hasNumber ? 'met' : ''}}">包含数字</text>
          </view>
        </view>

        <view class="pf-field row">
          <image class="pf-field-icon" src="{{dark ? '/assets/icons/lock-variant-dark.svg' : '/assets/icons/lock-variant.svg'}}" mode="aspectFit" />
          <input
            class="flex-1 pf-field-input"
            password="{{!bindForm.passwordVisible}}"
            placeholder="确认登录密码"
            placeholder-class="pf-field-ph"
            value="{{bindForm.confirmPassword}}"
            disabled="{{bindForm.isSubmitting}}"
            bindinput="onConfirmPasswordInput"
          />
        </view>
        <view wx:if="{{bindForm.confirmPassword && !bindUi.confirmMatch}}" class="pf-sheet-error pf-mismatch">两次输入的密码不一致</view>

        <view wx:if="{{bindForm.notice && !bindForm.error}}" class="pf-sheet-notice">{{bindForm.notice}}</view>
        <view wx:if="{{bindForm.error}}" class="pf-sheet-error">{{bindForm.error}}</view>

        <view class="pf-sheet-submit {{bindUi.submitEnabled ? '' : 'disabled'}}" bindtap="onSubmitBind">
          <view wx:if="{{bindForm.isSubmitting}}" class="pf-spin pf-spin-light"></view>
          <text wx:else>确认绑定</text>
        </view>
      </view>
    </view>

    <!-- ============ 注销账号二次确认（居中危险弹窗） ============ -->
    <view wx:if="{{deleteConfirmOpen}}" class="pf-dialog-mask" catchtap="onCloseDeleteConfirm" catch:touchmove="noop">
      <view class="pf-dialog" catchtap="noop">
        <image class="pf-dialog-icon" src="/assets/icons/warning.svg" mode="aspectFit" />
        <view class="pf-dialog-title">确认注销账号？</view>
        <view class="pf-dialog-text">您的个人资料、学习记录、收藏等所有数据将被永久删除，且无法恢复。请确认您要继续此操作。</view>
        <view class="row pf-dialog-btns">
          <view class="pf-dialog-cancel" bindtap="onCloseDeleteConfirm">取消</view>
          <view class="pf-dialog-confirm {{deletingAccount ? 'disabled' : ''}}" bindtap="onConfirmDelete">
            <view wx:if="{{deletingAccount}}" class="pf-spin pf-spin-light"></view>
            <text wx:else>确认注销</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部预留：24dp 间距 + mini-player + 安全区（对齐 Android 尾部 Spacer 24dp） -->
    <view class="pf-bottom-space"></view>
  </block>

  <!-- 跨页迷你播放条：无播放会话时整条不渲染（非 tab 页不传 elevated） -->
  <mini-player />
</view>
