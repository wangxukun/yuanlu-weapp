/**
 * pages/profile/index.wxss — 个人中心主页（阶段 2）
 * UI 基准 PersonalCenterScreen.kt；色值走 app.wxss 令牌（card-bg、ink-100、
 * text-primary、text-secondary、border-color、color-primary），secondary 橙 #d98a17 深浅同值可直用。
 * dp→rpx ×2：头像 88dp=176rpx、卡 r20dp=40rpx、卡内边距 20dp=40rpx、
 * 徽章 Hiking 13dp=26rpx、Tab 下划线 28×3dp=56×6rpx。
 */

.profile-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 32rpx 0;
  background: var(--page-bg);
  color: var(--text-primary);
}

/* ============ 通用卡（ProfileCard：surface 底 + r40 + outline 50% 描边，无阴影） ============ */

.pf-card {
  background: var(--card-bg);
  border-radius: 40rpx;
  border: 1rpx solid var(--border-color);
  padding: 40rpx;
}

/* ============ 首载骨架（Web animate-pulse 等价：透明度脉冲） ============ */

.pf-skel-avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: var(--ink-100);
  flex-shrink: 0;
  animation: pf-pulse 1.5s ease-in-out infinite;
}

.pf-skel-col {
  margin-left: 32rpx;
  padding-top: 8rpx;
}

.pf-skel-bar {
  border-radius: 8rpx;
  background: var(--ink-100);
  margin-bottom: 16rpx;
  animation: pf-pulse 1.5s ease-in-out infinite;
}

.pf-skel-bar:last-child {
  margin-bottom: 0;
}

@keyframes pf-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* ============ 未登录守门态 ============ */

.state-box {
  padding: 160rpx 32rpx;
}

.state-title {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 32rpx;
}

.state-btn {
  padding: 16rpx 56rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  color: var(--color-primary-content);
  font-size: 28rpx;
  font-weight: 500;
}

/* ============ 卡内错误态（HeaderCard profile==null 分支） ============ */

.pf-card-error {
  padding: 24rpx 0;
}

.pf-card-error-text {
  font-size: 28rpx;
  color: #d2503f; /* error 深浅同值 */
}

.pf-card-retry {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-primary);
}

/* ============ 用户信息卡（HeaderProfileContent L350-446） ============ */

.pf-header-top {
  align-items: flex-start;
}

/* 头像：6rpx surface 描边 + surfaceVariant 底（无头像时露出） */
.pf-avatar-box {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  border: 6rpx solid var(--card-bg);
  background: var(--ink-100);
  flex-shrink: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.pf-avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 占位人形：52dp=104rpx，onSurfaceVariant 40% 透明（图标本体已是 variant 色） */
.pf-avatar-ph {
  width: 104rpx;
  height: 104rpx;
  opacity: 0.4;
}

/* 信息列必须显式 flex column：块级子 view 默认拉满列宽（align-self 无效），
   徽章/元信息才可收缩包裹内容（对齐 Compose Column 默认 wrap） */
.pf-id-col {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-left: 32rpx;
}

/* 昵称 titleLarge Bold 单行省略（22/28sp 显式行高）；stretch 保通栏省略 */
.pf-name {
  align-self: stretch;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 56rpx;
}

/* 远行客徽章：secondary 10% 底 + 30% 描边胶囊（#d98a17 深浅同值） */
.pf-level-pill {
  align-self: flex-start;
  margin-top: 12rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(217, 138, 23, 0.1);
  border: 2rpx solid rgba(217, 138, 23, 0.3);
  gap: 6rpx;
}

.pf-level-icon {
  width: 32rpx; /* 26→32：追截图观感（图标 ink 略高于文字 ink，人形饱满）；源码 13dp 配 11sp 的比例在 28rpx 字下显小 */
  height: 32rpx;
}

.pf-level-text {
  font-size: 28rpx; /* 用户拍板：对齐 Android 截图实际观感（该机 fontScale≈1.3，11sp×1.3≈14.3sp）勿回改 22 */
  font-weight: 700;
  color: #d98a17;
  line-height: 42rpx; /* 16sp×1.3≈20.8sp；胶囊总高=42+2×6=54rpx(27dp)=Android 截图 26.8dp */
}

/* 个性签名：bodySmall 次要色，两行省略，行高 18sp；stretch 保通栏 */
.pf-bio {
  align-self: stretch;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: var(--text-secondary);
}

/* 元信息行：14dp 间距；图标 55% / 文字 75%（onSurfaceVariant 派生） */
.pf-meta {
  margin-top: 16rpx;
  gap: 28rpx;
}

.pf-meta-item {
  gap: 6rpx;
}

.pf-meta-icon {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.55;
}

.pf-meta-text {
  font-size: 22rpx;
  line-height: 32rpx; /* labelSmall 11/16sp */
  color: var(--text-secondary);
  opacity: 0.75;
}

/* 编辑资料：整宽 OutlinedButton（r12dp、outline 描边、primary 文案） */
.pf-edit-btn {
  margin-top: 32rpx;
  height: 80rpx;
  border-radius: 24rpx;
  border: 2rpx solid var(--border-color);
  color: var(--color-primary);
  font-size: 28rpx;
  font-weight: 500;
}

.pf-edit-btn-hover {
  background: rgba(31, 122, 92, 0.08);
}

/* 深色下按压反馈换深 primary 透明度（两段式，避免浅色透明用在深底过闷） */
.theme-dark .pf-edit-btn-hover {
  background: rgba(77, 169, 137, 0.12);
}

/* ============ 三 Tab 行（CenterTabRow L469-507） ============ */

.pf-tabs {
  margin-top: 32rpx;
}

.pf-tab {
  flex: 1;
  padding-bottom: 20rpx;
}

.pf-tab-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.pf-tab.on .pf-tab-label {
  font-weight: 700;
  color: var(--color-primary);
}

/* 选中下划线：56×6rpx r4，文字下 6dp 间距 */
.pf-tab-underline {
  width: 56rpx;
  height: 6rpx;
  margin-top: 12rpx;
  border-radius: 4rpx;
  background: transparent;
}

.pf-tab.on .pf-tab-underline {
  background: var(--color-primary);
}

.pf-tabs-divider {
  height: 1rpx;
  background: var(--border-color);
  opacity: 0.6;
}

/* ============ Tab 面板容器 ============ */

.pf-panel {
  margin-top: 24rpx;
}

/* ============ 旅程数据（StatsOverviewSection + ActivityChartCard，阶段 3） ============ */

/* 三卡 + 图表卡纵向间距 12dp（Column spacedBy(12.dp)） */
.pf-journey {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 统计骨架：104dp=208rpx 三条（ShimmerBox） */
.pf-stat-skel {
  height: 208rpx;
  animation: pf-pulse 1.5s ease-in-out infinite;
}

.pf-stat-card {
  padding: 36rpx;
  align-items: center;
}

.pf-stat-label {
  font-size: 22rpx;
  letter-spacing: 2.4rpx;
  color: var(--text-secondary);
  opacity: 0.8;
}

.pf-stat-value-row {
  align-items: flex-end;
  margin-top: 8rpx;
}

.pf-stat-value {
  font-size: 56rpx; /* headlineMedium */
  font-weight: 700;
  line-height: 1.1;
}

.pf-stat-unit {
  margin-left: 8rpx;
  padding-bottom: 10rpx; /* 5dp 基线补偿 */
  font-size: 24rpx;
  color: var(--text-secondary);
}

.pf-stat-sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  opacity: 0.8;
}

/* 图标底：40dp r12 + tint 12% alpha（三段式：默认浅 / 媒体深 / 类轨全量重声明） */
.pf-stat-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
}

.pf-stat-icon {
  width: 44rpx;
  height: 44rpx;
}

.pf-stat-icon-box.tint-primary {
  background: rgba(31, 122, 92, 0.12);
}

.pf-stat-icon-box.tint-secondary {
  background: rgba(217, 138, 23, 0.12);
}

.pf-stat-icon-box.tint-tertiary {
  background: rgba(74, 127, 165, 0.12);
}

/* 图表卡头：标题 + 本周/上周分段控件（Web select 的等价分段） */
.pf-chart-title {
  font-size: 32rpx;
  font-weight: 600;
}

.pf-week-seg {
  background: rgba(241, 237, 228, 0.6); /* surfaceVariant 60% */
  border-radius: 20rpx;
  padding: 6rpx;
}

.pf-week-opt {
  padding: 8rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.pf-week-opt.on {
  background: var(--card-bg);
  color: var(--color-primary);
  font-weight: 700;
  /* Android 白胶囊轻微投影（选中态凸起） */
  box-shadow: 0 2rpx 8rpx rgba(28, 25, 23, 0.1);
}

.pf-chart-body {
  margin-top: 32rpx;
}

.pf-chart-loading {
  height: 440rpx;
}

.pf-spin {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid var(--ink-100);
  border-top-color: var(--color-primary);
  animation: pf-spin 0.8s linear infinite;
}

@keyframes pf-spin {
  to {
    transform: rotate(360deg);
  }
}

.pf-chart-canvas {
  display: block;
}

/* ---- 深色三段式（媒体查询轨 + 类轨全量重声明） ---- */
@media (prefers-color-scheme: dark) {
  .pf-stat-icon-box.tint-primary {
    background: rgba(77, 169, 137, 0.12);
  }
  .pf-stat-icon-box.tint-tertiary {
    background: rgba(127, 168, 200, 0.12);
  }
  .pf-edit-btn-hover {
    background: rgba(77, 169, 137, 0.12);
  }
  .pf-week-seg {
    background: rgba(35, 32, 26, 0.6);
  }
}

.theme-dark .pf-stat-icon-box.tint-primary {
  background: rgba(77, 169, 137, 0.12);
}

.theme-dark .pf-stat-icon-box.tint-tertiary {
  background: rgba(127, 168, 200, 0.12);
}

.theme-dark .pf-week-seg {
  background: rgba(35, 32, 26, 0.6);
}

.theme-light .pf-stat-icon-box.tint-primary {
  background: rgba(31, 122, 92, 0.12);
}

.theme-light .pf-stat-icon-box.tint-secondary {
  background: rgba(217, 138, 23, 0.12);
}

.theme-light .pf-stat-icon-box.tint-tertiary {
  background: rgba(74, 127, 165, 0.12);
}

.theme-light .pf-edit-btn-hover {
  background: rgba(31, 122, 92, 0.08);
}

.theme-light .pf-week-seg {
  background: rgba(241, 237, 228, 0.6);
}

/* 进出场动画（近似 AnimatedContent：fadeIn 300ms + 上滑 24px） */
.pf-panel-inner {
  animation: pf-panel-in 300ms ease both;
}

@keyframes pf-panel-in {
  from {
    opacity: 0;
    transform: translateY(24px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.pf-panel-ph {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-secondary);
  opacity: 0.6;
}

/* ============ 底部预留（mini-player + 安全区） ============ */

.pf-bottom-space {
  height: calc(48rpx + var(--mini-player-height) + env(safe-area-inset-bottom));
}
