.pf-badge-wall {
  padding: 28rpx;
  border: 1rpx solid rgba(217, 138, 23, 0.55);
  border-radius: 44rpx;
  background: var(--card-bg);
  box-shadow: 0 4rpx 18rpx rgba(76, 53, 16, 0.06);
}

.pf-badge-wall-dark { border-color: rgba(217, 138, 23, 0.34); }

.pf-badge-heading, .pf-badge-heading-row, .pf-badge-actions,
.pf-medal-feature-top, .pf-medal-label-row, .pf-medal-row,
.pf-poster-themes, .pf-poster-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pf-badge-award {
  width: 70rpx;
  height: 70rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #fbbf24, #e75b16);
  box-shadow: 0 6rpx 14rpx rgba(234, 133, 12, 0.28);
  flex-shrink: 0;
}

.pf-badge-award image { width: 39rpx; height: 39rpx; }
.pf-badge-heading-text { flex: 1; min-width: 0; }
.pf-badge-heading-row, .pf-medal-label-row { flex-wrap: wrap; }
.pf-badge-heading-title { color: var(--text-primary); font-weight: 800; font-size: 28rpx; }
.pf-badge-count, .pf-medal-rarity {
  flex-shrink: 0;
  border-radius: 14rpx;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 800;
}
.pf-badge-count { color: var(--text-primary); background: rgba(217, 138, 23, 0.16); }
.pf-badge-summary { display: block; margin-top: 7rpx; color: var(--text-secondary); font-size: 20rpx; }

.pf-badge-actions { margin-top: 20rpx; justify-content: flex-end; }

.pf-badge-action, .pf-badge-filter {
  margin: 0;
  padding: 0 16rpx;
  height: 58rpx;
  line-height: 56rpx;
  border-radius: 18rpx;
  border: 1rpx solid transparent;
  font-size: 21rpx;
  font-weight: 700;
  white-space: nowrap;
  color: var(--text-primary);
}

.pf-badge-action::after, .pf-badge-filter::after { border: 0; }
.pf-badge-action { background: rgba(217, 138, 23, 0.12); border-color: rgba(217, 138, 23, 0.22); }
.pf-badge-action-poster { background: rgba(31, 122, 92, 0.12); border-color: rgba(31, 122, 92, 0.26); }
.pf-badge-action[disabled], .pf-badge-filter[disabled] { opacity: 0.6; }
.pf-badge-filter-scroll { margin: 23rpx 0 20rpx; white-space: nowrap; }
.pf-badge-filters { display: inline-flex; align-items: center; gap: 8rpx; }
.pf-badge-filter { background: var(--page-bg); height: 52rpx; line-height: 50rpx; }
.pf-badge-filter-active { background: #30251c; color: #fffbeb; }
.pf-badge-wall-dark .pf-badge-filter-active, .theme-dark .pf-poster-themes .pf-badge-filter-active {
  background: #fbbf24;
  color: #281903;
}

.pf-badge-state { padding: 20rpx 0; text-align: center; color: var(--text-secondary); font-size: 23rpx; }

.pf-medal {
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--medal-border);
  background: linear-gradient(140deg, var(--medal-start), #171315 57%, var(--medal-end));
  color: #fafaf9;
  min-width: 0;
}

.pf-medal-amber { --medal-start: #4a2408; --medal-end: #3f160d; --medal-border: #b97731; --medal-highlight: #ffd998; --medal-emblem: #f48b31; }
.pf-medal-jade { --medal-start: #073b2b; --medal-end: #082e30; --medal-border: #48a388; --medal-highlight: #a3f4d8; --medal-emblem: #4ee4b4; }
.pf-medal-violet { --medal-start: #25204b; --medal-end: #341542; --medal-border: #a97bd1; --medal-highlight: #f5c3ff; --medal-emblem: #d18dfa; }
.pf-medal-rose { --medal-start: #4a1c2c; --medal-end: #451d08; --medal-border: #ce8083; --medal-highlight: #ffd0cf; --medal-emblem: #ff9592; }
.pf-medal-teal { --medal-start: #103e39; --medal-end: #163928; --medal-border: #57b49d; --medal-highlight: #a8f4dc; --medal-emblem: #6ce6be; }
.pf-medal-gold { --medal-start: #402905; --medal-end: #352215; --medal-border: #d7a74b; --medal-highlight: #ffe497; --medal-emblem: #ffc847; }

.pf-medal-content { position: relative; z-index: 1; }
.pf-medal-feature {
  border-radius: 36rpx;
  padding: 24rpx;
  animation: pf-medal-aura 3.5s ease-in-out infinite;
}
.pf-medal-feature-top { gap: 18rpx; }
.pf-medal-feature-labels { flex: 1; min-width: 0; }
.pf-medal-glare {
  pointer-events: none;
  position: absolute;
  left: 0;
  top: -55%;
  width: 46%;
  height: 220%;
  background: linear-gradient(90deg, transparent, var(--medal-highlight), transparent);
  animation: pf-medal-sweep 3.4s cubic-bezier(0.4, 0, 0.2, 1) infinite both;
}
.pf-medal-feature .pf-medal-glare { animation-duration: 2.1s; }
.pf-medal-ring { position: relative; width: 111rpx; height: 111rpx; flex-shrink: 0; }
.pf-medal-ring-edge {
  position: absolute;
  inset: 0;
  border: 1rpx dashed var(--medal-highlight);
  border-radius: 50%;
  opacity: 0.65;
  animation: pf-medal-spin 12s linear infinite;
}
.pf-medal-emblem {
  width: 62rpx;
  height: 62rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(145deg, var(--medal-highlight), var(--medal-emblem));
  box-shadow: 0 5rpx 14rpx rgba(0, 0, 0, 0.3);
  animation: pf-medal-float 3s ease-in-out infinite;
}
.pf-medal-emblem image { width: 34rpx; height: 34rpx; }
.pf-medal-feature .pf-medal-emblem { width: 84rpx; height: 84rpx; border-radius: 28rpx; }
.pf-medal-feature .pf-medal-emblem image { width: 45rpx; height: 45rpx; }
.pf-medal-rarity { background: rgba(255, 255, 255, 0.13); color: var(--medal-highlight); }
.pf-medal-dimension { font-size: 19rpx; color: #ded7d3; }
.pf-medal-feature-title { display: block; margin: 7rpx 0; font-size: 33rpx; font-weight: 850; }
.pf-medal-engraving {
  display: inline-block;
  border-radius: 9rpx;
  background: rgba(0, 0, 0, 0.32);
  padding: 4rpx 9rpx;
  color: #b6f3dc;
  font-size: 19rpx;
  font-weight: 700;
}
.pf-medal-details { border-top: 1rpx solid rgba(255, 255, 255, 0.12); padding-top: 14rpx; margin-top: 17rpx; }
.pf-medal-description { display: block; font-size: 22rpx; color: #f5efeb; line-height: 1.55; }
.pf-medal-progress { overflow: hidden; height: 9rpx; border-radius: 999rpx; background: rgba(0, 0, 0, 0.42); margin-top: 14rpx; }
.pf-medal-progress view {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #fbd17a, #6ee7b7, #70e7e0);
  transition: width 380ms ease;
}
.pf-medal-foot {
  display: flex;
  justify-content: space-between;
  gap: 6rpx;
  margin-top: 9rpx;
  color: #e0d5ce;
  font-size: 18rpx;
}
.pf-medal-status { margin-left: auto; color: #a7f3d0; }
.pf-medal-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 18rpx;
}
.pf-medal-tile { padding: 18rpx; border-radius: 27rpx; }
.pf-medal-selected { box-shadow: 0 0 0 2rpx #fbbf24; }
.pf-medal-row { justify-content: space-between; }
.pf-medal-metric, .pf-medal-caption, .pf-medal-title { display: block; overflow: hidden; }
.pf-medal-metric { font-size: 19rpx; font-weight: 750; color: var(--medal-highlight); margin-top: 12rpx; }
.pf-medal-title { font-size: 25rpx; font-weight: 800; margin: 5rpx 0; }
.pf-medal-caption {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  min-height: 52rpx;
  line-height: 26rpx;
  color: #e0d5ce;
  font-size: 20rpx;
}

@keyframes pf-medal-sweep {
  0% { transform: translate(-160%, -20%) rotate(25deg); opacity: 0; }
  15%, 44% { opacity: 0.34; }
  48% { transform: translate(220%, 18%) rotate(25deg); }
  58%, 100% { transform: translate(265%, 25%) rotate(25deg); opacity: 0; }
}
@keyframes pf-medal-float {
  0%, 100% { transform: translateY(0) rotate(0); }
  50% { transform: translateY(-5rpx) scale(1.05) rotate(3deg); }
}
@keyframes pf-medal-aura {
  0%, 100% { box-shadow: 0 5rpx 24rpx rgba(245, 158, 11, 0.18), inset 0 0 25rpx rgba(255, 255, 255, 0.09); }
  50% { box-shadow: 0 8rpx 30rpx rgba(16, 185, 129, 0.26), inset 0 0 29rpx rgba(251, 191, 36, 0.20); }
}
@keyframes pf-medal-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) {
  .pf-medal-glare, .pf-medal-emblem, .pf-medal-ring-edge, .pf-medal-feature { animation: none; }
  .pf-medal-glare { display: none; }
}

.pf-poster-mask {
  position: fixed;
  inset: 0;
  z-index: 70;
  display: flex;
  justify-content: center;
  align-items: flex-end;
  background: rgba(0, 0, 0, 0.58);
}
.pf-poster-sheet {
  width: 100%;
  box-sizing: border-box;
  border-radius: 40rpx 40rpx 0 0;
  padding: 26rpx 28rpx calc(26rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
}
.pf-poster-heading { font-size: 32rpx; font-weight: 800; }
.pf-poster-themes, .pf-poster-actions { justify-content: center; margin-top: 19rpx; }
.pf-poster-canvas {
  display: block;
  width: min(65vw, 44vh, 286px);
  height: min(88.83vw, 60.13vh, 391px);
  margin: 18rpx auto 0;
  border-radius: 18rpx;
  background: #062d27;
}
.pf-poster-actions button { flex: 1; }
