<!--
  pages/discover — 专项特训（第二 Tab，工具化转型重构）
  发音急救箱 / 语境卡册书架 / 今日一测；三段静态骨架，无信息流无滚动容器
-->
<view class="train-container pb-page-bottom {{themeClass}}">

  <!-- ── 1. 发音急救箱（薄弱音素诊断卡） ── -->
  <view class="card aid-card col">
    <view class="row between w-full">
      <text class="t-h3 text-bold">发音急救箱</text>
      <text class="aid-tag">诊断</text>
    </view>
    <text class="aid-desc mt-3">系统诊断：你的 {{weakPhoneme}} 易混淆</text>
    <view class="aid-go center tap-scale" bindtap="onPhonemeGo">
      <text class="aid-go-text">立即攻克</text>
    </view>
  </view>

  <!-- ── 2. 语境卡册书架（两列网格） ── -->
  <view class="section-title mt-6 mb-3"><text class="t-h3 text-bold">语境卡册书架</text></view>
  <view class="shelf-grid">
    <view class="card book-card col" wx:for="{{books}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onBookTap">
      <view class="book-cover center">
        <image class="book-cover-ic" src="{{item.cover}}" mode="aspectFit" />
      </view>
      <text class="book-title ellipsis mt-2">《{{item.title}}》</text>
      <progress class="book-progress mt-2" percent="{{item.progress}}" stroke-width="6"
                activeColor="#1f7a5c" backgroundColor="rgba(0,0,0,0.08)" border-radius="3" />
      <text class="t-mini text-secondary mt-1">已练 {{item.progress}}%</text>
    </view>
  </view>

  <!-- ── 3. 今日一测（固定高度单卡，不滚动） ── -->
  <view class="daily-card col center">
    <text class="t-h2 text-bold">今日微剧场听写</text>
    <text class="t-caption text-secondary mt-2">一段 30 秒真实语境 · 听音记句 · 即时校对</text>
    <view class="daily-go center tap-scale {{testBusy ? 'is-busy' : ''}}" bindtap="onDailyTestTap">
      <view wx:if="{{testBusy}}" class="loading-spinner loading-spinner--sm loading-spinner--onbtn"></view>
      <text wx:else class="daily-go-text">开始测试</text>
    </view>
  </view>
</view>
