<!--
  pages/discover/index.wxml — 原声微流（SoundBite Reels · yuanlu 真实语料）

  结构：
    背景毛玻璃封面层（当前切片封面，加载失败回落品牌渐变）
    顶栏（ping 绿点 + 标题 + 沙箱语料徽章 | 日/月切换 + 计数）
    纵向 swiper（上下轻划切换切片；词级扫光句仅当前项点亮）
      · 话题 pills（节目名/主题/难度/会员专享）
      · 英文原句（词级卡拉OK，点词查词）
      · 中文译文 + 连读弱读 tip + 评测横幅
    右侧操作栏（播放/循环/倍速/透视/跟读/收藏）
    底部切换条（上一条 | 轻划提示 | 下一条）
    弹窗层（透视 bottom-sheet + vocabulary-modal + premium-modal）
-->
<view class="rl-page {{themeClass}}">

  <!-- ═══ 背景氛围层：双层交替模糊封面 + 遮罩（U1 & U2） ═══ -->
  <view class="rl-bg">
    <image wx:if="{{coverOk && bgUrlA}}"
           class="rl-bg-img {{bgSlot === 0 ? 'rl-bg-img--active' : 'rl-bg-img--inactive'}}"
           src="{{bgUrlA}}" mode="aspectFill" binderror="onCoverError" />
    <image wx:if="{{coverOk && bgUrlB}}"
           class="rl-bg-img {{bgSlot === 1 ? 'rl-bg-img--active' : 'rl-bg-img--inactive'}}"
           src="{{bgUrlB}}" mode="aspectFill" binderror="onCoverError" />
    <view class="rl-bg-mask" />
  </view>

  <!-- ═══ 顶栏 ═══ -->
  <view class="rl-header">
    <view class="rl-brand">
      <view class="rl-ping" />
      <text class="rl-brand-text">原声微流 • SoundBite Reels</text>
      <text wx:if="{{sourceLocal}}" class="rl-src-badge">沙箱语料</text>
    </view>
    <view class="rl-header-right">
      <view class="rl-theme-btn {{filterActive ? 'rl-filter-active' : ''}}" hover-class="rl-theme-btn--hover"
            aria-role="button" aria-label="{{filterActive ? '刷句筛选，已启用' : '刷句筛选'}}" bindtap="onOpenFilters">
        <image class="rl-filter-icon" src="{{filterActive ? (dark ? '/assets/icons/tune-primary-dark.svg' : '/assets/icons/tune-primary.svg') : (dark ? '/assets/icons/tune-variant-dark.svg' : '/assets/icons/tune-variant.svg')}}" />
      </view>
      <view class="rl-theme-btn" hover-class="rl-theme-btn--hover" bindtap="onToggleTheme">
        <text class="rl-theme-ic">{{dark ? '☀️' : '🌙'}}</text>
      </view>
      <text wx:if="{{sentenceNumber}}" class="rl-counter">第 {{sentenceNumber}} 句</text>
    </view>
  </view>

  <!-- ═══ 纵向轻划切片流 ═══ -->
  <view class="rl-swiper-wrap">
    <view wx:if="{{feedLoading}}" class="rl-feed-loading">
      <view class="rl-feed-spin" />
      <text class="rl-feed-loading-text">正在装载原声切片…</text>
    </view>
    <view wx:elif="{{feedState}}" class="rl-feed-loading rl-filter-empty">
      <text class="rl-sheet-title">{{feedState === 'empty' ? '没有符合条件的句子' : feedState === 'more' ? '本批暂无匹配句子' : '句子加载失败'}}</text>
      <view class="rl-filter-actions">
        <view class="rl-filter-link" bindtap="onClearFilters">清空筛选</view>
        <view wx:if="{{feedState === 'empty'}}" class="rl-filter-submit" bindtap="onOpenFilters">调整条件</view>
        <view wx:else class="rl-filter-submit" bindtap="onRetryFirstPage">{{feedState === 'more' ? '继续查找' : '重新加载'}}</view>
      </view>
    </view>
    <!-- DIY 下拉刷新（竖滑 swiper 手势不被原生 onPullDownRefresh 捕获） -->
    <view class="rl-pull-hint {{refreshReady ? 'rl-pull-hint--ready' : ''}}"
          style="opacity: {{pullShift > 0 || refreshing ? 1 : 0}}; transform: translateY({{pullHintY}}px)">
      <text>{{refreshing ? '↻ 正在刷新…' : refreshReady ? '↑ 释放刷新' : '↓ 下拉刷新'}}</text>
    </view>
    <swiper class="rl-swiper" vertical current="{{index}}" duration="{{swiperDuration}}"
            easing-function="easeOutCubic" bindchange="onSwiperChange" bindanimationfinish="onSwiperFinish"
            bindtouchstart="onPullTouchStart" bindtouchmove="onPullTouchMove"
            bindtouchend="onPullTouchEnd" bindtouchcancel="onPullTouchCancel">
      <swiper-item wx:for="{{reels}}" wx:for-item="reel" wx:for-index="ci" wx:key="id" item-id="{{reel.id}}">
        <view class="rl-center">

          <!-- 话题 pills：节目名 / 主题 / 难度 / 会员专享 -->
          <view class="rl-pills">
            <text class="rl-pill rl-pill--show">{{reel.showTitle}}</text>
            <text wx:if="{{reel.topic}}" class="rl-pill rl-pill--topic">{{reel.topic}}</text>
            <text wx:if="{{reel.difficulty}}" class="rl-pill rl-pill--diff">{{reel.difficulty}}</text>
            <text wx:if="{{reel.isExclusive}}" class="rl-pill rl-pill--vip">👑 会员专享</text>
          </view>

          <!-- 英文原句：词级卡拉OK扫光（U5：路径补丁收敛至当前 reel 项字段）+ 跟读逐词得分 + 句末回放我的发音按钮 -->
          <view class="rl-sentence">
            <block wx:if="{{reel.words.length > 0}}">
              <view
                wx:for="{{reel.words}}"
                wx:for-item="w"
                wx:for-index="wi"
                wx:key="wi"
                class="rl-word-wrap"
                data-wi="{{wi}}"
                data-word="{{w.word}}"
                bindtap="onWordTap">
                <text class="rl-word {{reel.swOn && reel.activeIdx === wi ? 'rl-word--cur' : reel.swOn && reel.pastIdx >= wi ? 'rl-word--past' : ''}}">{{w.word}}</text>
                <text wx:if="{{ci === index && evalWordScores[wi]}}" class="rl-word-score rl-word-score--{{evalWordScores[wi].tier}}">{{evalWordScores[wi].score}}</text>
              </view>
            </block>
            <block wx:elif="{{reel.tokens && reel.tokens.length > 0}}">
              <view
                wx:for="{{reel.tokens}}"
                wx:for-item="tok"
                wx:for-index="ti"
                wx:key="ti"
                class="rl-word-wrap"
                data-wi="{{ti}}"
                data-word="{{tok}}"
                bindtap="onWordTap">
                <text class="rl-word">{{tok}}</text>
                <text wx:if="{{ci === index && evalWordScores[ti]}}" class="rl-word-score rl-word-score--{{evalWordScores[ti].tier}}">{{evalWordScores[ti].score}}</text>
              </view>
            </block>
            <text wx:else class="rl-word" data-word="{{reel.textEn}}" bindtap="onWordTap">{{reel.textEn}}</text>
            <view
              wx:if="{{ci === index && evalUserAudioPath}}"
              class="rl-play-self {{playingUserAudio ? 'rl-play-self--on' : ''}}"
              hover-class="rl-play-self--hover"
              bindtap="onPlayUserAudio">
              <image class="rl-play-self-ic" src="{{playingUserAudio ? '/assets/icons/volume-up-white.svg' : '/assets/icons/volume-up-primary.svg'}}" />
            </view>
          </view>

          <!-- 中文译文 -->
          <text class="rl-zh" user-select>{{reel.textCn}}</text>

          <!-- 常驻发音机密琥珀胶囊（规范 ④ / 第 2 步） -->
          <view wx:if="{{reel.phoneticTip}}" class="rl-tip">
            <view class="rl-tip-head">
              <image class="rl-tip-ic" src="/assets/icons/volume-up-accent.svg" />
              <text class="rl-tip-label">发音机密</text>
            </view>
            <text class="rl-tip-text">{{reel.phoneticTip}}</text>
          </view>

          <!-- 跟读测评结果横幅（仅当前项；U4：含流利度 / 连读分项小标签） -->
          <view wx:if="{{ci === index && evalScore}}" class="rl-eval">
            <view class="rl-eval-head">
              <image class="rl-eval-ic" src="/assets/icons/check-circle-primary.svg" />
              <text class="rl-eval-title">跟读发音评分: {{evalScore}} 分</text>
            </view>
            <view wx:if="{{evalFluency || evalPronunciation || evalIntegrity || evalLinking}}" class="rl-eval-metrics">
              <text wx:if="{{evalFluency}}" class="rl-eval-metric">流利度 {{evalFluency}}%</text>
              <text wx:if="{{evalLinking}}" class="rl-eval-metric">连读 {{evalLinking}}</text>
              <text wx:if="{{evalPronunciation}}" class="rl-eval-metric">准确度 {{evalPronunciation}}%</text>
              <text wx:if="{{evalIntegrity}}" class="rl-eval-metric">完整度 {{evalIntegrity}}%</text>
            </view>
            <text class="rl-eval-fb">{{evalFeedback}}</text>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- ═══ 右侧竖排浮动操作栏 ═══ -->
  <view wx:if="{{clip}}" class="rl-rail">
    <!-- 播放 / 暂停 / 切片懒取中 -->
    <view class="rl-play {{audioLoading ? 'rl-play--loading' : ''}}" hover-class="{{audioLoading ? '' : 'rl-play--hover'}}" bindtap="onTogglePlay">
      <view wx:if="{{audioLoading}}" class="rl-play-spin" />
      <image wx:else class="rl-play-ic" src="{{playing ? '/assets/icons/pause-filled.svg' : '/assets/icons/play-filled.svg'}}" />
    </view>

    <!-- 单句循环 -->
    <view class="rl-act {{isLooping ? 'rl-act--loop' : ''}}" hover-class="rl-act--hover" bindtap="onToggleLoop">
      <image class="rl-act-ic" src="{{isLooping ? '/assets/icons/repeat-one-primary.svg' : (dark ? '/assets/icons/repeat-graydark.svg' : '/assets/icons/repeat-gray.svg')}}" />
    </view>

    <!-- 倍速 0.75x / 1.0x / 1.25x -->
    <view class="rl-act" hover-class="rl-act--hover" bindtap="onToggleRate">
      <text class="rl-rate-label">{{rateLabel}}</text>
    </view>

    <!-- 语言学深度透视（服务端四维分析） -->
    <view class="rl-act rl-act--ai" hover-class="rl-act--hover" bindtap="onDeepDive">
      <image class="rl-act-ic" src="/assets/icons/auto-awesome-primary.svg" />
    </view>

    <!-- 跟读录音测评（U4：录音中外圈扩散光环 + 脉冲 / 评测中 spinner） -->
    <view class="rl-act {{isEvaluating ? 'rl-act--rec rl-act--rec-pulse' : ''}}" hover-class="rl-act--hover" bindtap="onShadowing">
      <view wx:if="{{evalPhase === 'recording'}}" class="rl-rec-halo" />
      <view wx:if="{{evalPhase === 'processing'}}" class="rl-rec-spin" />
      <image wx:else class="rl-act-ic" src="{{isEvaluating ? '/assets/icons/mic-filled.svg' : (dark ? '/assets/icons/mic-tertiary-dark.svg' : '/assets/icons/mic-tertiary.svg')}}" />
    </view>

    <!-- 收藏到句子本（真实切片走服务端） -->
    <view class="rl-act {{isSaved ? 'rl-act--saved' : ''}}" hover-class="rl-act--hover" bindtap="onToggleBookmark">
      <image class="rl-act-ic" src="{{isSaved ? '/assets/icons/bookmark-filled-primary.svg' : (dark ? '/assets/icons/bookmark-tertiary-dark.svg' : '/assets/icons/bookmark-border.svg')}}" />
    </view>
  </view>

  <!-- ═══ 底部切片切换条（与轻划互通） ═══ -->
  <view wx:if="{{clip}}" class="rl-footer">
    <view class="rl-switch {{canPrev ? '' : 'rl-switch--off'}}" hover-class="{{canPrev ? 'rl-switch--hover' : ''}}" bindtap="onPrev">
      <image class="rl-switch-ic" src="{{dark ? '/assets/icons/keyboard-arrow-up-primary-dark.svg' : '/assets/icons/keyboard-arrow-up-gray.svg'}}" />
      <text class="rl-switch-text">上一条切片</text>
    </view>

    <text class="rl-hint">上下轻划切换 • 点击单词即查</text>

    <view class="rl-switch {{canNext || (feedRetry && !loadingMore) ? '' : 'rl-switch--off'}}" hover-class="{{canNext || (feedRetry && !loadingMore) ? 'rl-switch--hover' : ''}}" bindtap="onNext">
      <text class="rl-switch-text">{{canNext ? '下一条切片' : loadingMore ? '加载中…' : feedRetry ? '点击重试' : '下一条切片'}}</text>
      <image class="rl-switch-ic" src="{{dark ? '/assets/icons/keyboard-arrow-down-primary-dark.svg' : '/assets/icons/keyboard-arrow-down-gray.svg'}}" />
    </view>
  </view>

  <view wx:if="{{filterOpen}}" class="rl-mask" bindtap="onCloseFilters">
    <view class="rl-sheet rl-filter-sheet" catchtap="noop">
      <view class="rl-sheet-head">
        <text class="rl-sheet-title">刷句筛选</text>
        <view class="rl-filter-link" bindtap="onCloseFilters">取消</view>
      </view>
      <view wx:for="{{filterGroups}}" wx:for-item="group" wx:key="low" class="rl-filter-group">
        <text class="rl-filter-label">{{group.title}}</text>
        <view class="rl-filter-range">
          <label class="rl-filter-field">
            <text>{{group.lowLabel}}</text>
            <input type="number" placeholder="不限" value="{{filterDraft[group.low]}}" data-field="{{group.low}}" bindinput="onFilterInput" />
          </label>
          <label class="rl-filter-field">
            <text>{{group.highLabel}}</text>
            <input type="number" placeholder="不限" value="{{filterDraft[group.high]}}" data-field="{{group.high}}" bindinput="onFilterInput" />
          </label>
        </view>
        <text wx:if="{{filterError && filterErrorField === group.low}}" class="rl-filter-error">{{filterError}}</text>
      </view>
      <view class="rl-filter-group">
        <text class="rl-filter-label">节目难度（CEFR，可多选）</text>
        <view class="rl-levels">
          <view class="rl-level {{!filterDraft.level ? 'rl-level-selected' : ''}}" bindtap="onAllLevels">不限</view>
          <view wx:for="{{filterLevels}}" wx:key="*this" class="rl-level {{selectedLevels[item] ? 'rl-level-selected' : ''}}"
                data-level="{{item}}" bindtap="onFilterLevel">{{item}}</view>
        </view>
      </view>
      <view class="rl-filter-actions">
        <view class="rl-filter-link" bindtap="onResetFilterDraft">重置</view>
        <view class="rl-filter-submit" bindtap="onApplyFilters">应用筛选</view>
      </view>
    </view>
  </view>

  <!-- ═══ 深度透视 bottom-sheet ═══ -->
  <view wx:if="{{deepOpen}}" class="rl-mask" bindtap="onDeepClose">
    <view class="rl-sheet" catchtap="noop">
      <view class="rl-sheet-head">
        <view class="rl-sheet-title-row">
          <image class="rl-sheet-spark" src="/assets/icons/auto-awesome-primary.svg" />
          <text class="rl-sheet-title">原声语言学深度透视</text>
        </view>
        <view class="rl-sheet-x" bindtap="onDeepClose">
          <text class="rl-sheet-x-glyph">✕</text>
        </view>
      </view>

      <view class="rl-deep-quote">
        <text class="rl-deep-quote-label">剖析句子</text>
        <text class="rl-deep-quote-text" user-select>"{{deepSentence}}"</text>
      </view>

      <view wx:if="{{deepLoading}}" class="rl-deep-loading">
        <image class="rl-deep-loading-ic" src="/assets/icons/auto-awesome-amber.svg" />
        <text class="rl-deep-loading-text">正在解构连读规律与语调潜台词…</text>
      </view>

      <block wx:elif="{{deepAnalysis}}">
        <view wx:if="{{deepSource === 'fallback'}}" class="rl-deep-fallback-note">
          <text>服务暂不可用 · 基础速览</text>
        </view>

        <view class="rl-card rl-card--green">
          <view class="rl-card-head">
            <image class="rl-card-ic" src="/assets/icons/volume-up-primary-m.svg" />
            <text class="rl-card-title rl-card-title--green">连读、同化与弱读机密 (Connected Speech)</text>
          </view>
          <text class="rl-card-body" user-select>{{deepAnalysis.connectedSpeech}}</text>
        </view>

        <view class="rl-card rl-card--amber">
          <view class="rl-card-head">
            <image class="rl-card-ic" src="/assets/icons/lightbulb-accent.svg" />
            <text class="rl-card-title rl-card-title--amber">说话者语气与语用场合 (Tone & Nuance)</text>
          </view>
          <text class="rl-card-body" user-select>{{deepAnalysis.toneAndMood}}</text>
        </view>

        <view class="rl-card rl-card--blue">
          <view class="rl-card-head">
            <text class="rl-card-ic-emoji">💬</text>
            <text class="rl-card-title rl-card-title--blue">母语者地道同义替换 (Paraphrase)</text>
          </view>
          <text class="rl-card-body" user-select>{{deepAnalysis.paraphrase}}</text>
        </view>

        <view class="rl-card rl-card--plain">
          <text class="rl-card-title rl-card-title--plain">🎙️ 脱离中式发音秘诀:</text>
          <text class="rl-card-body rl-card-body--muted" user-select>{{deepAnalysis.speakingTip}}</text>
        </view>
      </block>

      <view class="rl-sheet-btn" hover-class="rl-sheet-btn--hover" bindtap="onDeepClose">
        <text class="rl-sheet-btn-text">掌握并返回</text>
      </view>
    </view>
  </view>

  <!-- ═══ 生词弹窗（A工程 成熟组件） ═══ -->
  <vocabulary-modal visible="{{wordModal.visible}}" word="{{wordModal.word}}"
                    dict-data="{{wordModal.dictData}}"
                    corpus-examples="{{wordModal.corpusExamples}}"
                    loading="{{wordModal.loading}}"
                    saving="{{wordModal.saving}}" is-saved="{{wordModal.isSaved}}"
                    episode-title="{{clip ? clip.showTitle : ''}}"
                    bind:close="onVocabClose" bind:save="onVocabSave"
                    bind:complete="onVocabComplete" bind:gopractice="onVocabGoPractice" />

  <!-- ═══ 句子笔记与标签完善抽屉 ═══ -->
  <sentence-tag-drawer sentence="{{drawerSentence}}" local="{{drawerLocal}}"
                       bind:close="onDrawerClose" bind:updated="onDrawerUpdated" />

  <!-- ═══ 会员转化弹窗（词典/生词/句子配额墙） ═══ -->
  <premium-modal visible="{{showPremiumModal}}" source="{{premiumSource}}" bind:close="onPremiumClose" />
</view>
