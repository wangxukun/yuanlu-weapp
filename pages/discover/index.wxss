/* 探索画廊（阶段 0 过渡态）：深浅色走根类令牌三段式（app.wxss / theme-dark / theme-light） */
.discover-container {
  padding: var(--page-padding);
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.gallery-hero {
  margin-top: 32rpx;
  padding: 48rpx 40rpx;
}

.gallery-desc {
  line-height: 1.7;
}

.gallery-chips {
  margin-top: 32rpx;
  flex-wrap: wrap;
  gap: 16rpx;
}

.gallery-chip {
  padding: 10rpx 28rpx;
  border-radius: var(--r-full);
  background-color: var(--primary-50);
  color: var(--primary-600);
  font-size: var(--font-caption);
}

.gallery-hint {
  letter-spacing: 2rpx;
}
