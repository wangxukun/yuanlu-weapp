/**
 * pages/discover/index.wxss — 原声微流（B工程 ReelsView.tsx 的 Tailwind v4 → WXSS）
 *
 * 映射口径：
 *   stone-*  → var(--ink-*)（远路暖纸中性，自动双态）
 *   emerald-*→ var(--primary-*) / var(--color-primary)（远青品牌色）
 *   amber-*  → var(--accent-*)（曙光橙）
 *   rose-500 → var(--error-500)；blue-* → --info 派生淡底
 *   玻璃拟态（white/90、stone-900/80 等 backdrop-blur）→ 本地半透明变量
 *   （backdrop-filter 小程序支持不稳，以实底半透明等效替代）
 *
 * 双轨暗色与 app.wxss 同构：基值(light) → @media dark 翻转 →
 * .theme-dark 手动覆盖 → .theme-light 手动浅色全量还原。
 */

/* ═══════════ 页面骨架与本地令牌（浅色基值） ═══════════ */
.rl-page {
  /* 玻璃面（B: bg-white/90 dark:bg-stone-900/80） */
  --rl-glass: rgba(255, 255, 255, 0.92);
  --rl-glass-border: rgba(227, 221, 207, 0.9);
  /* 品牌淡底 pill（B: bg-emerald-50/90 dark:bg-white/10） */
  --rl-green-tint: var(--primary-50);
  --rl-green-tint-border: var(--primary-100);
  /* 橙淡底（B: bg-amber-100/90 dark:bg-amber-500/20） */
  --rl-amber-tint: var(--accent-100);
  --rl-amber-tint-border: rgba(217, 138, 23, 0.45);
  /* 蓝淡底（B: bg-blue-50/70 dark:bg-blue-950/30，info 派生） */
  --rl-blue-tint: rgba(74, 127, 165, 0.12);
  --rl-blue-tint-border: rgba(74, 127, 165, 0.35);
  --rl-blue-fg: #3a6c94;
  /* 发音 tip / 评测横幅 / 底栏遮罩 */
  --rl-tip-bg: var(--accent-50);
  --rl-tip-border: rgba(217, 138, 23, 0.35);
  --rl-eval-bg: var(--primary-50);
  --rl-eval-border: rgba(46, 143, 111, 0.4);
  --rl-footer-bg: rgba(255, 255, 255, 0.82);
  --rl-solid-btn-bg: #221f18; /* B 底部主按钮 bg-stone-900 */
  /* 深析弹窗内引句卡 */
  --rl-quote-bg: var(--page-bg);

  position: relative;
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: var(--page-bg);
  color: var(--text-primary);
  overflow: hidden;
}

/* ═══════════ 双轨暗色（系统跟随） ═══════════ */
@media (prefers-color-scheme: dark) {
  .rl-page {
    --rl-glass: rgba(30, 27, 22, 0.78);
    --rl-glass-border: rgba(58, 52, 44, 0.9);
    --rl-green-tint: rgba(255, 255, 255, 0.1);
    --rl-green-tint-border: rgba(255, 255, 255, 0.16);
    --rl-amber-tint: rgba(217, 138, 23, 0.2);
    --rl-amber-tint-border: rgba(217, 138, 23, 0.4);
    --rl-blue-tint: rgba(74, 127, 165, 0.18);
    --rl-blue-tint-border: rgba(74, 127, 165, 0.4);
    --rl-blue-fg: #7fa8c8;
    --rl-tip-bg: rgba(0, 0, 0, 0.4);
    --rl-tip-border: rgba(255, 255, 255, 0.12);
    --rl-eval-bg: rgba(10, 36, 27, 0.6);
    --rl-eval-border: rgba(77, 169, 137, 0.4);
    --rl-footer-bg: rgba(0, 0, 0, 0.42);
    --rl-solid-btn-bg: #322d23;
    --rl-quote-bg: var(--page-bg);
  }
}

/* ═══════════ 手动深色（覆盖系统态） ═══════════ */
.rl-page.theme-dark {
  --rl-glass: rgba(30, 27, 22, 0.78);
  --rl-glass-border: rgba(58, 52, 44, 0.9);
  --rl-green-tint: rgba(255, 255, 255, 0.1);
  --rl-green-tint-border: rgba(255, 255, 255, 0.16);
  --rl-amber-tint: rgba(217, 138, 23, 0.2);
  --rl-amber-tint-border: rgba(217, 138, 23, 0.4);
  --rl-blue-tint: rgba(74, 127, 165, 0.18);
  --rl-blue-tint-border: rgba(74, 127, 165, 0.4);
  --rl-blue-fg: #7fa8c8;
  --rl-tip-bg: rgba(0, 0, 0, 0.4);
  --rl-tip-border: rgba(255, 255, 255, 0.12);
  --rl-eval-bg: rgba(10, 36, 27, 0.6);
  --rl-eval-border: rgba(77, 169, 137, 0.4);
  --rl-footer-bg: rgba(0, 0, 0, 0.42);
  --rl-solid-btn-bg: #322d23;
  --rl-quote-bg: var(--page-bg);
}

/* ═══════════ 手动浅色（系统深色下全量还原） ═══════════ */
.rl-page.theme-light {
  --rl-glass: rgba(255, 255, 255, 0.92);
  --rl-glass-border: rgba(227, 221, 207, 0.9);
  --rl-green-tint: var(--primary-50);
  --rl-green-tint-border: var(--primary-100);
  --rl-amber-tint: var(--accent-100);
  --rl-amber-tint-border: rgba(217, 138, 23, 0.45);
  --rl-blue-tint: rgba(74, 127, 165, 0.12);
  --rl-blue-tint-border: rgba(74, 127, 165, 0.35);
  --rl-blue-fg: #3a6c94;
  --rl-tip-bg: var(--accent-50);
  --rl-tip-border: rgba(217, 138, 23, 0.35);
  --rl-eval-bg: var(--primary-50);
  --rl-eval-border: rgba(46, 143, 111, 0.4);
  --rl-footer-bg: rgba(255, 255, 255, 0.82);
  --rl-solid-btn-bg: #221f18;
  --rl-quote-bg: var(--page-bg);
}

/* ═══════════ 背景氛围层 ═══════════ */
.rl-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 0;
  overflow: hidden;
  opacity: 0.3;
  /* 封面图加载失败时兜底的品牌渐变 */
  background: linear-gradient(160deg, rgba(46, 143, 111, 0.35), rgba(217, 138, 23, 0.25));
  pointer-events: none;
}

.rl-bg-img {
  width: 100%;
  height: 100%;
  filter: blur(52rpx);
  transform: scale(1.25);
}

.rl-bg-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--page-bg);
  opacity: 0.72;
}

/* ═══════════ 顶栏 ═══════════ */
.rl-header {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 40rpx 16rpx;
}

.rl-brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rl-ping {
  position: relative;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--primary-500);
}

.rl-ping::after {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--primary-500);
  animation: rl-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
}

@keyframes rl-ping {
  0% { transform: scale(1); opacity: 0.7; }
  75%, 100% { transform: scale(2.2); opacity: 0; }
}

.rl-brand-text {
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: var(--text-primary);
}

.rl-header-right {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.rl-theme-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rl-glass);
  border: 1rpx solid var(--rl-glass-border);
}

.rl-theme-btn--hover {
  opacity: 0.8;
}

.rl-theme-ic {
  font-size: 26rpx;
  line-height: 1;
}

.rl-counter {
  font-size: 24rpx;
  color: var(--text-tertiary);
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

/* ═══════════ 中央切片卡 ═══════════ */
.rl-center {
  position: relative;
  z-index: 10;
  height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 24rpx 48rpx;
  overflow: hidden;
}

.rl-pills {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.rl-pill {
  font-size: 20rpx;
  border-radius: 999rpx;
  line-height: 1.4;
}

.rl-pill--show {
  padding: 8rpx 20rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--rl-green-tint);
  border: 1rpx solid var(--rl-green-tint-border);
}

.rl-pill--topic {
  padding: 4rpx 16rpx;
  font-weight: 600;
  color: var(--text-secondary);
  background: var(--rl-glass);
}

.rl-pill--diff {
  padding: 4rpx 16rpx;
  font-weight: 700;
  color: var(--accent-500);
  background: var(--rl-amber-tint);
  border: 1rpx solid var(--rl-amber-tint-border);
}

/* ── 英文原句 · 词级卡拉OK（B: inline-block mr-1.5 rounded px-1） ── */
.rl-sentence {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.7;
  margin-bottom: 28rpx;
}

.rl-word {
  display: inline-block;
  margin-right: 12rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  color: var(--ink-700);
}

/* 当前词：琥珀实底 + 深字 + 微放大（B: bg-amber-300 text-stone-950 scale-105，深浅色同款实底） */
.rl-word--cur {
  background: var(--accent-300);
  color: var(--ink-950);
  font-weight: 900;
  transform: scale(1.06);
  box-shadow: 0 8rpx 20rpx rgba(236, 179, 94, 0.35);
}

/* 已读词：品牌绿（B: text-emerald-600 dark:text-emerald-400） */
.rl-word--past {
  color: var(--color-primary);
}

.rl-zh {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.7;
  color: var(--ink-600);
  margin-bottom: 36rpx;
}

/* ── 连读弱读机密 pill ── */
.rl-tip {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--rl-tip-bg);
  border: 1rpx solid var(--rl-tip-border);
  margin-bottom: 28rpx;
}

.rl-tip-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.rl-tip-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--accent-500);
}

/* ── 跟读测评横幅 ── */
.rl-eval {
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--rl-eval-bg);
  border: 1rpx solid var(--rl-eval-border);
  animation: rl-fade-in 0.25s ease-out;
}

.rl-eval-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.rl-eval-ic {
  width: 30rpx;
  height: 30rpx;
}

.rl-eval-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.rl-eval-fb {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--ink-600);
}

@keyframes rl-fade-in {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════ 右侧竖排浮动操作栏 ═══════════ */
.rl-rail {
  position: absolute;
  right: 32rpx;
  bottom: 148rpx;
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}

/* 主播放键（B: w-12 emerald-500 shadow-xl active:scale-95） */
.rl-play {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--primary-500);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(46, 143, 111, 0.4);
  transition: transform 0.12s ease;
}

.rl-play--hover {
  transform: scale(0.94);
}

.rl-play-ic {
  width: 44rpx;
  height: 44rpx;
  margin-left: 4rpx; /* B: Play 图标 ml-0.5 视觉居中 */
}

/* 小圆键（B: w-10） */
.rl-act {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--rl-glass);
  border: 1rpx solid var(--rl-glass-border);
  transition: transform 0.12s ease;
}

.rl-act--hover {
  transform: scale(0.92);
}

.rl-act-ic {
  width: 34rpx;
  height: 34rpx;
}

.rl-rate-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

/* 循环开启：橙淡底（B: bg-amber-100/90 text-amber-700） */
.rl-act--loop {
  background: var(--rl-amber-tint);
  border-color: var(--rl-amber-tint-border);
}

/* AI 深析：绿淡底（B: bg-emerald-50/90 text-emerald-600） */
.rl-act--ai {
  background: var(--rl-green-tint);
  border-color: var(--rl-green-tint-border);
}

/* 跟读评测中：陶土红实底白图标 + 脉冲（B: bg-rose-500 text-white animate-pulse） */
.rl-act--rec {
  background: var(--error-500);
  border-color: var(--error-500);
}

.rl-act--rec-pulse {
  animation: rl-pulse 1.2s ease-in-out infinite;
}

@keyframes rl-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* 已收藏：绿淡底（B: bg-emerald-100/90 text-emerald-700） */
.rl-act--saved {
  background: var(--rl-green-tint);
  border-color: var(--rl-green-tint-border);
}

/* ═══════════ 底部切片切换条 ═══════════ */
.rl-footer {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 48rpx;
  border-top: 1rpx solid var(--border-color);
  background: var(--rl-footer-bg);
}

.rl-switch {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.rl-switch--hover {
  opacity: 0.75;
}

.rl-switch--off {
  opacity: 0.3; /* B: disabled:opacity-30 */
}

.rl-switch-ic {
  width: 32rpx;
  height: 32rpx;
}

.rl-switch-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.rl-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

/* ═══════════ AI 深析 bottom-sheet ═══════════ */
.rl-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60; /* --z-sheet */
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  animation: rl-fade 0.2s ease-out;
}

@keyframes rl-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.rl-sheet {
  width: 100%;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 48rpx;
  background: var(--card-bg);
  border-radius: 48rpx 48rpx 0 0;
  overflow-y: auto;
  animation: rl-slide-up 0.25s ease-out;
}

@keyframes rl-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.rl-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.rl-sheet-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.rl-sheet-spark {
  width: 36rpx;
  height: 36rpx;
}

.rl-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.rl-sheet-x {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rl-sheet-x-glyph {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

/* 剖析句子卡 */
.rl-deep-quote {
  margin: 32rpx 0;
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--rl-quote-bg);
  border: 1rpx solid var(--border-color);
}

.rl-deep-quote-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--text-tertiary);
  margin-bottom: 10rpx;
}

.rl-deep-quote-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.7;
  color: var(--text-primary);
}

/* loading 态 */
.rl-deep-loading {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.rl-deep-loading-ic {
  width: 64rpx;
  height: 64rpx;
  animation: rl-bounce 0.9s ease-in-out infinite;
}

@keyframes rl-bounce {
  0%, 100% { transform: translateY(-20%); }
  50% { transform: translateY(15%); }
}

.rl-deep-loading-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.rl-deep-loading-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent-500);
  background: var(--rl-amber-tint);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* 四卡分析 */
.rl-card {
  padding: 28rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.rl-card-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.rl-card-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.rl-card-ic-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.rl-card-title {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.rl-card-title--green { color: var(--color-primary); }
.rl-card-title--amber { color: var(--accent-500); }
.rl-card-title--blue { color: var(--rl-blue-fg); }
.rl-card-title--plain { color: var(--text-primary); display: block; margin-bottom: 10rpx; }

.rl-card--green {
  background: var(--rl-green-tint);
  border: 1rpx solid var(--rl-green-tint-border);
}

.rl-card--amber {
  background: var(--rl-amber-tint);
  border: 1rpx solid var(--rl-amber-tint-border);
}

.rl-card--blue {
  background: var(--rl-blue-tint);
  border: 1rpx solid var(--rl-blue-tint-border);
}

.rl-card--plain {
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
}

.rl-card-body {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.7;
  color: var(--ink-600);
}

.rl-card-body--muted {
  color: var(--ink-600);
}

/* 底部主按钮 */
.rl-sheet-btn {
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: var(--rl-solid-btn-bg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.rl-sheet-btn--hover {
  opacity: 0.85;
}

.rl-sheet-btn-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ═══════════ 真实语料版新增 ═══════════ */

/* 首刷装载态（feed 拉取中） */
.rl-feed-loading {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: var(--page-bg);
}

.rl-feed-spin {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid var(--primary-100);
  border-top-color: var(--primary-500);
  animation: rl-spin 0.9s linear infinite;
}

@keyframes rl-spin {
  to { transform: rotate(360deg); }
}

.rl-feed-loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 沙箱语料徽章（后端不可达回落本地 mock 时） */
.rl-src-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  background: var(--rl-glass);
  border: 1rpx solid var(--rl-glass-border);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* 会员专享 pill */
.rl-pill--vip {
  padding: 4rpx 16rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, var(--accent-400), var(--accent-600));
  border-radius: 999rpx;
}

/* 纵向轻划 swiper（吃满中央区） */
.rl-swiper-wrap {
  position: relative;
  z-index: 10;
  flex: 1;
  min-height: 0;
}

.rl-swiper {
  width: 100%;
  height: 100%;
}

/* 播放键懒取 spinner（切片直链懒取中） */
.rl-play--loading {
  opacity: 0.9;
}

.rl-play-spin {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: rl-spin 0.9s linear infinite;
}

/* 深析服务不可用的兜底角标 */
.rl-deep-fallback-note {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.rl-deep-fallback-note text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}


/* ── DIY 下拉刷新提示条（竖滑 swiper 顶部跟手） ── */
.rl-pull-hint {
  position: absolute;
  top: 0;
  left: 50%;
  width: 240rpx;
  margin-left: -120rpx;
  padding: 12rpx 0 14rpx;
  border-radius: 0 0 28rpx 28rpx;
  text-align: center;
  font-size: 22rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.38);
  z-index: 30;
  pointer-events: none;
  transition: opacity 0.18s ease;
}

.rl-pull-hint--ready {
  background: var(--primary-600, #1f7a5c);
  font-weight: 700;
}
