/* pages/discover — 专项特训（第二 Tab）：三段静态骨架；根类自声明 color */
.train-container {
  min-height: 100vh;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
  color: var(--ink-900);
  background-color: var(--bg-page, var(--page-bg));
}

/* ── 1. 发音急救箱 ── */
.aid-card {
  padding: 36rpx 32rpx;
}
.aid-tag {
  padding: 6rpx 18rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--primary-100, rgba(47, 100, 84, 0.1));
  color: var(--primary-600);
  font-size: 22rpx;
}
.aid-desc {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-900);
}
.aid-go {
  align-self: flex-end;
  margin-top: 20rpx;
  padding: 16rpx 40rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--primary-600);
}
.aid-go-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ── 2. 语境卡册书架（两列网格） ── */
.shelf-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}
.book-card {
  padding: 24rpx;
  align-items: stretch;
}
.book-cover {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 20rpx;
  background-color: var(--primary-100, rgba(47, 100, 84, 0.1));
}
.book-cover-ic {
  width: 50%;
  height: 50%;
}
.book-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink-900);
}
.book-progress {
  width: 100%;
}

/* ── 3. 今日一测（固定高度单卡，不滚动）：深绿渐变底 + 纯白标题 + 半透白简介 ── */
.daily-card {
  height: 420rpx;
  margin-top: 48rpx;
  padding: 48rpx 40rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1f7a5c 0%, #155e46 100%);
  overflow: hidden;
}
.daily-tag {
  padding: 8rpx 24rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: rgba(255, 255, 255, 0.16);
}
.daily-tag-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.daily-title {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}
.daily-sub {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.6;
}
.daily-go {
  margin-top: 40rpx;
  padding: 24rpx 96rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.18);
}
.daily-go-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f7a5c;
}
