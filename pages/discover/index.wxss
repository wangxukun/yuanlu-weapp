/* 探索画廊（T4.2）：深浅色走根类令牌三段式 */
.discover-container {
  padding: var(--page-padding);
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* 搜索栏 */
.search-bar {
  margin-bottom: 24rpx;
}
.search-input-wrap {
  background-color: var(--card-bg);
  border-radius: var(--r-full);
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: var(--e1);
}
.search-icon-img {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}
.search-input {
  font-size: 28rpx;
  color: var(--text-primary);
}
.search-placeholder {
  color: var(--text-tertiary);
}
.search-clear {
  width: 48rpx;
  height: 48rpx;
}
.search-clear-ic {
  width: 28rpx;
  height: 28rpx;
  opacity: 0.5;
}

/* 场景胶囊栏 */
.chip-row {
  white-space: nowrap;
  margin-bottom: 8rpx;
}
.chip-row-inner {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}
.chip {
  flex-shrink: 0;
  padding: 10rpx 28rpx;
  border-radius: var(--r-full);
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
  color: var(--text-secondary);
  font-size: 24rpx;
}
.chip--on {
  background-color: var(--primary-600);
  border-color: var(--primary-600);
  color: #ffffff;
}

/* 主题专栏（横滑） */
.col-row {
  white-space: nowrap;
}
.col-row-inner {
  display: inline-flex;
  gap: 20rpx;
  padding: 8rpx 0;
}
.column-card {
  position: relative;
  width: 300rpx;
  height: 180rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  flex-shrink: 0;
}
.column-cover {
  position: absolute;
  width: 100%;
  height: 100%;
}
.column-shade {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(27, 24, 18, 0.08) 40%, rgba(27, 24, 18, 0.7) 100%);
}
.column-body {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 16rpx;
}
.column-name {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}
.column-count {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.8);
  font-size: 20rpx;
}

/* 声音明信片卡 */
.postcard {
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  height: 360rpx;
  margin-bottom: 24rpx;
}
.postcard-cover {
  position: absolute;
  width: 100%;
  height: 100%;
}
.postcard-shade {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(27, 24, 18, 0.06) 20%, rgba(27, 24, 18, 0.78) 100%);
}
.postcard-body {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
}
.postcard-tags {
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.postcard-pill {
  padding: 4rpx 18rpx;
  border-radius: var(--r-full);
  background-color: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 20rpx;
}
.postcard-en {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.45;
}
.postcard-zh {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
}
.postcard-foot {
  margin-top: 16rpx;
}
.postcard-play {
  gap: 8rpx;
}
.postcard-poster-ic {
  width: 30rpx;
  height: 30rpx;
  opacity: 0.85;
}
.postcard-poster-text {
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
}
.empty {
  padding: 100rpx 40rpx;
}

/* 日签海报弹层 */
.poster-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 70;
  background-color: rgba(27, 24, 18, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
}
.poster-card {
  width: 600rpx;
}
.poster-canvas {
  width: 600rpx;
  height: 860rpx;
  border-radius: var(--r-lg);
  background-color: #1b1812;
}
.poster-actions {
  gap: 20rpx;
  margin-top: 28rpx;
}
.poster-btn {
  min-width: 220rpx;
  height: 76rpx;
  border-radius: var(--r-full);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  color: #ffffff;
  font-size: 26rpx;
}
.poster-btn--main {
  background-color: var(--primary-600);
  border-color: var(--primary-600);
}
