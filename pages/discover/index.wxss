.discover-container {
  padding: var(--page-padding);
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ============ 搜索栏 ============ */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input-wrap {
  background-color: var(--card-bg);
  border-radius: var(--r-full);
  padding: 0 24rpx;
  height: 80rpx;
  box-shadow: var(--e1);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.5;
}

.search-input {
  font-size: 28rpx;
  height: 80rpx;
  line-height: 80rpx;
}

.clear-btn {
  padding: 8rpx 16rpx;
}

.clear-icon {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

/* ============ 区块标题 ============ */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  margin-top: 16rpx;
  padding: 8rpx 0;
}

/* ============ 双列网格 ============ */
.grid-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.grid-col {
  flex: 1;
  min-width: 0;
}

/* ============ 播客卡片（通用） ============ */
.podcast-card {
  display: flex;
  flex-direction: column;
}

.podcast-cover-wrap {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  border-radius: var(--r-lg);
  overflow: hidden;
}

.podcast-cover-square {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--ink-200);
  display: block;
}

/* ============ 热门榜排名徽章 ============ */
.rank-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(0, 0, 0, 0.2);
}

.rank-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #151310;
}

/* 金 */
.rank-0 { background-color: #DAA520; }
.rank-0 .rank-text { color: #151310; }

/* 银 */
.rank-1 { background-color: #B8BCC2; }
.rank-1 .rank-text { color: #151310; }

/* 铜 */
.rank-2 { background-color: #CD7F32; }
.rank-2 .rank-text { color: #fff; }

/* 其余 */
.rank-default { background-color: #44403C; }
.rank-default .rank-text { color: #fff; }

/* ============ 标签药丸 ============ */
.tag-pill {
  display: inline-flex;
  align-self: flex-start;
  background-color: var(--primary-100);
  padding: 4rpx 16rpx;
  border-radius: var(--r-full);
}

.pill-text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* ============ 新节目角标 ============ */
.new-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background-color: var(--color-primary);
  padding: 4rpx 16rpx;
  border-radius: var(--r-sm);
}

.new-badge-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
}

/* ============ 频道卡片 ============ */
.channel-card {
  width: 100%;
  aspect-ratio: 1 / 1;
  background-color: var(--primary-100);
  border-radius: var(--r-lg);
  padding: 24rpx;
  box-sizing: border-box;
}

.channel-name {
  color: var(--primary-800);
  text-align: center;
}

.channel-count {
  color: var(--primary-600);
  opacity: 0.7;
  text-align: center;
}

.channel-btn {
  background-color: var(--card-bg);
  padding: 12rpx 24rpx;
  border-radius: var(--r-full);
}

.channel-btn-text {
  color: var(--color-primary);
}

/* ============ 分类标签横滑 ============ */
.tag-scroll {
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 28rpx;
  border-radius: var(--r-full);
  background-color: var(--card-bg);
  border: 2rpx solid var(--border-color);
  transition: all 0.2s;
}

.filter-chip.active {
  background-color: var(--color-primary);
  border-color: var(--color-primary);
}

.filter-chip.active .chip-text {
  color: #fff;
}

.chip-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

/* ============ 空状态 ============ */
.empty-box {
  padding: 80rpx 0;
}

.error-box {
  padding: 80rpx 40rpx;
  min-height: 50vh;
}

/* ============ 骨架屏 ============ */
.skeleton-wrap {
  padding: 0;
}

.skeleton-search {
  height: 80rpx;
  border-radius: var(--r-full);
  margin-bottom: 32rpx;
}

.skeleton-grid {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.skeleton-card-wrap {
  flex: 1;
}

.skeleton-cover {
  width: 100%;
  aspect-ratio: 1 / 1;
  border-radius: var(--r-lg);
  margin-bottom: 16rpx;
}

.skeleton-line-short {
  width: 60%;
  height: 28rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.skeleton-line-tiny {
  width: 40%;
  height: 24rpx;
  border-radius: 8rpx;
}


