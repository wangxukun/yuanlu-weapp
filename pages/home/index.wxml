<wxs module="math">
module.exports = {
  round: function(num) { return Math.round(num); },
  ceil: function(num) { return Math.ceil(num); },
  floor: function(num) { return Math.floor(num); },
  padZero: function(num) { return num < 10 ? '0' + num : num; },
  formatBio: function(str) {
    if (!str) return '';
    return str.length > 15 ? str.substring(0, 15) + '...' : str;
  }
}
</wxs>
<view class="home-container pb-page-bottom {{themeClass}}">
  <!-- 未登录：整页登录引导态（tabBar 页等价 Web redirect("/")），
       图标与排布对齐 Web 端 PodcastAuthPrompt（标题上、大图标裸露、描述与按钮在下） -->
  <view wx:if="{{!isLoggedIn}}" class="guest-guide">
    <text class="guest-title t-h2">登录后开启你的远路</text>
    <image class="guest-icon" src="/assets/icons/podcasts-primary.svg" mode="aspectFit" />
    <text class="guest-desc t-caption">同步学习里程、生词本与句子本，多端进度实时一致。</text>
    <view class="btn-primary guest-btn tap-scale" bindtap="onGoLogin">去登录</view>
    <text class="guest-hint t-mini">支持手机验证码 / 邮箱密码登录</text>
  </view>

  <block wx:elif="{{isLoading}}">
    <view class="center" style="height: 50vh;">
      <view class="loading-spinner"></view>
    </view>
  </block>

  <block wx:elif="{{error}}">
    <view class="error-box">
      <text class="t-body">{{error}}</text>
      <button class="btn-primary mt-4" bindtap="fetchHomeData">重试</button>
    </view>
  </block>

  <block wx:else>
    <!-- 一、头部状态区 -->
    <view class="header between">
      <view class="header-left col">
        <text class="t-h1 text-bold ellipsis-2">{{greeting}}</text>
        <text class="t-body text-secondary ellipsis mt-1">{{math.formatBio(bio)}}</text>
      </view>
      <view class="streak-badge col center">
        <text class="status-text ellipsis">{{checkInStatus}}</text>
        <text class="streak-text">🔥 连续 {{streakDays}} 天</text>
      </view>
    </view>

    <!-- 本周里程卡 -->
    <view class="card mileage-card mt-4">
      <view class="between w-full">
        <text class="t-h3 text-bold">本周里程</text>
        <view class="mileage-badge {{mileage.weeklyProgress >= 0 ? 'positive' : 'negative'}} center px-2 py-1" style="border-radius: 50rpx; background: {{mileage.weeklyProgress >= 0 ? 'var(--primary-100)' : 'rgba(224, 64, 63, 0.12)'}};">
          <text class="t-mini text-bold" style="color: {{mileage.weeklyProgress >= 0 ? 'var(--primary-600)' : 'var(--error)'}};">{{mileage.weeklyProgress >= 0 ? '+' : ''}}{{mileage.weeklyProgress}}%</text>
        </view>
      </view>

      <view class="row align-bottom mt-3">
        <text class="t-display text-bold">{{math.round(mileage.kmCurrent * 10) / 10}}</text>
        <text class="t-body text-secondary ml-1 mb-1">/ {{mileage.kmGoal}} km</text>
      </view>

      <view class="progress-bar-bg mt-3">
        <view class="progress-bar-fill" style="width: {{(mileage.kmCurrent / mileage.kmGoal) * 100}}%;"></view>
      </view>

      <text class="t-mini text-secondary mt-2">{{mileage.remainingMins <= 0 ? '本周目标已达成，走得漂亮！' : '再走 ' + mileage.remainingMins + ' 分钟达成周目标'}}</text>

      <view class="between w-full mt-5">
        <text class="t-caption text-secondary">词汇路标</text>
        <text class="t-caption text-bold" style="color: var(--ink-800);">{{mileage.wordsCurrent}} / {{mileage.wordsGoal}}</text>
      </view>

      <view class="progress-bar-bg mt-2">
        <view class="progress-bar-fill" style="width: {{(mileage.wordsCurrent / mileage.wordsGoal) * 100}}%; background: #F5A623;"></view>
      </view>
    </view>

    <!-- 我的路 -->
    <view class="card road-card">
      <view class="between w-full mb-1">
        <text class="t-h3 text-bold">我的路</text>
        <text class="t-caption text-primary text-bold" bindtap="onOpenLearningPaths">查看学习路径 →</text>
      </view>
      <view class="journey-strip">
        <!-- 蜿蜒起伏的虚线小径背景 -->
        <image class="journey-curve-bg" src="/assets/icons/journey-curve.svg" mode="scaleToFill" />

        <!-- 7日节点 -->
        <block wx:for="{{journeyDays}}" wx:key="label">
          <view class="journey-node" style="left: {{item.x}}%; top: {{item.y}}%;">
            <!-- 学习日插小旗 (Android 规范: 曙光橙) -->
            <image class="node-flag" src="/assets/icons/journey-flag.svg" wx:if="{{item.minutes > 0}}" />

            <!-- 今天外层虚线圆环 (Android 规范: Accent400) -->
            <view class="today-halo" wx:if="{{item.isToday}}"></view>

            <!-- 节点圆圈: 学习日实心远青，未学习白底灰边 -->
            <view class="node-circle {{item.minutes > 0 ? 'studied' : 'unstudied'}}"></view>

            <!-- 日期文本: 随节点高低起伏，今天强调突出 -->
            <text class="node-label {{item.isToday ? 'today-label' : ''}}">{{item.isToday ? '今天' : item.label}}</text>
          </view>
        </block>
      </view>
    </view>

  </block>
</view>
