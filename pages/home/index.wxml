<!--
  pages/home — 远路语境词典 · 查词工具首页（工具化转型阶段一）
  巨型搜索框 + 灵感胶囊 + 4 纯工具入口；无搜索零内容零播放（合规口径）
-->
<view class="home-container pb-page-bottom {{themeClass}}">

  <!-- ── 顶部轻问候（登录态：问候+连续天数；游客：登录引导） ── -->
  <view class="tool-header between">
    <view class="col">
      <text class="t-h2 text-bold">{{greeting}}</text>
      <text class="t-caption text-secondary mt-1">查一个词，或描述你想练的场景</text>
    </view>
    <view wx:if="{{isLoggedIn}}" class="streak-pill center">
      <text class="streak-pill-text">🔥 {{streakDays}} 天</text>
    </view>
    <view wx:else class="login-btn center tap-scale" bindtap="onGoLogin">
      <text class="login-btn-text">登录</text>
    </view>
  </view>

  <!-- ── 巨型查词/场景搜索框（工具核心） ── -->
  <view class="hero-search row">
    <image class="hero-search-ic" src="/assets/icons/search.svg" />
    <input class="hero-search-input flex-1" value="{{query}}" bindinput="onSearchInput"
           placeholder="查一个词，或描述你想练的场景" placeholder-class="hero-search-ph"
           confirm-type="search" bindconfirm="onSearchConfirm" />
    <view wx:if="{{query}}" class="hero-search-clear center tap-scale" bindtap="onClearSearch">
      <image class="hero-search-clear-ic" src="/assets/icons/close.svg" />
    </view>
    <view class="hero-search-go center tap-scale" bindtap="onSearchConfirm">
      <text class="hero-search-go-text">查询</text>
    </view>
  </view>

  <!-- ── 灵感胶囊（随机标签 + 刷新） ── -->
  <view class="sug-row row">
    <view class="sug-chips row flex-1">
      <view class="sug-chip tap-scale" wx:for="{{suggestions}}" wx:key="label"
            data-item="{{item}}" bindtap="onSuggestionTap">{{item.label}}</view>
    </view>
    <view class="sug-refresh center tap-scale" bindtap="onRefreshSuggestions">
      <image class="sug-refresh-ic" src="/assets/icons/refresh-gray.svg" />
    </view>
  </view>

  <!-- ── 4 个纯工具入口 ── -->
  <view class="tool-grid row between">
    <view class="tool-item col center tap-scale" wx:for="{{tools}}" wx:key="key"
          data-key="{{item.key}}" bindtap="onToolTap">
      <view class="tool-icon-wrap center">
        <image class="tool-icon" src="{{item.icon}}" />
      </view>
      <text class="tool-label t-caption mt-2">{{item.label}}</text>
    </view>
  </view>

  <!-- ── 场景检索结果（仅搜索后渲染；无搜索零内容） ── -->
  <block wx:if="{{searchDone}}">
    <view wx:if="{{searching}}" class="center" style="padding: 96rpx 0;">
      <view class="loading-spinner"></view>
    </view>
    <block wx:elif="{{results.length > 0}}">
      <view class="section-title mt-6 mb-3"><text class="t-h3 text-bold">语境句</text></view>
      <view class="card result-card col" wx:for="{{results}}" wx:key="sceneid"
            data-scene="{{item.sceneid}}" bindtap="onResultTap">
        <view class="row between w-full">
          <text class="result-tag" wx:if="{{item.tag}}">{{item.tag}}</text>
          <text class="t-mini text-secondary">{{item.durText}}</text>
        </view>
        <text class="result-en ellipsis-2 mt-2">{{item.en}}</text>
        <text class="result-zh ellipsis mt-1" wx:if="{{item.zh}}">{{item.zh}}</text>
        <view class="row result-go mt-2">
          <image class="result-go-ic" src="/assets/icons/mic-ink.svg" />
          <text class="result-go-text">去跟读</text>
        </view>
      </view>
    </block>
    <view wx:else class="empty-tip col center">
      <text class="t-body text-secondary">没找到相关语境，换个说法试试</text>
    </view>
  </block>

  <!-- ── 查词记录抽屉（本地存储） ── -->
  <view wx:if="{{historyOpen}}" class="history-mask" bindtap="onHistoryClose">
    <view class="history-panel col" catchtap="noop">
      <view class="between w-full mb-3">
        <text class="t-h3 text-bold">查词记录</text>
        <view class="row">
          <text class="t-caption text-secondary mr-4" bindtap="onHistoryClear">清空</text>
          <image class="history-close-ic" src="/assets/icons/close.svg" bindtap="onHistoryClose" />
        </view>
      </view>
      <scroll-view class="history-scroll" scroll-y>
        <view wx:if="{{history.length === 0}}" class="empty-tip col center">
          <text class="t-body text-secondary">还没有查过词</text>
        </view>
        <view class="history-word row between" wx:for="{{history}}" wx:key="*this"
              data-word="{{item}}" bindtap="onHistoryWordTap">
          <text class="history-word-text">{{item}}</text>
          <text class="t-mini text-secondary">再查</text>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- ── 词典弹层（真实语境例句静态文本 + 前往跟读） ── -->
  <vocabulary-modal visible="{{wordModal.visible}}" word="{{wordModal.word}}"
                    dict-data="{{wordModal.dictData}}" corpus-examples="{{wordModal.corpusExamples}}"
                    loading="{{wordModal.loading}}"
                    saving="{{wordModal.saving}}" is-saved="{{wordModal.isSaved}}"
                    episode-title=""
                    bind:close="onVocabClose" bind:save="onVocabSave" bind:complete="onVocabComplete"
                    bind:gopractice="onVocabGoPractice" />

  <premium-modal visible="{{showPremiumModal}}" source="{{premiumSource}}" bind:close="onPremiumClose" />
</view>
