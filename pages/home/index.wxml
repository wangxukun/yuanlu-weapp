<wxs module="math">
module.exports = {
  round: function(num) { return Math.round(num); },
  ceil: function(num) { return Math.ceil(num); },
  floor: function(num) { return Math.floor(num); },
  padZero: function(num) { return num < 10 ? '0' + num : num; },
  formatBio: function(str) {
    if (!str) return '';
    return str.length > 15 ? str.substring(0, 15) + '...' : str;
  }
}
</wxs>
<view class="home-container pb-page-bottom-with-player">
  <!-- 未登录：整页登录引导态（tabBar 页等价 Web redirect("/")），
       图标与排布对齐 Web 端 PodcastAuthPrompt（标题上、大图标裸露、描述与按钮在下） -->
  <view wx:if="{{!isLoggedIn}}" class="guest-guide">
    <text class="guest-title t-h2">登录后开启你的远路</text>
    <image class="guest-icon" src="/assets/icons/podcast-primary.svg" mode="aspectFit" />
    <text class="guest-desc t-caption">同步收听记录、学习里程与个性化推荐，多端进度实时一致。</text>
    <view class="btn-primary guest-btn tap-scale" bindtap="onGoLogin">去登录</view>
    <text class="guest-hint t-mini">支持手机验证码 / 邮箱密码登录</text>
  </view>

  <block wx:elif="{{isLoading}}">
    <view class="center" style="height: 50vh;">
      <view class="loading-spinner"></view>
    </view>
  </block>
  
  <block wx:elif="{{error}}">
    <view class="error-box">
      <text class="t-body">{{error}}</text>
      <button class="btn-primary mt-4" bindtap="fetchHomeData">重试</button>
    </view>
  </block>

  <block wx:else>
    <!-- 一、头部状态区 -->
    <view class="header between">
      <view class="header-left col">
        <text class="t-h1 text-bold ellipsis-2">{{greeting}}</text>
        <text class="t-body text-secondary ellipsis mt-1">{{math.formatBio(bio)}}</text>
      </view>
      <view class="streak-badge col center">
        <text class="status-text ellipsis">{{checkInStatus}}</text>
        <text class="streak-text">🔥 连续 {{streakDays}} 天</text>
      </view>
    </view>

    <!-- 二、最近一次收听 (续播卡) -->
    <block wx:if="{{!latestHistory}}">
      <view class="card resume-card">
        <view class="empty-resume col">
          <text class="t-body text-secondary">还没有收听记录，今天从一期新节目开始第一步吧。</text>
          <button class="btn-discover tap-scale" bindtap="onGoDiscover">去发现页看看</button>
        </view>
      </view>
    </block>

    <!-- 顶部续播卡片（如果有最新历史） -->
    <block wx:if="{{latestHistory}}">
      <view class="card resume-card tap-scale mt-4" bindtap="onPlayEpisode" data-id="{{latestHistory.episode.id}}">
        <view class="col">
          <view class="cover-wrap">
            <image class="cover-image" src="{{latestHistory.episode.thumbnailUrl}}" mode="aspectFill" />
          </view>
          
          <text class="resume-eyebrow mt-3">继续收听</text>
          <text class="resume-title mt-1 ellipsis">{{latestHistory.episode.title}}</text>
          <text class="resume-subtitle mt-1 ellipsis">{{latestHistory.episode.category || latestHistory.episode.author || '6 Minute English'}}</text>
          
          <!-- 分割线 -->
          <view class="progress-bar-bg w-full mt-3">
            <view class="progress-bar-fill" style="width: {{(latestHistory.progressSeconds / (latestHistory.episode.durationSeconds || 1)) * 100}}%;"></view>
          </view>
          
          <view class="resume-footer between mt-3">
            <text class="resume-time-left ellipsis flex-1">还剩约 {{math.round((latestHistory.episode.durationSeconds - latestHistory.progressSeconds) / 60)}} 分钟</text>
            <view class="btn-resume tap-scale row center">
              <text class="btn-resume-icon">▶</text>
              <text class="btn-resume-text">继续 ({{math.floor(latestHistory.progressSeconds / 60)}}:{{math.padZero(math.floor(latestHistory.progressSeconds % 60))}})</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 本周里程卡 -->
    <view class="card mileage-card mt-4">
      <view class="between w-full">
        <text class="t-h3 text-bold">本周里程</text>
        <view class="mileage-badge {{mileage.weeklyProgress >= 0 ? 'positive' : 'negative'}} center px-2 py-1" style="border-radius: 50rpx; background: {{mileage.weeklyProgress >= 0 ? 'var(--primary-100)' : 'rgba(224, 64, 63, 0.12)'}};">
          <text class="t-mini text-bold" style="color: {{mileage.weeklyProgress >= 0 ? 'var(--primary-600)' : 'var(--error)'}};">{{mileage.weeklyProgress >= 0 ? '+' : ''}}{{mileage.weeklyProgress}}%</text>
        </view>
      </view>

      <view class="row align-bottom mt-3">
        <text class="t-display text-bold">{{math.round(mileage.kmCurrent * 10) / 10}}</text>
        <text class="t-body text-secondary ml-1 mb-1">/ {{mileage.kmGoal}} km</text>
      </view>

      <view class="progress-bar-bg mt-3">
        <view class="progress-bar-fill" style="width: {{(mileage.kmCurrent / mileage.kmGoal) * 100}}%;"></view>
      </view>

      <text class="t-mini text-secondary mt-2">{{mileage.remainingMins <= 0 ? '本周目标已达成，走得漂亮！' : '再走 ' + mileage.remainingMins + ' 分钟达成周目标'}}</text>

      <view class="between w-full mt-5">
        <text class="t-caption text-secondary">词汇路标</text>
        <text class="t-caption text-bold" style="color: var(--ink-800);">{{mileage.wordsCurrent}} / {{mileage.wordsGoal}}</text>
      </view>

      <view class="progress-bar-bg mt-2">
        <view class="progress-bar-fill" style="width: {{(mileage.wordsCurrent / mileage.wordsGoal) * 100}}%; background: #F5A623;"></view>
      </view>
    </view>

    <!-- 我的路 -->
    <view class="card road-card">
      <view class="between w-full mb-1">
        <text class="t-h3 text-bold">我的路</text>
        <text class="t-caption text-primary text-bold" bindtap="onOpenLearningPaths">查看学习路径 →</text>
      </view>
      <view class="journey-strip">
        <!-- 蜿蜒起伏的虚线小径背景 -->
        <image class="journey-curve-bg" src="/assets/icons/journey-curve.svg" mode="scaleToFill" />

        <!-- 7日节点 -->
        <block wx:for="{{journeyDays}}" wx:key="label">
          <view class="journey-node" style="left: {{item.x}}%; top: {{item.y}}%;">
            <!-- 学习日插小旗 (Android 规范: 曙光橙) -->
            <image class="node-flag" src="/assets/icons/journey-flag.svg" wx:if="{{item.minutes > 0}}" />
            
            <!-- 今天外层虚线圆环 (Android 规范: Accent400) -->
            <view class="today-halo" wx:if="{{item.isToday}}"></view>

            <!-- 节点圆圈: 学习日实心远青，未学习白底灰边 -->
            <view class="node-circle {{item.minutes > 0 ? 'studied' : 'unstudied'}}"></view>

            <!-- 日期文本: 随节点高低起伏，今天强调突出 -->
            <text class="node-label {{item.isToday ? 'today-label' : ''}}">{{item.isToday ? '今天' : item.label}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 继续收听列表 -->
    <block wx:if="{{continueListening.length > 0}}">
      <view class="section-title between mt-6 mb-3">
        <text class="t-h3 text-bold">继续收听</text>
        <text class="t-caption text-primary text-bold" bindtap="onOpenHistory">查看历史</text>
      </view>
      <scroll-view class="horizontal-scroll" scroll-x="true" show-scrollbar="false">
        <view class="scroll-row">
          <block wx:for="{{continueListening}}" wx:key="historyid">
            <view class="card continue-card row tap-scale" bindtap="onPlayEpisode" data-id="{{item.episode.id}}">
              <image class="continue-cover" src="{{item.episode.thumbnailUrl}}" mode="aspectFill" />
              <view class="col flex-1 ml-3">
                <text class="t-body text-bold ellipsis-2">{{item.episode.title}}</text>
                <text class="t-mini text-secondary ellipsis mt-1">{{item.episode.category || item.episode.author}}</text>
                <view class="row mt-2">
                  <view class="progress-bar-bg flex-1">
                    <view class="progress-bar-fill" style="width: {{(item.progressSeconds / (item.episode.durationSeconds || 1)) * 100}}%;"></view>
                  </view>
                  <text class="t-mini text-secondary ml-2">{{math.round((item.progressSeconds / (item.episode.durationSeconds || 1)) * 100)}}%</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>
    </block>

    <!-- 为你推荐 -->
    <block wx:if="{{recommended.length > 0}}">
      <view class="section-title mt-6 mb-3">
        <text class="t-h3 text-bold">为你推荐</text>
      </view>
      <view class="vertical-list">
        <block wx:for="{{recommended}}" wx:key="id">
          <view class="card episode-card-h row tap-scale" bindtap="onPlayEpisode" data-id="{{item.episodeid || item.id}}">
            <view class="episode-cover-wrap">
              <image class="episode-cover-169" src="{{item.coverUrl}}" mode="aspectFill" />
              <!-- 角标 -->
              <view class="episode-badge-tr" wx:if="{{item.difficulty}}">{{item.difficulty}}</view>
              <view class="episode-badge-br row center">
                <image class="badge-icon-clock" src="/assets/icons/clock.svg" />
                <text>{{item.duration ? math.ceil(item.duration / 60) : 0}} min</text>
              </view>
            </view>
            <view class="col flex-1 ml-3 between" style="height: 144rpx; padding-top: 4rpx; padding-bottom: 4rpx; box-sizing: border-box;">
              <view class="col">
                <text class="t-body text-bold ellipsis-2" style="line-height: 1.3;">{{item.title}}</text>
                <text class="t-caption text-secondary ellipsis mt-1">{{item.podcast.title || '单集播客'}}</text>
              </view>
              <view class="row between align-bottom w-full">
                <view class="row center text-secondary">
                  <image class="badge-icon-headphones" src="/assets/icons/headphones.svg" />
                  <text class="t-mini" style="margin-left: 4rpx;">{{item.playCount || 0}}</text>
                  <image class="badge-icon-lock" src="/assets/icons/lock.svg" wx:if="{{item.isExclusive}}" />
                </view>
                <view class="tag-pill" wx:if="{{item.tags && item.tags.length > 0}}">{{item.tags[0].name}}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- 最近发布 -->
    <block wx:if="{{latestEpisodes.length > 0}}">
      <view class="section-title mt-6 mb-3">
        <text class="t-h3 text-bold">最近发布</text>
      </view>
      <view class="vertical-list mb-6">
        <block wx:for="{{latestEpisodes}}" wx:key="id">
          <view class="card episode-card-h row tap-scale" bindtap="onPlayEpisode" data-id="{{item.episodeid || item.id}}">
            <view class="episode-cover-wrap">
              <image class="episode-cover-169" src="{{item.coverUrl}}" mode="aspectFill" />
              <view class="episode-badge-tr" wx:if="{{item.difficulty}}">{{item.difficulty}}</view>
              <view class="episode-badge-br row center">
                <image class="badge-icon-clock" src="/assets/icons/clock.svg" />
                <text>{{item.duration ? math.ceil(item.duration / 60) : 0}} min</text>
              </view>
            </view>
            <view class="col flex-1 ml-3 between" style="height: 144rpx; padding-top: 4rpx; padding-bottom: 4rpx; box-sizing: border-box;">
              <view class="col">
                <text class="t-body text-bold ellipsis-2" style="line-height: 1.3;">{{item.title}}</text>
                <text class="t-caption text-secondary ellipsis mt-1">{{item.podcast.title || '单集播客'}}</text>
              </view>
              <view class="row between align-bottom w-full">
                <view class="row center text-secondary">
                  <image class="badge-icon-headphones" src="/assets/icons/headphones.svg" />
                  <text class="t-mini" style="margin-left: 4rpx;">{{item.playCount || 0}}</text>
                  <image class="badge-icon-lock" src="/assets/icons/lock.svg" wx:if="{{item.isExclusive}}" />
                </view>
                <view class="tag-pill" wx:if="{{item.tags && item.tags.length > 0}}">{{item.tags[0].name}}</view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>

  </block>
</view>
