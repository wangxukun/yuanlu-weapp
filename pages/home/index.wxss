  color: var(--text-tertiary);
}

.st-rv-again {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  border-radius: 18rpx;
  background: var(--st-glass);
  border: 1rpx solid var(--st-glass-border);
  flex-shrink: 0;
}

.st-rv-again--hover {
  opacity: 0.8;
}

.st-rv-again-ic {
  font-size: 22rpx;
  line-height: 1;
}

.st-rv-again-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 翻转闪卡：正面浅底/背面深色（背面两外观同色，B 同款） */
.st-fc {
  border-radius: 28rpx;
  padding: 26rpx;
  border: 1rpx solid var(--st-amber-tint-border);
  background: linear-gradient(150deg, rgba(254, 243, 199, 0.7) 0%, var(--card-bg) 55%, var(--page-bg) 100%);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 背面双轨（2026-11-13 用户口径）：浅色模式弃深色——用与正面琥珀暖调
   明显区别的青绿冷调浅渐变；暗色模式保留原深色定妆。变量集中在
   .st-fc--back 上，子类只引用 --fcv-*，两套外观零重复。 */
.st-fc--back {
  --fcv-bg: linear-gradient(150deg, #ecfdf5 0%, #f0fdfa 55%, #eff6ff 100%);
  --fcv-bd: rgba(13, 148, 136, 0.45);
  --fcv-word: var(--text-primary);
  --fcv-def: #0f766e;
  --fcv-panel-bg: rgba(13, 148, 136, 0.08);
  --fcv-panel-bd: rgba(13, 148, 136, 0.2);
  --fcv-en: var(--text-primary);
  --fcv-zh: var(--text-secondary);
  --fcv-hook-bg: rgba(217, 138, 23, 0.1);
  --fcv-hook-bd: rgba(217, 138, 23, 0.32);
  --fcv-hook-fg: #57534e;
  --fcv-hook-strong: #b45309;
  --fcv-replay-bg: rgba(13, 148, 136, 0.12);
  --fcv-replay-bd: rgba(13, 148, 136, 0.25);
  --fcv-replay-hover: rgba(13, 148, 136, 0.22);
  --fcv-err-fg: #be123c;
  --fcv-err-bg: rgba(244, 63, 94, 0.12);
  --fcv-chip-fg: #b45309;
  --fcv-chip-bg: var(--st-amber-tint);
  --fcv-ret: #0f766e;
  --fcv-flip-fg: #0f766e;
  --fcv-flip-bg: rgba(13, 148, 136, 0.12);
  --fcv-fb-bd: var(--border-color);
  background: var(--fcv-bg);
  border-color: var(--fcv-bd);
}

@media (prefers-color-scheme: dark) {
  .st-fc--back {
    --fcv-bg: linear-gradient(150deg, #221f18 0%, #062e26 55%, #1a1408 100%);
    --fcv-bd: rgba(16, 185, 129, 0.4);
    --fcv-word: #ffffff;
    --fcv-def: #fcd34d;
    --fcv-panel-bg: rgba(255, 255, 255, 0.1);
    --fcv-panel-bd: rgba(255, 255, 255, 0.1);
    --fcv-en: #f5f5f4;
    --fcv-zh: #d6d3d1;
    --fcv-hook-bg: rgba(217, 138, 23, 0.15);
    --fcv-hook-bd: rgba(251, 191, 36, 0.3);
    --fcv-hook-fg: #e7e5e4;
    --fcv-hook-strong: #fcd34d;
    --fcv-replay-bg: rgba(255, 255, 255, 0.1);
    --fcv-replay-bd: rgba(255, 255, 255, 0);
    --fcv-replay-hover: rgba(255, 255, 255, 0.2);
    --fcv-err-fg: #fcd34d;
    --fcv-err-bg: rgba(251, 191, 36, 0.2);
    --fcv-chip-fg: #e7e5e4;
    --fcv-chip-bg: rgba(255, 255, 255, 0.1);
    --fcv-ret: #6ee7b7;
    --fcv-flip-fg: #6ee7b7;
    --fcv-flip-bg: rgba(16, 185, 129, 0.2);
    --fcv-fb-bd: rgba(255, 255, 255, 0.12);
  }
}

.st-page.theme-dark .st-fc--back {
  --fcv-bg: linear-gradient(150deg, #221f18 0%, #062e26 55%, #1a1408 100%);
  --fcv-bd: rgba(16, 185, 129, 0.4);
  --fcv-word: #ffffff;
  --fcv-def: #fcd34d;
  --fcv-panel-bg: rgba(255, 255, 255, 0.1);
  --fcv-panel-bd: rgba(255, 255, 255, 0.1);
  --fcv-en: #f5f5f4;
  --fcv-zh: #d6d3d1;
  --fcv-hook-bg: rgba(217, 138, 23, 0.15);
  --fcv-hook-bd: rgba(251, 191, 36, 0.3);
  --fcv-hook-fg: #e7e5e4;
  --fcv-hook-strong: #fcd34d;
  --fcv-replay-bg: rgba(255, 255, 255, 0.1);
  --fcv-replay-bd: rgba(255, 255, 255, 0);
  --fcv-replay-hover: rgba(255, 255, 255, 0.2);
  --fcv-err-fg: #fcd34d;
  --fcv-err-bg: rgba(251, 191, 36, 0.2);
  --fcv-chip-fg: #e7e5e4;
  --fcv-chip-bg: rgba(255, 255, 255, 0.1);
  --fcv-ret: #6ee7b7;
  --fcv-flip-fg: #6ee7b7;
  --fcv-flip-bg: rgba(16, 185, 129, 0.2);
  --fcv-fb-bd: rgba(255, 255, 255, 0.12);
}

.st-page.theme-light .st-fc--back {
  --fcv-bg: linear-gradient(150deg, #ecfdf5 0%, #f0fdfa 55%, #eff6ff 100%);
  --fcv-bd: rgba(13, 148, 136, 0.45);
  --fcv-word: var(--text-primary);
  --fcv-def: #0f766e;
  --fcv-panel-bg: rgba(13, 148, 136, 0.08);
  --fcv-panel-bd: rgba(13, 148, 136, 0.2);
  --fcv-en: var(--text-primary);
  --fcv-zh: var(--text-secondary);
  --fcv-hook-bg: rgba(217, 138, 23, 0.1);
  --fcv-hook-bd: rgba(217, 138, 23, 0.32);
  --fcv-hook-fg: #57534e;
  --fcv-hook-strong: #b45309;
  --fcv-replay-bg: rgba(13, 148, 136, 0.12);
  --fcv-replay-bd: rgba(13, 148, 136, 0.25);
  --fcv-replay-hover: rgba(13, 148, 136, 0.22);
  --fcv-err-fg: #be123c;
  --fcv-err-bg: rgba(244, 63, 94, 0.12);
  --fcv-chip-fg: #b45309;
  --fcv-chip-bg: var(--st-amber-tint);
  --fcv-ret: #0f766e;
  --fcv-flip-fg: #0f766e;
  --fcv-flip-bg: rgba(13, 148, 136, 0.12);
  --fcv-fb-bd: var(--border-color);
}

.st-fc-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-fc-meta-left,
.st-fc-meta-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.st-fc-err {
  font-size: 20rpx;
  font-weight: 800;
  color: #be123c;
  background: rgba(244, 63, 94, 0.12);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

.st-page.theme-dark .st-fc-err {
  color: #fda4af;
  background: rgba(244, 63, 94, 0.18);
}

.st-fc--back .st-fc-err {
  color: var(--fcv-err-fg);
  background: var(--fcv-err-bg);
}

.st-fc-curve {
  font-size: 20rpx;
  font-weight: 700;
  color: #b45309;
  background: var(--st-amber-tint);
  border-radius: 12rpx;
  padding: 4rpx 14rpx;
}

.st-page.theme-dark .st-fc-curve {
  color: #fcd34d;
}

.st-fc--back .st-fc-curve {
  color: var(--fcv-chip-fg);
  background: var(--fcv-chip-bg);
}

.st-fc-ret {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--text-tertiary);
}

.st-fc--back .st-fc-ret {
  color: var(--fcv-ret);
}

.st-fc-fliphint {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--st-seg-bg);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.st-fc--back .st-fc-fliphint {
  color: var(--fcv-flip-fg);
  background: var(--fcv-flip-bg);
}

/* 正面 */
.st-fc-front-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.st-fc-wordbox {
  min-width: 0;
  flex: 1;
}

.st-fc-wordrow {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-fc-word {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--text-primary);
  line-height: 1.15;
}

.st-fc-pos {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-500);
}

.st-fc-phon {
  display: flex;
  gap: 20rpx;
  margin-top: 6rpx;
  font-family: monospace;
}

.st-fc-phon text {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.st-fc-listen {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 22rpx;
  border-radius: 22rpx;
  background: var(--st-green-tint);
  flex-shrink: 0;
}

.st-fc-listen--hover {
  opacity: 0.8;
}

.st-fc-listen--on {
  background: #059669;
}

.st-fc-listen-ic {
  font-size: 24rpx;
  line-height: 1;
}

.st-fc-listen-text {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.st-fc-listen--on .st-fc-listen-text {
  color: #ffffff;
}

.st-fc-ctx {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
}

.st-fc-ctx-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.st-fc-ctx-label {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
}

.st-fc-ctx-sync {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
  flex-shrink: 0;
}

.st-fc-ctx-words {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx 8rpx;
}

.st-fc-cw {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.7;
}

.st-fc-cw--target {
  color: #b45309;
  font-weight: 800;
  text-decoration: underline;
  text-decoration-color: #f59e0b;
  text-decoration-thickness: 4rpx;
}

.st-page.theme-dark .st-fc-cw--target {
  color: #fcd34d;
}

.st-fc-cw--cur {
  color: #ffffff;
  background: #10b981;
  border-radius: 6rpx;
  /* 背景块两侧各扩 6rpx（视觉与原高亮一致），负 margin 抵消占位——
     高亮不改变词盒宽度，行内布局零位移（行尾词不会被挤换行） */
  padding: 0 6rpx;
  margin: 0 -6rpx;
  text-decoration: none;
}

.st-fc-hint {
  display: flex;
  justify-content: center;
}

.st-fc-hint-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-500);
}

/* 背面（双轨变量化：颜色全部走 --fcv-*，见 .st-fc--back 段） */
.st-fc-back-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.st-fc-back-wordrow {
  min-width: 0;
  flex: 1;
}

.st-fc-back-word {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--fcv-word);
}

.st-fc-back-def {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--fcv-def);
  margin-top: 4rpx;
}

.st-fc-replay {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: var(--fcv-replay-bg);
  border: 1rpx solid var(--fcv-replay-bd);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-fc-replay--hover {
  background: var(--fcv-replay-hover);
}

.st-fc-replay-ic {
  font-size: 26rpx;
  line-height: 1;
}

.st-fc-bilingual {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--fcv-panel-bg);
  border: 1rpx solid var(--fcv-panel-bd);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 背面语境句：与正面同款词级流式排布（听原声语境时逐词扫光） */
.st-fc-bi-en {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  gap: 4rpx 8rpx;
  line-height: 1.7;
}

.st-fc--back .st-fc-cw {
  color: var(--fcv-en);
}

.st-fc-bi-zh {
  font-size: 22rpx;
  color: var(--fcv-zh);
  line-height: 1.6;
}

.st-fc-hook {
  padding: 18rpx;
  border-radius: 20rpx;
  background: var(--fcv-hook-bg);
  border: 1rpx solid var(--fcv-hook-bd);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.st-fc-hook-row {
  font-size: 22rpx;
  color: var(--fcv-hook-fg);
  line-height: 1.7;
}

.st-fc-hook-strong {
  color: var(--fcv-hook-strong);
  font-weight: 800;
}

/* 三分反馈条 */
.st-fc-fb {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--border-color);
}

.st-fc--back .st-fc-fb {
  border-top-color: var(--fcv-fb-bd);
}

.st-fc-fb-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  padding: 14rpx 8rpx;
  border-radius: 20rpx;
}

.st-fc-fb-btn--hover {
  opacity: 0.8;
}

.st-fc-fb-btn--no {
  background: rgba(244, 63, 94, 0.1);
  border: 1rpx solid rgba(244, 63, 94, 0.3);
}

.st-fc-fb-btn--no .st-fc-fb-main {
  color: #e11d48;
}

.st-page.theme-dark .st-fc-fb-btn--no .st-fc-fb-main {
  color: #fda4af;
}

.st-fc-fb-btn--fuzzy {
  background: var(--st-amber-tint);
  border: 1rpx solid var(--st-amber-tint-border);
}

.st-fc-fb-btn--fuzzy .st-fc-fb-main {
  color: #b45309;
}

.st-page.theme-dark .st-fc-fb-btn--fuzzy .st-fc-fb-main {
  color: #fcd34d;
}

.st-fc-fb-btn--know {
  background: #059669;
  box-shadow: 0 4rpx 12rpx rgba(5, 150, 105, 0.3);
}

.st-fc-fb-btn--know .st-fc-fb-main {
  color: #ffffff;
}

.st-fc-fb-btn--know .st-fc-fb-sub {
  color: rgba(255, 255, 255, 0.9);
}

.st-fc-fb-main {
  font-size: 22rpx;
  font-weight: 800;
}

.st-fc-fb-sub {
  font-size: 18rpx;
  font-weight: 400;
  opacity: 0.8;
  color: var(--text-tertiary);
}

/* Real account progress: explicit guest/loading/error state, both themes. */
.st-dash-status {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  font-size: 22rpx;
  color: var(--text-secondary, #64748b);
}
.st-dash-status--error { color: #b45309; }

/* Real vocabulary review states and controls. */
.st-rv-state {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}
.st-rv-state--error { color: #b45309; }
.st-rv-audio-actions { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 0 24rpx 24rpx; }
.st-rv-source { display: block; margin-top: 12rpx; color: var(--text-tertiary); font-size: 20rpx; }
.st-rv-feedback-note { display: block; padding: 20rpx 24rpx; color: var(--text-secondary); font-size: 22rpx; }
.st-fc-fb--disabled { opacity: 0.5; }

/* 句末循环开关（英文句词流末尾 inline 小圆钮，仅活动卡显示） */
.st-clip-loop {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: var(--st-seg-bg);
  vertical-align: middle;
  margin-left: 12rpx;
}

.st-clip-loop--on {
  background: var(--st-green-tint);
}

.st-clip-loop-ic {
  width: 26rpx;
  height: 26rpx;
}

/* Live shadowing: microphone level, recoverable errors and real word scores. */
.st-shadow-controls { display: flex; align-items: center; gap: 24rpx; padding: 16rpx 0; color: var(--text-secondary); font-size: 24rpx; }
.st-shadow-meter { flex: 1; height: 12rpx; border-radius: 8rpx; overflow: hidden; background: var(--border-color); }
.st-shadow-meter > view { height: 100%; background: #10b981; transition: width 0.1s; }
.st-shadow-error { padding: 16rpx; color: #b45309; font-size: 24rpx; line-height: 1.6; }
.st-shadow-words { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.st-shadow-words-title { width: 100%; color: var(--text-secondary); font-size: 22rpx; }
.st-shadow-word { padding: 12rpx; border: 1rpx solid currentColor; border-radius: 14rpx; font-size: 24rpx; }
.st-shadow-word--good { color: #059669; }
.st-shadow-word--fair { color: #b45309; }
.st-shadow-word--weak { color: #e11d48; }
.st-shadow-phones { margin-top: 8rpx; font-size: 20rpx; }

/* ═══════════ 逐词发音胶囊 + 音素诊断面板（speech-eval 逐词纠错同款移植） ═══════════ */
.st-sh-words {
  display: flex;
  flex-direction: column;
}

.st-sh-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-sh-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-sh-replay {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--st-glass);
  border: 1rpx solid var(--st-glass-border);
}

.st-sh-replay--hover {
  opacity: 0.8;
}

.st-sh-replay-ic {
  font-size: 20rpx;
  line-height: 1;
  color: var(--color-primary);
}

.st-sh-replay-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

/* 流式单词胶囊（Flex Wrap + 85/60 双分界档位色 + 内联小号分数） */
.st-sh-chips {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 16rpx;
  gap: 16rpx;
}

.st-sh-chip {
  display: inline-flex;
  flex-direction: row;
  align-items: baseline;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--st-sh-bd);
  background: var(--st-sh-bg);
}

.st-sh-chip--good { --st-sh-bg: #edf7f2; --st-sh-fg: #1a6349; --st-sh-bd: #aedcc8; }
.st-sh-chip--mid { --st-sh-bg: #fdf4e7; --st-sh-fg: #96580d; --st-sh-bd: #ecb35e; }
.st-sh-chip--bad { --st-sh-bg: #fbefed; --st-sh-fg: #b8402f; --st-sh-bd: #de8577; }

.st-page.theme-dark .st-sh-chip--good { --st-sh-bg: rgba(10, 36, 27, 0.55); --st-sh-fg: #7dc5a8; --st-sh-bd: #164e3b; }
.st-page.theme-dark .st-sh-chip--mid { --st-sh-bg: rgba(46, 29, 7, 0.55); --st-sh-fg: #ecb35e; --st-sh-bd: #74440f; }
.st-page.theme-dark .st-sh-chip--bad { --st-sh-bg: rgba(42, 14, 9, 0.55); --st-sh-fg: #db6b5c; --st-sh-bd: #73271c; }

.st-sh-chip--sel {
  border-width: 4rpx;
  border-color: var(--primary-600);
}

.st-sh-chip-word {
  font-size: 28rpx;
  color: var(--st-sh-fg);
  line-height: 1.3;
}

.st-sh-chip--good .st-sh-chip-word { font-weight: 500; }
.st-sh-chip--mid .st-sh-chip-word,
.st-sh-chip--bad .st-sh-chip-word { font-weight: 600; }

/* 低分红波浪下划线（拼写检查同款，se-chip.bad 同款） */
.st-sh-chip-word--wavy {
  text-decoration: underline;
  text-decoration-color: #dc2626;
  text-decoration-style: wavy;
  text-underline-offset: 6rpx;
}

.st-sh-chip-score {
  font-size: 20rpx;
  font-weight: 700;
  font-family: Menlo, Consolas, monospace;
  color: var(--st-sh-fg);
  opacity: 0.75;
}

.st-sh-chip--click {
  transition: transform 0.15s ease;
}

.st-sh-chip--click:active {
  transform: scale(0.95);
}

.st-sh-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
  opacity: 0.8;
}

/* 音素诊断面板（浅灰绿底圆角卡，se-phoneme 同款） */
.st-sh-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--st-seg-bg);
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
}

.st-sh-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-sh-panel-title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.st-sh-panel-word {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

/* 美音/英音/原声/我 四路对比 pill */
.st-sh-pills {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 16rpx;
}

.st-sh-pill {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--st-glass);
  border: 1rpx solid var(--st-glass-border);
}

.st-sh-pill--hover {
  opacity: 0.8;
}

.st-sh-pill--on {
  background: var(--primary-600);
  border-color: var(--primary-600);
}

.st-sh-pill-text {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

.st-sh-pill-text--on {
  color: #ffffff;
  font-weight: 700;
}

/* 音素网格卡片（≥80 绿 / <80 红） */
.st-sh-phones {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-top: 24rpx;
  gap: 16rpx;
}

.st-sh-ph {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid rgba(46, 143, 111, 0.4);
  background: var(--st-green-tint);
}

.st-sh-ph--bad {
  border-color: rgba(220, 38, 38, 0.4);
  background: rgba(220, 38, 38, 0.08);
}

.st-sh-ph-ipa {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.st-sh-ph--bad .st-sh-ph-ipa {
  color: #dc2626;
}

.st-sh-ph-score {
  margin-top: 2rpx;
  font-size: 22rpx;
  color: var(--color-primary);
}

.st-sh-ph--bad .st-sh-ph-score {
  color: #dc2626;
  font-weight: 700;
}

/* 背面语境句无词级数据时的纯文本兜底（容器 flex 化后文本态需复位） */
.st-fc-bi-en--plain {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--fcv-en);
}

/* ═══ 背面补丁（2026-11-13）：目标词强调；听音按钮与正面完全同款 ═══ */
/* 变量补充段（后定义覆盖同名变量）：目标词色（正面同款琥珀） */
.st-fc--back {
  --fcv-target: #b45309;
}

@media (prefers-color-scheme: dark) {
  .st-fc--back {
    --fcv-target: #fcd34d;
  }
}

.st-page.theme-dark .st-fc--back {
  --fcv-target: #fcd34d;
}

.st-page.theme-light .st-fc--back {
  --fcv-target: #b45309;
}

/* ① 背面语境句目标词：颜色与下划线恢复生效——
   .st-fc--back .st-fc-cw 基础色双类选择器曾压过单类 --target */
.st-fc--back .st-fc-cw--target {
  color: var(--fcv-target);
}

/* ② 背面「听单词/听原声语境」按钮：与正面完全同款（绿浅底、无边框、
   无阴影——曾试白底+描边+投影增强对比，用户裁决回归正面样式） */

/* 榜「挑战同款」追加的加练句徽章（不计通关口径） */
.st-dc-bonus {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: #b45309;
  background: var(--st-amber-tint, rgba(217, 138, 23, 0.14));
  border: 1rpx solid rgba(217, 138, 23, 0.4);
  border-radius: 12rpx;
  padding: 2rpx 10rpx;
}


/* T3：跟读接力 tab 待接棒角标（B 规格玫红，>0 才显示） */
.st-tab-badge {
  position: absolute;
  top: 0;
  right: 14rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #d2503f;
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 700;
  line-height: 30rpx;
  text-align: center;
}


/* T10：未登录兜底演示房标识（防假分误解，登录后真实房无此标） */
.st-room-demo {
  flex-shrink: 0;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(232, 227, 217, 0.75);
  background: rgba(232, 227, 217, 0.14);
  border: 1rpx solid rgba(232, 227, 217, 0.3);
  border-radius: 10rpx;
  padding: 2rpx 10rpx;
}

/* T12：录第 1 棒评测草稿面板 */
.st-rl-draft{width:100%;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;gap:14rpx;padding:24rpx;border-radius:24rpx;background:rgba(31,122,92,0.14);border:1rpx solid rgba(31,122,92,0.4)}
.st-rl-draft-score{display:flex;align-items:baseline;gap:8rpx}
.st-rl-draft-score-n{font-size:56rpx;font-weight:800;color:#ffffff}
.st-rl-draft-score-u{font-size:22rpx;color:rgba(232,227,217,0.7)}
.st-rl-draft-tip{font-size:20rpx;line-height:1.6;color:rgba(232,227,217,0.55);text-align:center}
.st-rl-draft-actions{display:flex;gap:16rpx;width:100%}
.st-rl-draft-btn{flex:1;box-sizing:border-box;padding:14rpx 0;border-radius:20rpx;text-align:center;font-size:22rpx;font-weight:700;color:#ffffff;background:rgba(0,0,0,0.32)}
.st-rl-draft-btn--hover{opacity:0.72}
.st-rl-draft-btn--go{flex:1.1;background:linear-gradient(100deg,var(--primary-600),#2f9e8a)}
.st-rl-draft-discard{font-size:20rpx;color:rgba(232,227,217,0.45);text-decoration:underline}

/* 草稿态：提示文案与领读评分卡改上下布局（评分卡整宽不再与长文案左右互挤） */
.st-rl-drawer-foot--draft {
  flex-direction: column;
  align-items: stretch;
}
.st-rl-drawer-foot--draft .st-rl-drawer-foot-note {
  width: 100%;
}

/* 发起人撤销入口（仅招募中的自己房） */
.st-room-cancel {
  padding: 8rpx 18rpx;
  border-radius: 18rpx;
  background: rgba(210, 80, 63, 0.1);
  border: 1rpx solid rgba(210, 80, 63, 0.35);
}
.st-room-cancel--hover {
  opacity: 0.7;
}
.st-room-cancel-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--error-500);
}
