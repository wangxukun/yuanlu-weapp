}

.st-lb-rank--1 {
  background: #fbbf24;
}

.st-lb-rank--1 text {
  color: #1c1917;
}

.st-lb-rank--2 {
  background: #d6d3d1;
}

.st-lb-rank--2 text {
  color: #1c1917;
}

.st-lb-rank--3 {
