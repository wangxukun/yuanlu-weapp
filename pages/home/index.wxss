/**
 * pages/home/index.wxss — 原声心念工坊（B工程 AIStudioView「自由定制」首期
 * 的 Tailwind v4 → WXSS）
 *
 * 映射口径与 pages/discover 同构：stone→ink / emerald→primary / amber→accent，
 * 玻璃拟态与淡底用本地变量，双轨暗色四段式（基值 → @media → .theme-dark →
 * .theme-light）。方案头卡为 B 固定深色渐变（两种外观下同色，不走令牌）。
 */

/* ═══════════ 页面骨架与本地令牌（浅色基值） ═══════════ */
.st-page {
  --st-glass: rgba(255, 255, 255, 0.92);
  --st-glass-border: rgba(227, 221, 207, 0.9);
  --st-green-tint: var(--primary-50);
  --st-green-tint-border: var(--primary-100);
  --st-amber-tint: var(--accent-100);
  --st-amber-tint-border: rgba(217, 138, 23, 0.45);
  --st-blue-tint: rgba(74, 127, 165, 0.12);
  --st-blue-tint-border: rgba(74, 127, 165, 0.35);
  --st-blue-fg: #3a6c94;
  --st-seg-bg: var(--ink-100); /* tab 栏底（B bg-stone-100） */

  padding: 24rpx 32rpx 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--page-bg);
  color: var(--text-primary);
}

/* ═══════════ 双轨暗色 ═══════════ */
@media (prefers-color-scheme: dark) {
  .st-page {
    --st-glass: rgba(30, 27, 22, 0.78);
    --st-glass-border: rgba(58, 52, 44, 0.9);
    --st-green-tint: rgba(255, 255, 255, 0.1);
    --st-green-tint-border: rgba(255, 255, 255, 0.16);
    --st-amber-tint: rgba(217, 138, 23, 0.2);
    --st-amber-tint-border: rgba(217, 138, 23, 0.4);
    --st-blue-tint: rgba(74, 127, 165, 0.18);
    --st-blue-tint-border: rgba(74, 127, 165, 0.4);
    --st-blue-fg: #7fa8c8;
    --st-seg-bg: rgba(35, 32, 26, 0.8);
  }
}

.st-page.theme-dark {
  --st-glass: rgba(30, 27, 22, 0.78);
  --st-glass-border: rgba(58, 52, 44, 0.9);
  --st-green-tint: rgba(255, 255, 255, 0.1);
  --st-green-tint-border: rgba(255, 255, 255, 0.16);
  --st-amber-tint: rgba(217, 138, 23, 0.2);
  --st-amber-tint-border: rgba(217, 138, 23, 0.4);
  --st-blue-tint: rgba(74, 127, 165, 0.18);
  --st-blue-tint-border: rgba(74, 127, 165, 0.4);
  --st-blue-fg: #7fa8c8;
  --st-seg-bg: rgba(35, 32, 26, 0.8);
}

.st-page.theme-light {
  --st-glass: rgba(255, 255, 255, 0.92);
  --st-glass-border: rgba(227, 221, 207, 0.9);
  --st-green-tint: var(--primary-50);
  --st-green-tint-border: var(--primary-100);
  --st-amber-tint: var(--accent-100);
  --st-amber-tint-border: rgba(217, 138, 23, 0.45);
  --st-blue-tint: rgba(74, 127, 165, 0.12);
  --st-blue-tint-border: rgba(74, 127, 165, 0.35);
  --st-blue-fg: #3a6c94;
  --st-seg-bg: var(--ink-100);
}

/* ═══════════ 顶部模块（B Top Header） ═══════════ */
.st-header {
  margin-bottom: 24rpx;
}

.st-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.st-brand {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.st-brand-ic {
  width: 28rpx;
  height: 28rpx;
}

.st-brand-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.st-header-badge {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  background: var(--st-glass);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.st-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  color: var(--text-primary);
  margin-top: 8rpx;
}

.st-desc {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

/* ═══════════ 底部模块：四格分段 tab（B Mode Navigation Tabs） ═══════════ */
.st-tabs {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  background: var(--st-seg-bg);
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.st-tab {
  position: relative; /* T3：角标定位上下文 */
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
}

.st-tab--on {
  background: var(--card-bg);
  box-shadow: var(--e1);
}

.st-tab--hover {
  opacity: 0.8;
}

.st-tab-ic {
  font-size: 26rpx;
  line-height: 1;
}

.st-tab-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  white-space: nowrap;
}

.st-tab--on .st-tab-label {
  color: var(--color-primary);
}

.st-tab-body {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  animation: st-fade-in 0.2s ease-out;
}

@keyframes st-fade-in {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* ═══════════ 想法输入卡（B Idea Input Card） ═══════════ */
.st-card {
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 48rpx;
  box-shadow: var(--e1);
}

.st-input-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.st-textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 32rpx;
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
  font-size: 24rpx;
  color: var(--text-primary);
  min-height: 96rpx;
}

.st-textarea-ph {
  color: var(--text-tertiary);
}

.st-input-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap; /* 六档难度 + 生成键窄屏兜底换行 */
}

.st-levels {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.st-level {
  padding: 6rpx 14rpx; /* 六档并排收紧（A1–C2） */
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--text-tertiary);
  background: var(--st-seg-bg);
}

.st-level--on {
  background: var(--primary-600);
  color: #ffffff;
}

.st-level--hover {
  opacity: 0.8;
}

/* 生成按钮（B emerald→teal 渐变） */
.st-gen-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, var(--primary-600), #2f9e8a);
  box-shadow: 0 12rpx 28rpx rgba(31, 122, 92, 0.25);
}

.st-gen-btn--off {
  opacity: 0.5;
}

.st-gen-btn--hover {
  opacity: 0.9;
}

.st-gen-ic {
  width: 26rpx;
  height: 26rpx;
}

.st-gen-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.st-gen-spin {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  animation: st-spin 0.9s linear infinite;
}

@keyframes st-spin {
  to { transform: rotate(360deg); }
}

/* 灵感预设（动态：两列网格 + 刷新按钮） */
.st-preset-wrap {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.st-preset-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.st-preset-label {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

.st-preset-refresh {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--st-seg-bg);
  border: 1rpx solid var(--border-color);
}

.st-preset-refresh--hover {
  opacity: 0.7;
}

.st-preset-refresh-ic {
  font-size: 28rpx;
  color: var(--color-primary);
  font-weight: 700;
}

.st-preset-refresh-spin {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(46, 143, 111, 0.2);
  border-top-color: var(--color-primary);
  animation: st-spin 0.9s linear infinite;
}

/* 两列网格（3 行 × 2 列） */
.st-preset-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.st-preset {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 0;
  width: calc(50% - 6rpx); /* 两列等宽 */
  box-sizing: border-box;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--st-seg-bg);
}

.st-preset--hover {
  background: var(--st-green-tint);
}

.st-preset-icon {
  font-size: 22rpx;
}

.st-preset-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  max-width: 280rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ═══════════ 方案输出（B Generated Study Plan） ═══════════ */
.st-plan {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 头卡：B 固定深色渐变（双外观同色） */
.st-plan-head {
  position: relative;
  padding: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(150deg, #10312a 0%, #221f18 55%, #151310 100%);
  border: 1rpx solid rgba(46, 143, 111, 0.35);
  box-shadow: var(--e2);
  overflow: hidden;
}

.st-plan-head-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.st-plan-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #221f18;
  background: var(--accent-400);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.st-plan-theme {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  flex: 1;
  min-width: 0;
}

.st-plan-overview {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: rgba(232, 227, 217, 0.85);
}

.st-plan-nuance {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.06);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.st-plan-nuance-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.st-plan-nuance-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(244, 209, 154, 0.92);
}

.st-plan-src {
  display: inline-block;
  margin-top: 16rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: rgba(232, 227, 217, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.14);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
}

/* 节标题 */
.st-clips-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx;
}

.st-clips-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.st-clips-head-ic {
  width: 28rpx;
  height: 28rpx;
}

.st-clips-head-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-secondary);
}

.st-clips-head-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

/* ═══════════ 切片卡（B Curated Native Clips） ═══════════ */
.st-clip {
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 48rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-clip--on {
  border-color: rgba(46, 143, 111, 0.55);
  box-shadow: 0 0 0 4rpx rgba(46, 143, 111, 0.12);
}

.st-clip-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-clip-top-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.st-clip-pod {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  background: var(--st-seg-bg);
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
  max-width: 260rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-clip-no {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-primary);
}

.st-clip-top-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.st-clip-dive {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: var(--st-green-tint);
}

.st-clip-dive--hover {
  opacity: 0.75;
}

.st-clip-dive-ic {
  width: 22rpx;
  height: 22rpx;
}

.st-clip-dive-text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.st-clip-mark {
  padding: 8rpx;
}

.st-clip-mark-ic {
  width: 32rpx;
  height: 32rpx;
}

/* 英文原句 · 词级扫光 */
.st-clip-en {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.75;
}

.st-word {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 4rpx;
  border-radius: 8rpx;
  color: var(--text-primary);
}

.st-word--cur {
  background: var(--accent-300);
  color: var(--ink-950);
  font-weight: 700;
  transform: scale(1.05);
}

.st-word--past {
  color: var(--color-primary);
}

.st-clip-zh {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-tertiary);
}

/* 发音机密 */
.st-clip-secret {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
}

.st-clip-secret-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.st-clip-secret-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* 核心词汇 chips（标签图标 + 单词） */
.st-kv-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.st-kv {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx; /* 上下内边距收紧（原 8rpx → 4rpx） */
  border-radius: 12rpx;
  background: var(--st-amber-tint);
  border: 1rpx solid var(--st-amber-tint-border);
}

.st-kv-ic {
  width: 22rpx;
  height: 22rpx;
  flex-shrink: 0;
}

.st-kv--hover {
  opacity: 0.75;
}

.st-kv-text {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--accent-500);
}

/* 底栏动作 */
.st-clip-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.st-play-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: var(--st-green-tint);
}

.st-play-btn--on {
  background: var(--primary-600);
  box-shadow: var(--e1);
}

.st-play-btn--hover {
  opacity: 0.85;
}

.st-play-ic {
  width: 26rpx;
  height: 26rpx;
}

.st-play-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
}

.st-play-btn--on .st-play-text {
  color: #ffffff;
}

.st-play-spin {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(46, 143, 111, 0.25);
  border-top-color: var(--primary-600);
  animation: st-spin 0.9s linear infinite;
}

.st-loop-btn {
  padding: 10rpx;
  border-radius: 16rpx;
}

.st-loop-btn--on {
  background: var(--st-amber-tint);
}

.st-loop-ic {
  width: 30rpx;
  height: 30rpx;
}

/* ═══════════ 微场景（连续语境 · 句×词两级卡拉OK） ═══════════ */
.st-scene {
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 48rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-scene-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.st-scene-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-scene-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  background: var(--primary-600);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
  flex-shrink: 0;
}

.st-scene-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1.5;
}

.st-scene-summary {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.st-scene-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.st-scene-meta-item {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  background: var(--st-seg-bg);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.st-sent {
  padding: 20rpx;
  border-radius: 24rpx;
  background: var(--page-bg);
  border: 1rpx solid transparent;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.st-sent--on {
  border-color: rgba(46, 143, 111, 0.45);
  background: var(--st-green-tint);
}

.st-sent-en {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.75;
}

.st-sent-zh {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-tertiary);
}

/* 句级行动组（循环/透视/收藏，内构对齐切片卡 top-right 簇） */
.st-sent-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.st-sent-row .st-sent-en {
  flex: 1;
  min-width: 0;
}

.st-sent-acts {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
}

.st-sent-act {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--st-glass);
  border: 1rpx solid var(--st-glass-border);
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-sent-act--hover {
  opacity: 0.75;
}

.st-sent-act--on {
  background: var(--st-green-tint);
  border-color: var(--st-green-tint-border);
}

.st-sent-ic {
  width: 26rpx;
  height: 26rpx;
}

.st-sent-spin {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(46, 143, 111, 0.25);
  border-top-color: var(--primary-600);
  animation: st-spin 0.9s linear infinite;
}

/* ═══════════ 实战微演练（B amber 底） ═══════════ */
.st-roleplay {
  padding: 32rpx;
  border-radius: 48rpx;
  background: var(--st-amber-tint);
  border: 1rpx solid var(--st-amber-tint-border);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.st-roleplay-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.st-roleplay-ic {
  font-size: 30rpx;
  line-height: 1;
}

.st-roleplay-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--accent-500);
}

.st-roleplay-text {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.7;
  color: var(--text-primary);
}

/* ═══════════ 深度透视 bottom-sheet（与 discover rl-sheet 同构） ═══════════ */
.st-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  animation: st-fade 0.2s ease-out;
}

@keyframes st-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.st-sheet {
  width: 100%;
  max-height: 82vh;
  box-sizing: border-box;
  padding: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: var(--card-bg);
  border-radius: 48rpx 48rpx 0 0;
  overflow-y: auto;
  animation: st-slide-up 0.25s ease-out;
}

@keyframes st-slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.st-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.st-sheet-title-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.st-sheet-spark {
  width: 36rpx;
  height: 36rpx;
}

.st-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.st-sheet-x {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-sheet-x-glyph {
  font-size: 32rpx;
  color: var(--text-tertiary);
}

.st-quote {
  margin: 32rpx 0;
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
}

.st-quote-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: var(--text-tertiary);
  margin-bottom: 10rpx;
}

.st-quote-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.7;
  color: var(--text-primary);
}

.st-deep-loading {
  padding: 80rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.st-deep-loading-ic {
  width: 64rpx;
  height: 64rpx;
  animation: st-bounce 0.9s ease-in-out infinite;
}

@keyframes st-bounce {
  0%, 100% { transform: translateY(-20%); }
  50% { transform: translateY(15%); }
}

.st-deep-loading-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--text-secondary);
}

.st-deep-fallback-note {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.st-deep-fallback-note text {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-tertiary);
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
}

.st-dcard {
  padding: 28rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
}

.st-dcard-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.st-dcard-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.st-dcard-ic-emoji {
  font-size: 28rpx;
  line-height: 1;
}

.st-dcard-title {
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.5;
}

.st-dcard-title--green { color: var(--color-primary); }
.st-dcard-title--amber { color: var(--accent-500); }
.st-dcard-title--blue { color: var(--st-blue-fg); }
.st-dcard-title--plain { color: var(--text-primary); display: block; margin-bottom: 10rpx; }

.st-dcard--green {
  background: var(--st-green-tint);
  border: 1rpx solid var(--st-green-tint-border);
}

.st-dcard--amber {
  background: var(--st-amber-tint);
  border: 1rpx solid var(--st-amber-tint-border);
}

.st-dcard--blue {
  background: var(--st-blue-tint);
  border: 1rpx solid var(--st-blue-tint-border);
}

.st-dcard--plain {
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
}

.st-dcard-body {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.7;
  color: var(--ink-600);
}

.st-dcard-body--muted {
  color: var(--ink-600);
}

.st-sheet-btn {
  margin-top: 20rpx;
  padding: 22rpx 0;
  border-radius: 24rpx;
  background: #221f18;
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-sheet-btn--hover {
  opacity: 0.85;
}

.st-sheet-btn-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

/* ═══════════ 今日挑战（B daily tab） ═══════════ */

/* 任务横幅（B 深色渐变 Banner） */
.st-db {
  padding: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(150deg, #10312a 0%, #221f18 55%, #151310 100%);
  border: 1rpx solid rgba(46, 143, 111, 0.35);
  box-shadow: var(--e2);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.st-db-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.st-db-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.st-db-flame {
  width: 56rpx;
  height: 56rpx;
  border-radius: 20rpx;
  background: rgba(217, 138, 23, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.st-db-flame-ic {
  font-size: 28rpx;
}

.st-db-date {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(244, 209, 154, 0.95);
}

.st-db-count {
  display: block;
  font-size: 22rpx;
  color: rgba(232, 227, 217, 0.55);
  margin-top: 4rpx;
}

.st-db-refresh {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
}

.st-db-refresh--hover {
  background: rgba(255, 255, 255, 0.2);
}

.st-db-refresh--spin {
  opacity: 0.6;
}

.st-db-refresh-text {
  font-size: 22rpx;
  color: rgba(232, 227, 217, 0.8);
}

.st-db-progress-labels {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.st-db-progress-labels text {
  font-size: 20rpx;
  color: rgba(232, 227, 217, 0.55);
}

.st-db-progress-pct {
  font-weight: 700;
  color: var(--primary-400) !important;
}

.st-db-progress-track {
  height: 16rpx;
  border-radius: 999rpx;
  background: #2a2620;
  overflow: hidden;
}

.st-db-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--primary-500), #4ec9a8);
  transition: width 0.5s ease;
}

.st-db-summary {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.st-db-summary-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.st-db-summary-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(232, 227, 217, 0.85);
}

/* 全通关横幅 */
.st-db-allpass {
  padding: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(90deg, rgba(217, 138, 23, 0.18), rgba(46, 143, 111, 0.18), rgba(78, 201, 168, 0.18));
  border: 1rpx solid rgba(217, 138, 23, 0.4);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  animation: st-fade-in 0.25s ease-out;
}

.st-db-allpass-title {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-db-allpass-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* 装载态 */
.st-db-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 96rpx 0;
}

.st-db-loading-spin {
  border-color: var(--primary-100);
  border-top-color: var(--primary-500);
}

.st-db-loading-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

/* 挑战卡 */
.st-dc {
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 48rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-dc--on {
  border-color: rgba(46, 143, 111, 0.55);
  box-shadow: 0 0 0 4rpx rgba(46, 143, 111, 0.12);
}

.st-dc--done {
  border-color: rgba(46, 143, 111, 0.25);
}

.st-dc-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-dc-top-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.st-dc-order {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--st-seg-bg);
  font-size: 22rpx;
  font-weight: 700;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.st-dc-order--done {
  background: var(--primary-600);
  color: #ffffff;
}

.st-dc-order-check {
  font-size: 26rpx;
}

.st-dc-pod {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--text-secondary);
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-dc-diff {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--text-tertiary);
  background: var(--st-seg-bg);
  border-radius: 12rpx;
  padding: 4rpx 12rpx;
}

.st-dc-top-right {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.st-dc-score {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--color-primary);
  background: var(--st-green-tint);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

/* 目标词汇 chips 绿变体（复用 .st-kv 基类） */
.st-kv--green {
  background: var(--st-green-tint);
  border-color: var(--st-green-tint-border);
}

.st-kv-text--green {
  color: var(--color-primary);
}

/* 动作栏 */
.st-dc-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
}

.st-dc-actions-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-dc-coach {
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  background: var(--st-amber-tint);
}

.st-dc-coach--hover {
  opacity: 0.75;
}

.st-dc-coach--off {
  opacity: 0.4;
}

.st-dc-coach-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--accent-500);
}

.st-dc-shadow {
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, var(--primary-600), #2f9e8a);
  box-shadow: 0 10rpx 24rpx rgba(31, 122, 92, 0.25);
  flex-shrink: 0;
}

.st-dc-shadow--done {
  background: var(--st-seg-bg);
  box-shadow: none;
}

.st-dc-shadow--eval {
  background: var(--st-seg-bg);
  box-shadow: none;
}

.st-dc-shadow--rec {
  background: var(--error-500);
  animation: st-pulse 1.2s ease-in-out infinite;
}

.st-dc-shadow-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.st-dc-shadow--done .st-dc-shadow-text,
.st-dc-shadow--eval .st-dc-shadow-text {
  color: var(--text-secondary);
}

@keyframes st-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

/* 录音横幅 */
.st-dc-rec {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-radius: 32rpx;
  background: rgba(210, 80, 63, 0.1);
  border: 1rpx solid rgba(210, 80, 63, 0.3);
  animation: st-fade-in 0.2s ease-out;
}

.st-dc-rec-left {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-width: 0;
}

.st-dc-rec-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--error-500);
  flex-shrink: 0;
}

.st-dc-rec-text {
  font-size: 22rpx;
  color: var(--error-500);
}

.st-dc-rec-countdown {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--error-500);
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

/* 评测报告卡 */
.st-ev {
  padding: 28rpx;
  border-radius: 32rpx;
  background: var(--page-bg);
  border: 1rpx solid rgba(46, 143, 111, 0.25);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: st-fade-in 0.25s ease-out;
}

.st-ev-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.st-ev-top-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.st-ev-ic {
  width: 30rpx;
  height: 30rpx;
  flex-shrink: 0;
}

.st-ev-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
  white-space: nowrap;
}

.st-ev-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent-500);
  background: var(--st-amber-tint);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-ev-score {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--color-primary);
  flex-shrink: 0;
}

.st-ev-score-unit {
  font-size: 20rpx;
  font-weight: 400;
  color: var(--text-tertiary);
}

.st-ev-grid {
  display: flex;
  gap: 12rpx;
  border-top: 1rpx solid var(--border-color);
  padding-top: 16rpx;
}

.st-ev-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 12rpx 0;
  border-radius: 20rpx;
  background: var(--card-bg);
}

.st-ev-cell-label {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.st-ev-cell-val {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.st-ev-fb {
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
}

.st-ev-fb-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.st-ev-advice {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.st-ev-advice-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--accent-500);
  flex-shrink: 0;
}

.st-ev-advice-text {
  font-size: 20rpx;
  line-height: 1.7;
  color: var(--accent-500);
}

/* ── 发音教练（示波器区，固定深色双外观同 B） ── */
.st-coach {
  border-top: 1rpx solid var(--border-color);
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-coach-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.st-coach-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, var(--error-500), var(--accent-400));
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-coach-logo-ic {
  font-size: 26rpx;
}

.st-coach-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-coach-title {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-coach-sub {
  font-size: 20rpx;
  color: var(--text-tertiary);
  line-height: 1.6;
  margin-top: 6rpx;
}

.st-scope {
  padding: 24rpx;
  border-radius: 32rpx;
  background: #151310;
  border: 1rpx solid #2e2a24;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.st-scope-legend {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
}

.st-scope-legend-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex-wrap: wrap;
}

.st-scope-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.st-scope-legend-item text {
  font-size: 18rpx;
  color: rgba(232, 227, 217, 0.55);
}

.st-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}

.st-dot--ok { background: #4ec9a8; }
.st-dot--err { background: #e05747; }
.st-dot--warn { background: #ecb35e; }

.st-scope-legend-mono {
  font-size: 18rpx;
  color: #4ec9a8;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
  flex-shrink: 0;
}

/* 音节 pin */
.st-scope-pins {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.st-pin {
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
  border: 1rpx solid transparent;
}

.st-pin text {
  font-size: 20rpx;
  font-weight: 800;
  font-family: "SFMono-Regular", Menlo, Consolas, monospace;
}

.st-pin--fixed { background: rgba(26, 51, 41, 0.9); border-color: rgba(46, 143, 111, 0.6); }
.st-pin--fixed text { color: #7dc5a8; }
.st-pin--err { background: rgba(46, 20, 18, 0.9); border-color: rgba(224, 87, 71, 0.5); }
.st-pin--err text { color: #e59a90; }
.st-pin--warn { background: rgba(46, 36, 16, 0.9); border-color: rgba(236, 179, 94, 0.5); }
.st-pin--warn text { color: #ecb35e; }

.st-pin--sel.st-pin--err { background: #e05747; border-color: #e05747; }
.st-pin--sel.st-pin--err text { color: #ffffff; }
.st-pin--sel.st-pin--warn { background: #ecb35e; border-color: #ecb35e; }
.st-pin--sel.st-pin--warn text { color: #221f18; }
.st-pin--sel.st-pin--fixed { background: #2e8f6f; border-color: #2e8f6f; }
.st-pin--sel.st-pin--fixed text { color: #ffffff; }

/* 36 柱双轨波形 */
.st-scope-wave {
  display: flex;
  align-items: stretch;
  gap: 3rpx;
  padding: 16rpx 10rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
}

.st-wcol {
  flex: 1;
  height: 160rpx;
  display: flex;
  flex-direction: column;
  border-radius: 6rpx;
}

.st-wcol--sel {
  background: rgba(255, 255, 255, 0.1);
  box-shadow: 0 0 0 1rpx rgba(236, 179, 94, 0.4);
}

.st-wtrack {
  flex: 1;
  display: flex;
}

.st-wtrack--n {
  align-items: flex-end;
  justify-content: center;
  border-bottom: 1rpx solid #3a342c;
  padding-bottom: 2rpx;
}

.st-wtrack--u {
  align-items: flex-start;
  justify-content: center;
  padding-top: 2rpx;
}

.st-wbar {
  width: 100%;
  border-radius: 4rpx 4rpx 0 0;
}

.st-wtrack--u .st-wbar {
  border-radius: 0 0 4rpx 4rpx;
}

