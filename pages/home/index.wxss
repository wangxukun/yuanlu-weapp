.st-prompt-join {
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, var(--error-500), var(--accent-400));
  box-shadow: 0 10rpx 24rpx rgba(210, 80, 63, 0.3);
  flex-shrink: 0;
}

.st-prompt-join--hover {
  opacity: 0.85;
}

.st-prompt-join--busy {
  background: var(--error-500);
  box-shadow: none;
  animation: st-pulse 1.2s ease-in-out infinite;
}

.st-prompt-join-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
}

/* 趣味合集卡（B 深色渐变 Compilation） */
.st-comp {
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #10312a 0%, #221f18 55%, #0d3328 100%);
  border: 1rpx solid rgba(46, 143, 111, 0.35);
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.st-comp-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.st-comp-head-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  flex: 1;
  min-width: 0;
}

.st-comp-vibe {
  font-size: 20rpx;
  font-weight: 800;
  color: rgba(244, 209, 154, 0.95);
  background: rgba(236, 179, 94, 0.2);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.st-comp-title {
  font-size: 24rpx;
  font-weight: 800;
  color: #ffffff;
}

.st-comp-chem {
  font-size: 24rpx;
  font-weight: 800;
  color: #4ec9a8;
  flex-shrink: 0;
}

.st-comp-comment {
  padding: 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.st-comp-comment-text {
  font-size: 22rpx;
  line-height: 1.7;
  color: rgba(232, 227, 217, 0.85);
}

.st-comp-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-comp-foot-note {
  font-size: 20rpx;
  color: rgba(232, 227, 217, 0.55);
  flex: 1;
}

.st-comp-play {
  padding: 14rpx 26rpx;
  border-radius: 24rpx;
  background: var(--primary-500);
  box-shadow: 0 10rpx 24rpx rgba(46, 143, 111, 0.3);
  flex-shrink: 0;
}

.st-comp-play--hover {
  opacity: 0.85;
}

.st-comp-play--on {
  background: var(--accent-300);
}

.st-comp-play-text {
  font-size: 24rpx;
  font-weight: 800;
  color: #221f18;
}

/* ═══════════ 今日挑战 · 四按钮竖排网格（图标行+文本行，图标水平居中） ═══════════ */

.st-a4 {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
}

.st-a4--hover {
  opacity: 0.8;
}

.st-a4--off {
  opacity: 0.4;
}

.st-a4-ic {
  width: 34rpx;
  height: 34rpx;
}

.st-a4-emoji {
  font-size: 32rpx;
  line-height: 1;
}

.st-a4-t {
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.st-a4-t--white {
  color: #ffffff;
}

.st-a4-t--muted {
  color: var(--text-secondary);
}

/* 听原声：绿淡底品牌绿字 / 播放中（暂停）实心绿白字 */
.st-a4--listen {
  background: var(--st-green-tint);
}

.st-a4--listen .st-a4-t {
  color: var(--color-primary);
}

/* 播放态白字：与上一条同特异性、位置靠后胜出（.st-a4-t--white 单类压不过双类） */
.st-a4--listen .st-a4-t--white {
  color: #ffffff;
}

.st-a4--listen-on {
  background: var(--primary-600);
  box-shadow: var(--e1);
}

/* 发起接力：rose 淡底 */
.st-a4--relay {
  background: rgba(210, 80, 63, 0.12);
}

.st-a4-t--relay {
  color: var(--error-500);
}

/* 横排按钮：图标在文本左侧（竖排基类的行内变体，文案不换行） */
.st-a4--row {
  flex-direction: row;
  padding: 24rpx 8rpx;
}

.st-a4--row .st-a4-t {
  white-space: nowrap;
}

/* 跟读挑战：渐变绿（默认/录音红脉冲/评分中与重录灰） */
.st-a4--shadow {
  flex: 1.15; /* 动态文案最长（"跟读录音中 (Ns)..."），略加宽 */
  background: linear-gradient(120deg, var(--primary-600), #2f9e8a);
  box-shadow: 0 10rpx 24rpx rgba(31, 122, 92, 0.25);
}

.st-a4--shadow-rec {
  background: var(--error-500);
  box-shadow: none;
  animation: st-pulse 1.2s ease-in-out infinite;
}

.st-a4--shadow-eval,
.st-a4--shadow-done {
  background: var(--st-seg-bg);
  box-shadow: none;
}

/* 单句循环窄格（活动卡附属，仅图标垂直居中） */
.st-a4-loop {
  flex: none;
  width: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: var(--st-seg-bg);
}

.st-a4-loop--on {
  background: var(--st-amber-tint);
}

.st-a4-loop-ic {
  width: 32rpx;
  height: 32rpx;
}

/* ═══════════ 无相关语料提示（noMatch 诚实提示卡） ═══════════ */
.st-nomatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 64rpx 48rpx;
  border-radius: 48rpx;
  background: var(--card-bg);
  border: 1rpx dashed var(--border-color);
  text-align: center;
  animation: st-fade-in 0.2s ease-out;
}

.st-nomatch-ic {
  font-size: 56rpx;
  line-height: 1;
}

.st-nomatch-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-nomatch-desc {
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

/* ═══════════ 排行榜（B leaderboard tab；hero 深色渐变两种外观同色， ═══════════
   站位卡双轨渐变，列表卡走 --card-bg/--border-color 令牌） */
.st-lb-hero {
  padding: 32rpx;
  border-radius: 48rpx;
  background: linear-gradient(150deg, #221f18 0%, #062e26 50%, #1a1408 100%);
  border: 1rpx solid rgba(217, 138, 23, 0.3);
  box-shadow: var(--e2);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.st-lb-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.st-lb-hero-left {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
  flex: 1;
}

.st-lb-trophy {
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: rgba(217, 138, 23, 0.2);
  border: 1rpx solid rgba(217, 138, 23, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-lb-trophy-ic {
  width: 36rpx;
  height: 36rpx;
}

.st-lb-hero-titles {
  flex: 1;
  min-width: 0;
}

.st-lb-hero-titlerow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.st-lb-hero-title {
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
}

.st-lb-live {
  font-size: 20rpx;
  font-weight: 700;
  color: #6ee7b7;
  background: rgba(16, 185, 129, 0.2);
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.st-lb-hero-sub {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 8rpx;
}

.st-lb-hero-sub-ic {
  font-size: 20rpx;
}

.st-lb-hero-sub-text {
  font-size: 22rpx;
  color: rgba(232, 227, 217, 0.75);
}

.st-lb-refresh {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.st-lb-refresh--hover {
  background: rgba(255, 255, 255, 0.2);
}

.st-lb-refresh-ic {
  width: 28rpx;
  height: 28rpx;
}

.st-lb-refresh--spin .st-lb-refresh-ic {
  animation: st-spin 0.8s linear infinite;
}

/* 三甲领奖台（2-1-3 网格，1 居中上浮） */
.st-lb-podium {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
  padding-top: 24rpx;
}

.st-lb-pod {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 12rpx 16rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.st-lb-pod--1 {
  background: linear-gradient(180deg, rgba(217, 138, 23, 0.25) 0%, rgba(255, 255, 255, 0.05) 100%);
  border-color: rgba(251, 191, 36, 0.5);
  margin-top: -16rpx;
  padding-top: 12rpx;
  box-shadow: var(--e2);
}

.st-lb-crown {
  font-size: 32rpx;
  line-height: 1;
  animation: st-bounce 1.6s ease-in-out infinite;
}

.st-lb-pod-ava-wrap {
  position: relative;
}

.st-lb-pod-ava {
  border-radius: 50%;
  display: block;
}

.st-lb-pod-ava--1 {
  width: 112rpx;
  height: 112rpx;
  border: 4rpx solid #fbbf24;
}

.st-lb-pod-ava--2 {
  width: 88rpx;
  height: 88rpx;
  border: 4rpx solid #d6d3d1;
}

.st-lb-pod-ava--3 {
  width: 88rpx;
  height: 88rpx;
  border: 4rpx solid #b45309;
}

.st-lb-pod-no {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -12rpx;
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
  display: flex;
  align-items: center;
}

.st-lb-pod-no text {
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.6;
}

.st-lb-pod-no--1 {
  background: #fbbf24;
}

.st-lb-pod-no--1 text {
  color: #1c1917;
}

.st-lb-pod-no--2 {
  background: #e7e5e4;
}

.st-lb-pod-no--2 text {
  color: #1c1917;
}

.st-lb-pod-no--3 {
  background: #b45309;
}

.st-lb-pod-no--3 text {
  color: #ffffff;
}

.st-lb-pod-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  margin-top: 10rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.st-lb-pod-name--1 {
  color: #fde68a;
}

.st-lb-pod-count {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.st-lb-pod-count-n {
  font-size: 24rpx;
  font-weight: 800;
  color: #34d399;
}

.st-lb-pod-count-n--1 {
  color: #fbbf24;
  font-size: 28rpx;
}

.st-lb-pod-count-u {
  font-size: 20rpx;
  color: rgba(232, 227, 217, 0.75);
}

.st-lb-pod-count-u--1 {
  color: rgba(254, 240, 217, 0.85);
}

.st-lb-pod-avg {
  font-size: 20rpx;
  color: rgba(232, 227, 217, 0.55);
}

.st-lb-pod-avg--1 {
  color: rgba(254, 240, 217, 0.8);
}

/* 我的站位卡（B emerald→teal→amber 渐变，双轨） */
.st-lb-me {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 40rpx;
  background: linear-gradient(100deg, #ecfdf5 0%, rgba(204, 251, 241, 0.65) 55%, rgba(254, 243, 199, 0.6) 100%);
  border: 1rpx solid rgba(52, 211, 153, 0.5);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  animation: st-fade-in 0.2s ease-out;
}

@media (prefers-color-scheme: dark) {
  .st-lb-me {
    background: linear-gradient(100deg, rgba(6, 46, 38, 0.6) 0%, rgba(28, 25, 23, 0.9) 55%, #1c1917 100%);
    border-color: rgba(16, 185, 129, 0.45);
  }
}

.st-page.theme-dark .st-lb-me {
  background: linear-gradient(100deg, rgba(6, 46, 38, 0.6) 0%, rgba(28, 25, 23, 0.9) 55%, #1c1917 100%);
  border-color: rgba(16, 185, 129, 0.45);
}

.st-page.theme-light .st-lb-me {
  background: linear-gradient(100deg, #ecfdf5 0%, rgba(204, 251, 241, 0.65) 55%, rgba(254, 243, 199, 0.6) 100%);
  border-color: rgba(52, 211, 153, 0.5);
}

.st-lb-me-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.st-lb-me-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
  flex: 1;
}

.st-lb-me-ava-wrap {
  position: relative;
  flex-shrink: 0;
}

.st-lb-me-ava {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 4rpx solid #10b981;
  display: block;
}

.st-lb-me-rank {
  position: absolute;
  right: -10rpx;
  bottom: -8rpx;
  background: #059669;
  border-radius: 999rpx;
  padding: 2rpx 12rpx;
}

.st-lb-me-rank text {
  font-size: 18rpx;
  font-weight: 800;
  color: #ffffff;
}

.st-lb-me-info {
  min-width: 0;
  flex: 1;
}

.st-lb-me-namerow {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.st-lb-me-name {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-primary);
}

.st-lb-me-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: #b45309;
  background: rgba(254, 243, 199, 0.9);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

.st-lb-me-sub {
  display: block;
  font-size: 22rpx;
  color: var(--text-secondary);
