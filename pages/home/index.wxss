/* ── 连胜横幅（amber 渐变 + shimmer 扫光 + 点火脉冲） ── */
.st-sp {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  padding: 24rpx;
  background: linear-gradient(100deg, rgba(217, 138, 23, 0.15) 0%, rgba(234, 88, 12, 0.1) 50%, rgba(46, 143, 111, 0.15) 100%);
  border: 1rpx solid rgba(217, 138, 23, 0.45);
}

@media (prefers-color-scheme: dark) {
  .st-sp {
    background: linear-gradient(100deg, rgba(120, 53, 15, 0.6) 0%, rgba(69, 26, 3, 0.4) 50%, rgba(6, 46, 38, 0.5) 100%);
    border-color: rgba(180, 83, 9, 0.5);
  }
}

.st-page.theme-dark .st-sp {
  background: linear-gradient(100deg, rgba(120, 53, 15, 0.6) 0%, rgba(69, 26, 3, 0.4) 50%, rgba(6, 46, 38, 0.5) 100%);
  border-color: rgba(180, 83, 9, 0.5);
}

.st-page.theme-light .st-sp {
  background: linear-gradient(100deg, rgba(217, 138, 23, 0.15) 0%, rgba(234, 88, 12, 0.1) 50%, rgba(46, 143, 111, 0.15) 100%);
  border-color: rgba(217, 138, 23, 0.45);
}

.st-sp--pop {
  animation: st-sp-pop 0.75s ease-out;
}

@keyframes st-sp-pop {
  0% { transform: scale(1); }
  40% { transform: scale(1.025); }
  100% { transform: scale(1); }
}

.st-sp-shimmer {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 33%;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
  animation: st-sp-shimmer 2.8s ease-in-out infinite;
  pointer-events: none;
}

@media (prefers-color-scheme: dark) {
  .st-sp-shimmer {
    background: linear-gradient(90deg, transparent, rgba(252, 211, 77, 0.14), transparent);
  }
}

.st-page.theme-dark .st-sp-shimmer {
  background: linear-gradient(90deg, transparent, rgba(252, 211, 77, 0.14), transparent);
}

@keyframes st-sp-shimmer {
  0% { transform: translateX(-120%); }
  60%, 100% { transform: translateX(420%); }
}

.st-sp-body {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.st-sp-top {
