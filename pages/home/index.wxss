/* 代表作行（B Featured Shadowed Sentence + 双动作） */
.st-lb-feat {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: var(--page-bg);
  border: 1rpx solid var(--border-color);
