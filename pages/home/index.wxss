}

.st-lb-me-sub-hl {
  font-weight: 700;
  color: #059669;
}

.st-lb-me-go {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 24rpx;
  border-radius: 24rpx;
  background: #059669;
  flex-shrink: 0;
}

.st-lb-me-go--hover {
  background: #10b981;
}

.st-lb-me-go-ic {
  width: 24rpx;
  height: 24rpx;
}

.st-lb-me-go-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #ffffff;
}

.st-lb-me-next {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: var(--st-glass);
  border: 1rpx solid var(--st-glass-border);
}

.st-lb-me-next-ic {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.st-lb-me-next-text {
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.6;
}

.st-lb-me-next-name {
  font-weight: 800;
  color: var(--text-primary);
}

.st-lb-me-next-n {
  font-weight: 800;
  color: #059669;
}

/* 登顶行（B 恭喜登顶，amber 高亮） */
.st-lb-me-top1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(217, 138, 23, 0.15);
}

.st-lb-me-top1-ic {
  font-size: 26rpx;
  line-height: 1;
}

.st-lb-me-top1-text {
  font-size: 22rpx;
  font-weight: 800;
  color: #b45309;
}

/* 达人榜列表 */
.st-lb-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-lb-list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 0 8rpx;
}

.st-lb-list-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.st-lb-list-title-ic {
  width: 28rpx;
  height: 28rpx;
}

.st-lb-list-title-text {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--text-secondary);
}

.st-lb-list-hint {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.st-lb-card {
  padding: 28rpx;
  border-radius: 40rpx;
  background: var(--card-bg);
  border: 1rpx solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.st-lb-card--me {
  border-color: rgba(16, 185, 129, 0.6);
