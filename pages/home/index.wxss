/* pages/home — 远路语境词典 · 查词工具首页（工具化转型阶段一）
   巨型搜索框 + 灰底灵感胶囊 + 4 工具入口 + 检索结果；根类自声明 color（三段式双轨见组件内） */

.home-container {
  min-height: 100vh;
  padding: 32rpx 32rpx 0;
  box-sizing: border-box;
  color: var(--ink-900);
  background-color: var(--bg-page, var(--page-bg));
}

/* ── 顶部轻问候 ── */
.tool-header {
  padding: 24rpx 0 8rpx;
}
.streak-pill {
  padding: 10rpx 24rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
}
.streak-pill-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.login-btn {
  padding: 12rpx 36rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--primary-600);
}
.login-btn-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #ffffff;
}

/* ── 巨型查词/场景搜索框（工具核心，占屏约 1/3 视觉锚点） ── */
.hero-search {
  margin-top: 40rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background-color: var(--card-bg);
  border: 2rpx solid var(--primary-600);
  box-shadow: 0 8rpx 32rpx rgba(47, 100, 84, 0.12);
}
.hero-search-ic {
  width: 44rpx;
  height: 44rpx;
  margin-right: 20rpx;
}
.hero-search-input {
  height: 72rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--ink-900);
}
.hero-search-ph {
  color: var(--ink-300);
  font-size: 30rpx;
  font-weight: 400;
}
.hero-search-clear {
  width: 56rpx;
  height: 56rpx;
  margin-left: 12rpx;
}
.hero-search-clear-ic {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}
.hero-search-go {
  margin-left: 20rpx;
  padding: 18rpx 36rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--primary-600);
}
.hero-search-go-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
}

/* ── 灵感胶囊（灰底文本胶囊 + 刷新） ── */
.sug-row {
  margin-top: 32rpx;
  gap: 16rpx;
}
.sug-chips {
  gap: 16rpx;
  flex-wrap: wrap;
}
.sug-chip {
  padding: 14rpx 28rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--fill-secondary, rgba(0, 0, 0, 0.05));
  color: var(--text-secondary);
  font-size: 25rpx;
}
.sug-refresh {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  border-radius: 50%;
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
}
.sug-refresh-ic {
  width: 36rpx;
  height: 36rpx;
}

/* ── 4 个纯工具入口 ── */
.tool-grid {
  margin-top: 48rpx;
  padding: 36rpx 24rpx;
  border-radius: 28rpx;
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
}
.tool-item {
  flex: 1;
}
.tool-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background-color: var(--primary-100, rgba(47, 100, 84, 0.1));
}
.tool-icon {
  width: 48rpx;
  height: 48rpx;
}
.tool-label {
  color: var(--text-secondary);
}

/* ── 场景检索结果 ── */
.result-card {
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.result-tag {
  padding: 6rpx 18rpx;
  border-radius: var(--r-full, 999rpx);
  background-color: var(--primary-100, rgba(47, 100, 84, 0.1));
  color: var(--primary-600);
  font-size: 22rpx;
}
.result-en {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink-900);
  line-height: 1.5;
}
.result-zh {
  font-size: 26rpx;
  color: var(--text-secondary);
}
.result-go {
  align-self: flex-end;
  gap: 8rpx;
}
.result-go-ic {
  width: 28rpx;
  height: 28rpx;
}
.result-go-text {
  font-size: 24rpx;
  color: var(--primary-600);
  font-weight: 500;
}

.empty-tip {
  padding: 96rpx 0;
}

/* ── 查词记录抽屉 ── */
.history-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 90;
}
.history-panel {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 60vh;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background-color: var(--card-bg);
}
.history-close-ic {
  width: 36rpx;
  height: 36rpx;
}
.history-scroll {
  max-height: 46vh;
}
.history-word {
  padding: 26rpx 8rpx;
  border-bottom: 1rpx solid var(--border-color);
}
.history-word-text {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--ink-900);
}
