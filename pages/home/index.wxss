}

.st-lb-card-badge {
  font-weight: 600;
  color: var(--accent-500);
}

.st-lb-card-dot {
  color: var(--text-tertiary);
}

.st-lb-card-stats {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
  flex-shrink: 0;
}

.st-lb-card-count {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.st-lb-card-count-n {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--color-primary);
}

.st-lb-card-count-u {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--text-tertiary);
}

.st-lb-card-avg {
  font-size: 20rpx;
  color: var(--text-tertiary);
}

.st-lb-card-avg-n {
  font-weight: 700;
  color: var(--text-secondary);
