/* 我的收藏（T5.2 重建）：令牌走根类三段式 */
.fav-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  padding: var(--page-padding);
  box-sizing: border-box;
}

.tab-row {
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.tab-chip {
  flex: 1;
  height: 72rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--border-color);
  font-size: 26rpx;
  color: var(--text-secondary);
}
.tab-chip--on {
  background-color: var(--primary-600);
  border-color: var(--primary-600);
  color: #ffffff;
}

.state-box {
  padding: 120rpx 40rpx;
}
.go-btn {
  margin-top: 32rpx;
  min-width: 260rpx;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background-color: var(--primary-600);
  color: #ffffff;
  font-size: 26rpx;
}

/* 微剧场收藏卡 */
.scene-card {
  padding: 24rpx;
  border-radius: var(--r-lg);
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
  margin-bottom: 20rpx;
  align-items: flex-start;
}
.scene-cover {
  width: 128rpx;
  height: 128rpx;
  border-radius: var(--r-md);
  flex-shrink: 0;
}
.scene-body {
  min-width: 0;
  margin: 0 20rpx;
}
.scene-en {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
}
.scene-zh {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}
.scene-tag {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: var(--text-tertiary);
}
.scene-side {
  flex-shrink: 0;
  gap: 16rpx;
}
.scene-remove {
  width: 48rpx;
  height: 48rpx;
}
.scene-remove-ic {
  width: 32rpx;
  height: 32rpx;
}

/* 特训卡册行 */
.book-card {
  padding: 26rpx;
  border-radius: var(--r-lg);
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
  margin-bottom: 20rpx;
}
.book-badge {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--r-md);
  background-color: var(--primary-50);
  color: var(--primary-600);
  font-size: 28rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.book-name {
  margin: 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
}
.book-meta {
  margin: 6rpx 20rpx 0;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.book-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}
