<!-- pages/library/favorites/index.wxml — 我的收藏（RESHAPE-TASK T5.2 重建）
  双 Tab：收藏的微剧场（本地收藏夹，探索画廊一键收藏）/ 我的特训卡册（心愿工坊产物）。
  顶部返回 + 标题由原生导航栏提供。 -->

<view class="fav-page {{themeClass}}">

  <!-- ===== Tab 切换卡 ===== -->
  <view class="tab-row row">
    <view class="tab-chip {{activeTab === 'scenes' ? 'tab-chip--on' : ''}} center tap-scale"
          data-tab="scenes" bindtap="onTabTap">微剧场 ({{scenes.length}})</view>
    <view class="tab-chip {{activeTab === 'books' ? 'tab-chip--on' : ''}} center tap-scale"
          data-tab="books" bindtap="onTabTap">特训卡册 ({{books.length}})</view>
  </view>

  <!-- ===== 收藏的微剧场（本地） ===== -->
  <block wx:if="{{activeTab === 'scenes'}}">
    <view wx:if="{{scenes.length === 0}}" class="state-box col center">
      <text class="t-body text-secondary">还没有收藏微剧场</text>
      <text class="t-caption text-tertiary mt-2">去探索画廊，点亮明信片上的心，把喜欢的 30 秒收进这里</text>
      <view class="go-btn center tap-scale" bindtap="onGoDiscover">去探索画廊</view>
    </view>
    <block wx:else>
      <view wx:for="{{scenes}}" wx:key="sceneid" class="scene-card row tap-scale"
            data-scene="{{item.sceneid}}" bindtap="onSceneTap">
        <image class="scene-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="col flex-1 scene-body">
          <text class="scene-en ellipsis-2">{{item.en}}</text>
          <text class="scene-zh ellipsis" wx:if="{{item.zh}}">{{item.zh}}</text>
          <text class="scene-tag" wx:if="{{item.tagLabel}}">{{item.tagLabel}}</text>
        </view>
        <view class="col center scene-side">
          <sentence-micro-player episodeid="" clip-id="{{item.sceneid}}"
                                 sentence-id="{{item.sceneid}}"
                                 start-time="{{item.start}}" end-time="{{item.end}}" />
          <view class="scene-remove center tap-scale" catchtap="onSceneRemove" data-scene="{{item.sceneid}}">
            <image class="scene-remove-ic" src="/assets/icons/delete-error.svg" />
          </view>
        </view>
      </view>
    </block>
  </block>

  <!-- ===== 我的特训卡册（登录） ===== -->
  <block wx:else>
    <view wx:if="{{needLogin}}" class="state-box col center">
      <text class="t-body text-secondary">登录后查看你的特训卡册</text>
      <view class="go-btn center tap-scale" bindtap="onGoLogin">去登录</view>
    </view>
    <view wx:elif="{{isLoadingBooks}}" class="state-box col center">
      <view class="loading-spinner"></view>
    </view>
    <view wx:elif="{{books.length === 0}}" class="state-box col center">
      <text class="t-body text-secondary">还没有卡册</text>
      <text class="t-caption text-tertiary mt-2">去心愿工坊许个愿，或从主页的心愿定制签开始</text>
    </view>
    <block wx:else>
      <view wx:for="{{books}}" wx:key="pathid" class="book-card row tap-scale"
            data-id="{{item.pathid}}" bindtap="onBookTap">
        <view class="book-badge center">册</view>
        <view class="col flex-1">
          <text class="book-name ellipsis">{{item.pathName}}</text>
          <text class="book-meta">{{item.itemCount}} 张原声卡{{item.isPublic ? ' · 公开' : ''}}</text>
        </view>
        <image class="book-arrow" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </view>
    </block>
  </block>
</view>
