/* 精研足迹（T5.2 重建）：令牌走根类三段式 */
.fp-page {
  min-height: 100vh;
  background-color: var(--page-bg);
  padding: var(--page-padding);
  box-sizing: border-box;
}

.fp-head {
  margin-bottom: 24rpx;
}
.fp-total {
  font-size: 24rpx;
  color: var(--text-secondary);
}
.fp-clear {
  font-size: 24rpx;
  color: #e0403f;
  padding: 8rpx 16rpx;
}

.fp-empty {
  padding: 140rpx 40rpx;
}
.fp-go {
  margin-top: 32rpx;
  min-width: 260rpx;
  height: 72rpx;
  padding: 0 40rpx;
  border-radius: var(--r-full);
  background-color: var(--primary-600);
  color: #ffffff;
  font-size: 26rpx;
}

.fp-sec-title {
  margin: 24rpx 0 16rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--text-primary);
}

.fp-card {
  padding: 22rpx;
  border-radius: var(--r-lg);
  background-color: var(--card-bg);
  border: 1rpx solid var(--border-color);
  margin-bottom: 18rpx;
}
.fp-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: var(--r-md);
  flex-shrink: 0;
}
.fp-body {
  min-width: 0;
  margin: 0 20rpx;
}
.fp-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  line-height: 1.45;
}
.fp-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
.fp-re {
  flex-shrink: 0;
  min-width: 96rpx;
  height: 56rpx;
  border-radius: var(--r-full);
  border: 1rpx solid var(--border-color);
  font-size: 22rpx;
  color: var(--text-primary);
}
