<!-- pages/library/history/index.wxml — 精研足迹（RESHAPE-TASK T5.2 重建）
  微剧场精研室进入即记录（本地）：今天 / 更早 分组；重研直达精研室。 -->

<view class="fp-page {{themeClass}}">

  <!-- 头行：总数 + 清空 -->
  <view class="row between fp-head" wx:if="{{total > 0}}">
    <text class="fp-total">共 {{total}} 条精研足迹</text>
    <view class="fp-clear tap-scale" bindtap="onClearAll">清空</view>
  </view>

  <!-- 空态 -->
  <view wx:if="{{total === 0}}" class="fp-empty col center">
    <text class="t-body text-secondary">还没有精研足迹</text>
    <text class="t-caption text-tertiary mt-2">每进入一段微剧场精研室，都会在这里留下脚印</text>
    <view class="fp-go center tap-scale" bindtap="onGoDiscover">去探索画廊</view>
  </view>

  <block wx:else>
    <!-- 今天 -->
    <block wx:if="{{today.length > 0}}">
      <view class="fp-sec-title">今天</view>
      <view wx:for="{{today}}" wx:key="sceneid" class="fp-card row tap-scale"
            data-scene="{{item.sceneid}}" bindtap="onSceneTap">
        <image class="fp-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="col flex-1 fp-body">
          <text class="fp-title ellipsis-2">{{item.title}}</text>
          <text class="fp-meta">{{item.situationTag ? item.situationTag + ' · ' : ''}}{{item.durText}} · {{item.timeText}}</text>
        </view>
        <view class="fp-re center">重研</view>
      </view>
    </block>

    <!-- 更早 -->
    <block wx:if="{{earlier.length > 0}}">
      <view class="fp-sec-title">更早</view>
      <view wx:for="{{earlier}}" wx:key="sceneid" class="fp-card row tap-scale"
            data-scene="{{item.sceneid}}" bindtap="onSceneTap">
        <image class="fp-cover" src="{{item.coverUrl}}" mode="aspectFill" />
        <view class="col flex-1 fp-body">
          <text class="fp-title ellipsis-2">{{item.title}}</text>
          <text class="fp-meta">{{item.situationTag ? item.situationTag + ' · ' : ''}}{{item.durText}} · {{item.dateText}}</text>
        </view>
        <view class="fp-re center">重研</view>
      </view>
    </block>
  </block>
</view>
