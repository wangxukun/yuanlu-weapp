<view class="auth-container pb-page-bottom">
  <view class="header">
    <text class="title t-h1">欢迎来到远路播客</text>
    <text class="subtitle t-body text-secondary">登录以享受完整的播客体验</text>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view class="tab {{activeTab === 'phone' ? 'active' : ''}}" bindtap="switchTab" data-tab="phone">手机号登录</view>
    <view class="tab {{activeTab === 'email' ? 'active' : ''}}" bindtap="switchTab" data-tab="email">邮箱登录</view>
  </view>

  <view class="form-container">
    <!-- 手机号登录表单 -->
    <block wx:if="{{activeTab === 'phone'}}">
      <view class="input-group">
        <input class="input-field" type="number" placeholder="请输入11位手机号码" maxlength="11" model:value="{{phone}}" bindinput="onInput" />
      </view>
      <view class="input-group row">
        <input class="input-field flex-1" type="number" placeholder="输入6位验证码" maxlength="6" model:value="{{code}}" bindinput="onInput" />
        <button class="btn-code" disabled="{{countdown > 0 || phone.length !== 11}}" bindtap="sendSmsCode">
          {{countdown > 0 ? countdown + 's' : '获取验证码'}}
        </button>
      </view>
    </block>

    <!-- 邮箱登录表单 -->
    <block wx:if="{{activeTab === 'email'}}">
      <view class="input-group">
        <input class="input-field" type="text" placeholder="请输入邮箱地址" model:value="{{email}}" bindinput="onInput" />
      </view>
      <view class="input-group">
        <input class="input-field" type="password" placeholder="请输入密码" model:value="{{password}}" bindinput="onInput" />
      </view>
    </block>

    <view class="agreement row">
      <checkbox-group bindchange="onAgreeChange">
        <label class="row">
          <checkbox value="agreed" checked="{{agreed}}" color="#1f7a5c" class="cbx" />
          <text class="t-mini text-tertiary">我已阅读并同意</text>
          <text class="t-mini text-primary link">用户协议</text>
          <text class="t-mini text-tertiary">和</text>
          <text class="t-mini text-primary link">隐私政策</text>
        </label>
      </checkbox-group>
    </view>

    <button class="btn-primary submit-btn {{!agreed || isLoading ? 'disabled' : ''}}" bindtap="onSubmit" disabled="{{!agreed || isLoading}}">
      {{isLoading ? '登录中...' : '登录 / 注册'}}
    </button>
  </view>
</view>
