.auth-container {
  padding: 80rpx 40rpx;
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  margin-bottom: 60rpx;
}

.title {
  display: block;
  margin-bottom: 12rpx;
}

.tabs {
  display: flex;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid var(--border-color);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 30rpx;
  color: var(--text-tertiary);
  font-weight: 500;
  position: relative;
  transition: color 0.2s;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 40rpx;
  height: 6rpx;
  background-color: var(--color-primary);
  border-radius: 4rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.input-field {
  width: 100%;
  height: 96rpx;
  background-color: #ffffff;
  border-radius: var(--r-md);
  padding: 0 30rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 2rpx 4rpx rgba(27, 24, 18, 0.02);
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-field:focus {
  border-color: var(--color-primary);
}

.btn-code {
  width: 220rpx;
  height: 96rpx;
  margin-left: 20rpx;
  background-color: var(--color-primary);
  color: #fff;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-md);
  padding: 0;
}

.btn-code[disabled] {
  background-color: var(--ink-200) !important;
  color: var(--text-tertiary) !important;
}

.agreement {
  margin: 40rpx 0;
}

.cbx {
  transform: scale(0.7);
  margin-right: 4rpx;
}

.link {
  margin: 0 8rpx;
}

.submit-btn {
  width: 100% !important;
  border-radius: 999rpx;
}
