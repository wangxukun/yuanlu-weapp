.mine-container {
  padding: var(--page-padding);
  background-color: var(--page-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* Android ProfileScreen 全卡 RoundedCornerShape(24dp) 统一 48rpx */
.card {
  background-color: var(--card-bg);
  border-radius: 48rpx;
  box-shadow: var(--e1);
}

/* ============ 头部身份卡片 ============ */
.profile-card {
  padding: 48rpx 40rpx;
  align-items: center;
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  background-color: var(--ink-200);
  flex-shrink: 0;
  border: 2rpx solid var(--border-color);
}

.avatar {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
}

.avatar-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.3;
}

.profile-info {
  min-width: 0; /* 允许内部文本截断 */
}

/* ============ 角色徽章 ============ */
.role-badge {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.badge-text {
  font-size: 22rpx;
  font-weight: 700;
}

.role-badge.admin {
  background-color: rgba(31, 122, 92, 0.1);
}
.role-badge.admin .badge-text {
  color: var(--color-primary);
}

.role-badge.premium {
  background-color: rgba(217, 138, 23, 0.1);
}
.role-badge.premium .badge-text {
  color: var(--accent-500);
}

.role-badge.normal {
  background-color: var(--page-bg);
}
.role-badge.normal .badge-text {
  color: var(--text-tertiary);
}

/* ============ 学习成果数据看板（1×4） ============ */
.stats-card {
  padding: 36rpx 8rpx 32rpx;
}

.stat {
  min-width: 0;
}

.stat-value-row {
  align-items: flex-end;
  justify-content: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.1;
  color: var(--text-primary);
}

.stat-unit {
  margin-left: 2rpx;
  margin-bottom: 4rpx;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1;
  color: var(--text-primary);
}

.stat-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.2;
  color: var(--text-secondary);
}

/* ============ 分组菜单卡（Android MenuCard/MenuRow 复刻） ============ */
/* MenuCard：Surface(surface, r24dp) → Column padding vertical 8dp */
.menu-card {
  padding: 16rpx 0;
}

/* 区块标题：labelMedium 12sp/Medium + onSurfaceVariant，padding h20dp v6dp */
.menu-title {
  display: block;
  padding: 12rpx 40rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--text-secondary);
}

/* MenuRow：Row padding h20dp v12dp + verticalAlignment.CenterVertically */
.menu-item {
  padding: 24rpx 40rpx;
}

/* 图标容器：34dp Box + tint 12% + RoundedCornerShape(10dp) */
.menu-icon-box {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.menu-icon {
  width: 38rpx;  /* Icon 19dp */
  height: 38rpx;
}

/* 标题：bodyLarge 16sp + onSurface，Spacer 14dp */
.menu-label {
  margin-left: 28rpx;
  font-size: 32rpx;
  color: var(--text-primary);
}

/* 尾值（外观设置当前模式）：bodySmall 12sp + onSurfaceVariant */
.menu-trailing {
  margin-right: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 行尾箭头：KeyboardArrowRight 24dp + onSurfaceVariant 40% */
.menu-chevron {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.4;
  flex-shrink: 0;
}

/* tint 12% 底色角色（浅色轨默认值；primary/tertiary 深色换深款原色） */
.menu-icon-box--primary {
  background: rgba(31, 122, 92, 0.12);
}
.menu-icon-box--accent {
  background: rgba(217, 138, 23, 0.12);
}
.menu-icon-box--accent-deep {
  background: rgba(185, 111, 15, 0.12);
}
.menu-icon-box--tertiary {
  background: rgba(74, 127, 165, 0.12);
}
.menu-icon-box--error {
  background: rgba(210, 80, 63, 0.12);
}

/* ============ 退出登录 ============ */
.logout-card {
  padding: 32rpx;
}

/* ============ 通用小部件 ============ */
.chevron-right-img {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5; /* 对齐原文字箭头的视觉重量 */
}

/* 消息通知未读数角标（对齐 Web HomeNotificationBell：error 底白字圆角胶囊，
   min-w 18px + ring；深浅色同值红底，ring 取当前卡底色） */
.unread-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 8rpx;
  margin-right: 16rpx;
  border-radius: var(--r-full);
  background: var(--color-error);
  border: 4rpx solid var(--card-bg);
  box-sizing: content-box;
  box-shadow: 0 2rpx 8rpx rgba(210, 80, 63, 0.35);
}

.unread-badge-text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

/* ---- 深色三段式（媒体查询轨 + 类轨全量重声明；primary/tertiary 换 Color.kt 深款原色） ---- */
@media (prefers-color-scheme: dark) {
  .menu-icon-box--primary {
    background: rgba(77, 169, 137, 0.12);
  }
  .menu-icon-box--tertiary {
    background: rgba(127, 168, 200, 0.12);
  }
}

.theme-dark .menu-icon-box--primary {
  background: rgba(77, 169, 137, 0.12);
}

.theme-dark .menu-icon-box--tertiary {
  background: rgba(127, 168, 200, 0.12);
}

.theme-light .menu-icon-box--primary {
  background: rgba(31, 122, 92, 0.12);
}

.theme-light .menu-icon-box--tertiary {
  background: rgba(74, 127, 165, 0.12);
}

/* 间距工具 */
.mt-1 { margin-top: 8rpx; }
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mr-3 { margin-right: 24rpx; }
.ml-4 { margin-left: 32rpx; }
.mb-2 { margin-bottom: 16rpx; }
.center-v { align-items: center; }
