<view class="mine-container pb-page-bottom-with-player {{themeClass}}">
  <!-- 头部身份卡片（Android UserCard 同款） -->
  <view class="card profile-card row tap-scale" bindtap="{{isLoggedIn ? 'onProfile' : 'onLogin'}}">
    <view class="avatar-wrap center">
      <image wx:if="{{isLoggedIn && userInfo.avatarUrl}}" class="avatar" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
      <view wx:else class="avatar-placeholder center">
        <!-- 默认头像图标 -->
        <image class="avatar-icon" src="/assets/icons/person.png" mode="aspectFit" />
      </view>
    </view>

    <view class="profile-info col flex-1 ml-4">
      <block wx:if="{{isLoggedIn}}">
        <text class="t-h2 text-bold ellipsis">{{userInfo.nickname || userInfo.email || 'User'}}</text>
        <view class="row mt-1">
          <view wx:if="{{userInfo.role === 'ADMIN'}}" class="role-badge admin">
            <text class="badge-text">管理员</text>
          </view>
          <view wx:elif="{{userInfo.role === 'PREMIUM'}}" class="role-badge premium">
            <text class="badge-text">高级会员</text>
          </view>
          <view wx:else class="role-badge normal">
            <text class="badge-text">普通用户</text>
          </view>
        </view>
        <text class="t-caption text-secondary mt-1 ellipsis" wx:if="{{userInfo.email}}">{{userInfo.email}}</text>
      </block>
      <block wx:else>
        <text class="t-h2 text-bold">未登录</text>
        <text class="t-caption text-secondary mt-1">点击登录或注册，开启学习之旅</text>
      </block>
    </view>
    <image class="chevron-right-img" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
  </view>

  <block wx:if="{{isLoggedIn}}">
    <!-- 学习成果数据看板（1×4：收听分钟/掌握生词/收藏句子/连续打卡） -->
    <view class="card stats-card mt-4 row">
      <view class="stat col center flex-1">
        <view class="row center-v stat-value-row">
          <text class="stat-num">{{stats.listenMinutes}}</text>
          <text class="stat-unit">m</text>
        </view>
        <text class="stat-label">收听分钟</text>
      </view>
      <view class="stat col center flex-1">
        <view class="row center-v stat-value-row">
          <text class="stat-num">{{stats.wordsLearned}}</text>
        </view>
        <text class="stat-label">掌握生词</text>
      </view>
      <view class="stat col center flex-1">
        <view class="row center-v stat-value-row">
          <text class="stat-num">{{stats.savedSentences}}</text>
        </view>
        <text class="stat-label">收藏句子</text>
      </view>
      <view class="stat col center flex-1">
        <view class="row center-v stat-value-row">
          <text class="stat-num">{{stats.streakDays}}</text>
          <text class="stat-unit">天</text>
        </view>
        <text class="stat-label">连续打卡</text>
      </view>
    </view>

    <!-- 学习与记录（Android ProfileScreen MenuCard：仅登录可见） -->
    <view class="card menu-card mt-4">
      <text class="menu-title">学习与记录</text>
      <navigator url="/pages/library/paths/index" class="menu-item row center-v tap-scale">
        <view class="menu-icon-box menu-icon-box--primary center">
          <image class="menu-icon" mode="aspectFit" src="{{dark ? '/assets/icons/school-primary-dark.svg' : '/assets/icons/school-primary.svg'}}" />
        </view>
        <text class="menu-label flex-1">学习路径</text>
        <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </navigator>
      <navigator url="/pages/library/history/index" class="menu-item row center-v tap-scale">
        <view class="menu-icon-box menu-icon-box--accent center">
          <image class="menu-icon" mode="aspectFit" src="/assets/icons/history-accent.svg" />
        </view>
        <text class="menu-label flex-1">收听历史</text>
        <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </navigator>
      <navigator url="/pages/library/favorites/index" class="menu-item row center-v tap-scale">
        <view class="menu-icon-box menu-icon-box--accent-deep center">
          <image class="menu-icon" mode="aspectFit" src="/assets/icons/bookmark-accent-deep.svg" />
        </view>
        <text class="menu-label flex-1">我的收藏</text>
        <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </navigator>
    </view>
  </block>

  <!-- 订阅与系统设置（Android ProfileScreen MenuCard；未登录仅剩外观/帮助两项；项间无分隔线对齐源码） -->
  <view class="card menu-card mt-4">
    <text class="menu-title">订阅与系统设置</text>

    <!-- 我的订阅（模块 E 订阅页真路由，T2.2；仅登录态可见=Android 分组口径） -->
    <view wx:if="{{isLoggedIn}}" class="menu-item row center-v tap-scale" bindtap="onSubscribe">
      <view class="menu-icon-box menu-icon-box--accent center">
        <image class="menu-icon" mode="aspectFit" src="/assets/icons/credit-card-accent.svg" />
      </view>
      <text class="menu-label flex-1">我的订阅</text>
      <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
    </view>

    <!-- 管理员控制台入口（Computer · error，对齐 Web mine 页）；小程序端未建管理后台 -->
    <block wx:if="{{isLoggedIn && userInfo.role === 'ADMIN'}}">
      <view class="menu-item row center-v tap-scale" bindtap="onAdminConsole">
        <view class="menu-icon-box menu-icon-box--error center">
          <image class="menu-icon" mode="aspectFit" src="/assets/icons/computer-error.svg" />
        </view>
        <text class="menu-label flex-1">控制台</text>
        <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </view>
    </block>

    <!-- 外观设置（Contrast · tertiary，右侧尾值 = 当前模式，Android trailing 同款） -->
    <view class="menu-item row center-v tap-scale" bindtap="onAppearance">
      <view class="menu-icon-box menu-icon-box--tertiary center">
        <image class="menu-icon" mode="aspectFit" src="{{dark ? '/assets/icons/contrast-tertiary-dark.svg' : '/assets/icons/contrast-tertiary.svg'}}" />
      </view>
      <text class="menu-label flex-1">外观设置</text>
      <text class="menu-trailing">{{themeLabel}}</text>
      <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
    </view>

    <!-- 消息通知（Notifications · primary，未读数角标随 onShow 静默刷新） -->
    <block wx:if="{{isLoggedIn}}">
      <view class="menu-item row center-v tap-scale" bindtap="onNotifications">
        <view class="menu-icon-box menu-icon-box--primary center">
          <image class="menu-icon" mode="aspectFit" src="{{dark ? '/assets/icons/notifications-primary-dark.svg' : '/assets/icons/notifications-primary.svg'}}" />
        </view>
        <text class="menu-label flex-1">消息通知</text>
        <view wx:if="{{unreadCount > 0}}" class="unread-badge center">
          <text class="unread-badge-text">{{unreadCount > 99 ? '99+' : unreadCount}}</text>
        </view>
        <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
      </view>
    </block>

    <!-- 离线缓存（Download · primary，尾值 = 已用容量；DOWNLOAD-TASK T3.5，缓存为设备本地资产故全登录态可见） -->
    <view class="menu-item row center-v tap-scale" bindtap="onClearCache">
      <view class="menu-icon-box menu-icon-box--primary center">
        <image class="menu-icon" mode="aspectFit" src="{{dark ? '/assets/icons/download-primary-dark.svg' : '/assets/icons/download-primary.svg'}}" />
      </view>
      <text class="menu-label flex-1">离线缓存</text>
      <text class="menu-trailing">{{cacheLabel}}</text>
      <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
    </view>

    <!-- 帮助与支持（HelpOutline · tertiary） -->
    <navigator url="/pages/contact/index" class="menu-item row center-v tap-scale">
      <view class="menu-icon-box menu-icon-box--tertiary center">
        <image class="menu-icon" mode="aspectFit" src="{{dark ? '/assets/icons/help-outline-tertiary-dark.svg' : '/assets/icons/help-outline-tertiary.svg'}}" />
      </view>
      <text class="menu-label flex-1">帮助与支持</text>
      <image class="menu-chevron" mode="aspectFit" src="{{dark ? '/assets/icons/keyboard-arrow-right-tertiary-dark.svg' : '/assets/icons/keyboard-arrow-right-tertiary.svg'}}" />
    </navigator>
  </view>

  <!-- 退出登录 -->
  <block wx:if="{{isLoggedIn}}">
    <view class="card logout-card mt-4 center tap-scale" bindtap="onLogout">
      <text class="t-h3 text-bold text-error">退出登录</text>
    </view>
  </block>

  <!-- 底部留白以防被播放条遮挡 -->
  <view style="height:96rpx;"></view>
</view>

<!-- 跨页迷你播放条（3.B.3）：无播放会话时整条不渲染 -->
<mini-player elevated />
